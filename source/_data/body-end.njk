{# ============================================================
   1) 主页 dashboard 交互:scroll-spy + countUp + year-progress + heatmap tooltip
   ============================================================ #}
<script>
(function () {
  'use strict';
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || !body.classList.contains('is-home')) return;
  if (!('IntersectionObserver' in window)) return;

  // ---- A. scroll-spy · 当前区段 ID 写到 body[data-active] ----
  var sections = ['dashboard', 'posts', 'tags', 'about']
    .map(function (id) { return document.getElementById(id); })
    .filter(Boolean);
  if (sections.length) {
    var spy = new IntersectionObserver(function (entries) {
      // 选最近一个 intersecting 区段
      var visible = entries.filter(function (e) { return e.isIntersecting; });
      if (visible.length) {
        // 取离顶部最近的 intersecting
        visible.sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        body.setAttribute('data-active', visible[0].target.id);
      }
    }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
    sections.forEach(function (s) { spy.observe(s); });
  }

  // ---- B. countUp · 数字滚动入场 ----
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function countUp(el) {
    var target = parseInt(el.getAttribute('data-target') || el.textContent || '0', 10);
    if (!target || target < 1) { el.textContent = target; return; }
    if (reduceMotion) { el.textContent = target.toLocaleString(); return; }
    var dur = 900;
    var start = performance.now();
    function step(now) {
      var p = Math.min(1, (now - start) / dur);
      el.textContent = Math.round(target * easeOutCubic(p)).toLocaleString();
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = target.toLocaleString();
    }
    requestAnimationFrame(step);
  }
  var tiles = document.querySelectorAll('.g-main > .dashboard .stat-tile .num[data-target]');
  if (tiles.length) {
    var tileObs = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          countUp(e.target);
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    tiles.forEach(function (t) { tileObs.observe(t); });
  }

  // ---- C. year-progress · 运行时计算 + 入场填充 ----
  var yp = document.querySelector('.g-main > .dashboard .year-progress');
  if (yp) {
    var now = new Date();
    var year = parseInt(yp.getAttribute('data-year') || now.getFullYear(), 10);
    var startOfYear = new Date(year, 0, 1);
    var endOfYear = new Date(year + 1, 0, 1);
    var day = Math.floor((now - startOfYear) / 86400000) + 1;
    var total = Math.floor((endOfYear - startOfYear) / 86400000);
    var pct = Math.min(100, Math.max(0, (day / total) * 100));
    yp.style.setProperty('--y-target', pct.toFixed(2) + '%');
    var pctEl = yp.querySelector('.y-pct');
    var dayEl = yp.querySelector('.y-day');
    if (pctEl) pctEl.textContent = pct.toFixed(1) + '%';
    if (dayEl) dayEl.textContent = '· 第 ' + day + ' / ' + total + ' 天';
    var yObs = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          yp.classList.add('in');
          obs.unobserve(yp);
        }
      });
    }, { threshold: 0.3 });
    yObs.observe(yp);
  }

  // ---- D. heatmap tooltip · 跟随鼠标,显示 日期 · N 篇 ----
  var heatmap = document.querySelector('.g-main > .dashboard .heatmap');
  if (heatmap) {
    var tip = document.createElement('div');
    tip.className = 'gf-heatmap-tip';
    tip.innerHTML = '<span class="t-date"></span><span class="t-cnt"></span>';
    document.body.appendChild(tip);
    var dateEl = tip.querySelector('.t-date');
    var cntEl = tip.querySelector('.t-cnt');
    heatmap.addEventListener('mouseover', function (e) {
      var cell = e.target.closest('.h-cell');
      if (!cell || cell.style.visibility === 'hidden') return;
      var d = cell.getAttribute('data-date');
      var c = cell.getAttribute('data-count');
      if (!d) return;
      dateEl.textContent = d;
      cntEl.textContent = c === '0' ? '· 无' : '· ' + c + ' 篇';
      tip.classList.add('show');
    });
    heatmap.addEventListener('mousemove', function (e) {
      tip.style.left = e.clientX + 'px';
      tip.style.top = e.clientY + 'px';
    });
    heatmap.addEventListener('mouseleave', function () {
      tip.classList.remove('show');
    });
  }
})();
</script>

{# 文章页 TOC 侧栏宽度可拖拽 + localStorage 持久化。
   仅在桌面 (>768px + hover-capable 设备) 启用，移动端 sidebar 走滑入浮层。 #}
<script>
(function () {
  'use strict';
  var LS_KEY = 'gf-sidebar-w';
  var MIN_W = 220;
  var MAX_W_RATIO = 0.5;          // 不超过视口 50%
  var DEFAULT_W = 360;

  // 仅在文章页 + 桌面环境运行
  var doc = document.documentElement;
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || body.classList.contains('is-home')) return;
  if (!window.matchMedia('(hover: hover) and (min-width: 769px)').matches) return;

  var sidebar = document.querySelector('aside.sidebar');
  if (!sidebar) return;

  // 恢复上次的宽度（clamp 到合理范围）
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
  try {
    var saved = parseInt(localStorage.getItem(LS_KEY) || '', 10);
    if (saved && saved >= MIN_W) {
      var maxW = Math.floor(window.innerWidth * MAX_W_RATIO);
      sidebar.style.setProperty('--gf-sidebar-w', clamp(saved, MIN_W, maxW) + 'px');
    } else {
      sidebar.style.setProperty('--gf-sidebar-w', DEFAULT_W + 'px');
    }
  } catch (e) {
    sidebar.style.setProperty('--gf-sidebar-w', DEFAULT_W + 'px');
  }

  // 注入拖拽手柄
  var handle = document.createElement('div');
  handle.className = 'gf-sidebar-resizer';
  handle.setAttribute('role', 'separator');
  handle.setAttribute('aria-label', '拖动调整目录宽度');
  sidebar.appendChild(handle);

  var dragging = false;
  var startX = 0;
  var startW = 0;

  function onDown(e) {
    dragging = true;
    handle.classList.add('dragging');
    body.classList.add('gf-resizing');
    startX = e.clientX != null ? e.clientX : (e.touches && e.touches[0].clientX);
    var rect = sidebar.getBoundingClientRect();
    startW = rect.width;
    e.preventDefault();
  }
  function onMove(e) {
    if (!dragging) return;
    var x = e.clientX != null ? e.clientX : (e.touches && e.touches[0].clientX);
    if (x == null) return;
    var maxW = Math.floor(window.innerWidth * MAX_W_RATIO);
    var newW = clamp(startW + (x - startX), MIN_W, maxW);
    sidebar.style.setProperty('--gf-sidebar-w', newW + 'px');
  }
  function onUp() {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('dragging');
    body.classList.remove('gf-resizing');
    try {
      var rect = sidebar.getBoundingClientRect();
      localStorage.setItem(LS_KEY, String(Math.round(rect.width)));
    } catch (e) {}
  }

  handle.addEventListener('pointerdown', onDown);
  // pointermove/up 绑到 window，鼠标出 sidebar 也能继续拖
  window.addEventListener('pointermove', onMove);
  window.addEventListener('pointerup', onUp);
  window.addEventListener('pointercancel', onUp);
})();
</script>