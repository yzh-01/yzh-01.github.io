{# ============================================================
   1) 主页 dashboard 交互:scroll-spy + countUp + year-progress + heatmap tooltip
   ============================================================ #}
<script>
(function () {
  'use strict';
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || !body.classList.contains('is-home')) return;
  if (!('IntersectionObserver' in window)) return;

  // ---- A. scroll-spy · 当前区段 ID 写到 body[data-active] ----
  var sections = ['dashboard', 'posts', 'tags', 'about']
    .map(function (id) { return document.getElementById(id); })
    .filter(Boolean);
  if (sections.length) {
    var spy = new IntersectionObserver(function (entries) {
      // 选最近一个 intersecting 区段
      var visible = entries.filter(function (e) { return e.isIntersecting; });
      if (visible.length) {
        // 取离顶部最近的 intersecting
        visible.sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
        body.setAttribute('data-active', visible[0].target.id);
      }
    }, { rootMargin: '-30% 0px -55% 0px', threshold: 0 });
    sections.forEach(function (s) { spy.observe(s); });
  }

  // ---- B. countUp · 数字滚动入场 ----
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function countUp(el) {
    var target = parseInt(el.getAttribute('data-target') || el.textContent || '0', 10);
    if (!target || target < 1) { el.textContent = target; return; }
    if (reduceMotion) { el.textContent = target.toLocaleString(); return; }
    var dur = 900;
    var start = performance.now();
    function step(now) {
      var p = Math.min(1, (now - start) / dur);
      el.textContent = Math.round(target * easeOutCubic(p)).toLocaleString();
      if (p < 1) requestAnimationFrame(step);
      else el.textContent = target.toLocaleString();
    }
    requestAnimationFrame(step);
  }
  var tiles = document.querySelectorAll('.g-main > .dashboard .stat-tile .num[data-target]');
  if (tiles.length) {
    var tileObs = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          countUp(e.target);
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });
    tiles.forEach(function (t) { tileObs.observe(t); });
  }

  // ---- C. year-progress · 运行时计算 + 入场填充 ----
  var yp = document.querySelector('.g-main > .dashboard .year-progress');
  if (yp) {
    var now = new Date();
    var year = parseInt(yp.getAttribute('data-year') || now.getFullYear(), 10);
    var startOfYear = new Date(year, 0, 1);
    var endOfYear = new Date(year + 1, 0, 1);
    var day = Math.floor((now - startOfYear) / 86400000) + 1;
    var total = Math.floor((endOfYear - startOfYear) / 86400000);
    var pct = Math.min(100, Math.max(0, (day / total) * 100));
    yp.style.setProperty('--y-target', pct.toFixed(2) + '%');
    var pctEl = yp.querySelector('.y-pct');
    var dayEl = yp.querySelector('.y-day');
    if (pctEl) pctEl.textContent = pct.toFixed(1) + '%';
    if (dayEl) dayEl.textContent = '· 第 ' + day + ' / ' + total + ' 天';
    var yObs = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          yp.classList.add('in');
          obs.unobserve(yp);
        }
      });
    }, { threshold: 0.3 });
    yObs.observe(yp);
  }

  // ---- D. heatmap tooltip · 跟随鼠标,显示 日期 · N 篇 ----
  var heatmap = document.querySelector('.g-main > .dashboard .heatmap');
  if (heatmap) {
    var tip = document.createElement('div');
    tip.className = 'gf-heatmap-tip';
    tip.innerHTML = '<span class="t-date"></span><span class="t-cnt"></span>';
    document.body.appendChild(tip);
    var dateEl = tip.querySelector('.t-date');
    var cntEl = tip.querySelector('.t-cnt');
    heatmap.addEventListener('mouseover', function (e) {
      var cell = e.target.closest('.h-cell');
      if (!cell || cell.style.visibility === 'hidden') return;
      var d = cell.getAttribute('data-date');
      var c = cell.getAttribute('data-count');
      if (!d) return;
      dateEl.textContent = d;
      cntEl.textContent = c === '0' ? '· 无' : '· ' + c + ' 篇';
      tip.classList.add('show');
    });
    heatmap.addEventListener('mousemove', function (e) {
      tip.style.left = e.clientX + 'px';
      tip.style.top = e.clientY + 'px';
    });
    heatmap.addEventListener('mouseleave', function () {
      tip.classList.remove('show');
    });
  }
})();
</script>

{# 文章页 TOC 侧栏宽度可拖拽 + localStorage 持久化。
   仅在桌面 (>768px + hover-capable 设备) 启用，移动端 sidebar 走滑入浮层。 #}
<script>
(function () {
  'use strict';
  var LS_KEY = 'gf-sidebar-w';
  var MIN_W = 220;
  var MAX_W_RATIO = 0.5;          // 不超过视口 50%
  var DEFAULT_W = 360;

  // 仅在文章页 + 桌面环境运行
  var doc = document.documentElement;
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || body.classList.contains('is-home')) return;
  if (!window.matchMedia('(hover: hover) and (min-width: 769px)').matches) return;

  var sidebar = document.querySelector('aside.sidebar');
  if (!sidebar) return;

  // 恢复上次的宽度（clamp 到合理范围）
  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
  try {
    var saved = parseInt(localStorage.getItem(LS_KEY) || '', 10);
    if (saved && saved >= MIN_W) {
      var maxW = Math.floor(window.innerWidth * MAX_W_RATIO);
      sidebar.style.setProperty('--gf-sidebar-w', clamp(saved, MIN_W, maxW) + 'px');
    } else {
      sidebar.style.setProperty('--gf-sidebar-w', DEFAULT_W + 'px');
    }
  } catch (e) {
    sidebar.style.setProperty('--gf-sidebar-w', DEFAULT_W + 'px');
  }

  // 注入拖拽手柄
  var handle = document.createElement('div');
  handle.className = 'gf-sidebar-resizer';
  handle.setAttribute('role', 'separator');
  handle.setAttribute('aria-label', '拖动调整目录宽度');
  sidebar.appendChild(handle);

  var dragging = false;
  var startX = 0;
  var startW = 0;

  function onDown(e) {
    dragging = true;
    handle.classList.add('dragging');
    body.classList.add('gf-resizing');
    startX = e.clientX != null ? e.clientX : (e.touches && e.touches[0].clientX);
    var rect = sidebar.getBoundingClientRect();
    startW = rect.width;
    e.preventDefault();
  }
  function onMove(e) {
    if (!dragging) return;
    var x = e.clientX != null ? e.clientX : (e.touches && e.touches[0].clientX);
    if (x == null) return;
    var maxW = Math.floor(window.innerWidth * MAX_W_RATIO);
    var newW = clamp(startW + (x - startX), MIN_W, maxW);
    sidebar.style.setProperty('--gf-sidebar-w', newW + 'px');
  }
  function onUp() {
    if (!dragging) return;
    dragging = false;
    handle.classList.remove('dragging');
    body.classList.remove('gf-resizing');
    try {
      var rect = sidebar.getBoundingClientRect();
      localStorage.setItem(LS_KEY, String(Math.round(rect.width)));
    } catch (e) {}
  }

  handle.addEventListener('pointerdown', onDown);
  // pointermove/up 绑到 window，鼠标出 sidebar 也能继续拖
  window.addEventListener('pointermove', onMove);
  window.addEventListener('pointerup', onUp);
  window.addEventListener('pointercancel', onUp);
})();
</script>
{# ============================================================
   2) 主页动效升级:鼠标视差 + hero 拆字入场 + 各区段 IO 触发
   ============================================================ #}
<script>
(function () {
  'use strict';
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || !body.classList.contains('is-home')) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- A. 全局鼠标视差 · 写 --mx / --my 到 <html> ---
  (function () {
    var root = document.documentElement;
    var raf = null;
    function onMove(e) {
      if (raf) return;
      raf = requestAnimationFrame(function () {
        var x = (e.clientX / window.innerWidth) * 100;
        var y = (e.clientY / window.innerHeight) * 100;
        root.style.setProperty('--mx', x.toFixed(2) + '%');
        root.style.setProperty('--my', y.toFixed(2) + '%');
        raf = null;
      });
    }
    window.addEventListener('mousemove', onMove, { passive: true });
  })();

  // --- B. Hero line-by-line reveal · eyebrow → h1 → stamp ---
  (function () {
    var hero = document.querySelector('.g-main > .hero');
    if (!hero) return;
    var els = [
      hero.querySelector('.eyebrow'),
      hero.querySelector('.hero h1'),
      hero.querySelector('.stamp')
    ].filter(Boolean);
    if (!els.length) return;
    if (reduce) {
      els.forEach(function (el) { el.style.opacity = '1'; el.style.transform = 'none'; });
      return;
    }
    els.forEach(function (el) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(12px)';
    });
    var delays = [120, 320, 880];
    requestAnimationFrame(function () {
      els.forEach(function (el, i) {
        el.style.transition = 'opacity .8s cubic-bezier(.2,.7,.2,1) ' + delays[i] + 'ms, transform .8s cubic-bezier(.2,.7,.2,1) ' + delays[i] + 'ms';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    });
  })();

  // --- C. Posts list stagger-fade-in on scroll-in ---
  (function () {
    if (!('IntersectionObserver' in window)) return;
    var rows = document.querySelectorAll('.g-main > .sec#posts > a.post, .g-main > .sec .featured');
    if (!rows.length) return;
    if (reduce) return;
    rows.forEach(function (r, i) {
      r.style.opacity = '0';
      r.style.transform = 'translateY(10px)';
      r.style.transition = 'opacity .55s cubic-bezier(.2,.7,.2,1) ' + (i * 80) + 'ms, transform .55s cubic-bezier(.2,.7,.2,1) ' + (i * 80) + 'ms';
    });
    var io = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.style.opacity = '1';
          e.target.style.transform = 'translateY(0)';
          // featured 同时加 .in 触发其 scale 终态
          if (e.target.classList.contains('featured')) e.target.classList.add('in');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    rows.forEach(function (r) { io.observe(r); });
  })();

  // --- D. Featured 大卡 .in 触发(C 内部已包含 featured,这里只补强) ---
  // 已合并到 C 中由 rows 选择器覆盖。

  // --- E. Footer slide-up on scroll-in ---
  (function () {
    if (!('IntersectionObserver' in window)) return;
    var f = document.querySelector('.g-main > footer');
    if (!f) return;
    if (reduce) { f.classList.add('in'); return; }
    new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
      });
    }, { threshold: 0.3 }).observe(f);
  })();

  // --- F. Tag-board 比例条 IO 触发 ---
  // 比例条的 inline style 是 build 时写入的 width;IO 触发前由 JS 把 inline 写入 data-w 并临时设为 0
  (function () {
    var tb = document.querySelector('.g-main > .tag-board');
    if (!tb) return;
    var fills = tb.querySelectorAll('.bar .fill');
    if (reduce) {
      tb.classList.add('in');
      return;
    }
    fills.forEach(function (f) {
      // 提取原始 inline 宽度(px / % / 计算值),作为 data-w
      var cs = getComputedStyle(f);
      f.dataset.targetW = f.style.width || cs.width;
      f.style.width = '0';
    });
    var io = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          e.target.querySelectorAll('.bar .fill').forEach(function (f) {
            // 写回原始宽度 → 触发 transition 1s
            f.style.width = f.dataset.targetW;
          });
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.3 });
    io.observe(tb);
  })();

  // --- G. Heatmap 列向 stagger paint-in(按列延迟,53 列 × 6ms ≈ 320ms) ---
  (function () {
    if (!('IntersectionObserver' in window)) return;
    var hm = document.querySelector('.g-main > .dashboard .heatmap');
    if (!hm) return;
    var cells = hm.querySelectorAll('.h-cell');
    if (reduce) {
      cells.forEach(function (c) { c.classList.add('in'); });
      return;
    }
    new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          var list = e.target.querySelectorAll('.h-cell');
          list.forEach(function (c, i) {
            var colDelay = Math.floor(i / 7) * 6;  // 按列 stagger
            setTimeout(function () { c.classList.add('in'); }, colDelay);
          });
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.2 }).observe(hm);
  })();
})();
</script>

{# ============================================================
   3) 进入动画 · 雾散 + 雪梅绽雾心(1.5s,仅首次访问)
      CSS 接管 reveal;JS 只负责:首次加 .entry-play,1.5s 后清雾 + 写 flag
      关键:chars 默认就可见,任何 JS 失败 / 二次访问 / reduced-motion
           都不会让"雨止/灰茫"消失
   ============================================================ #}
<script>
(function () {
  'use strict';
  var body = document.body;
  if (!body || !body.classList.contains('g-fusion') || !body.classList.contains('is-home')) return;
  var mist = document.querySelector('.entry-mist');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var seen = false;
  try { seen = localStorage.getItem('gf-entry-mist') === '1'; } catch (e) {}

  if (reduce || seen) {
    // 跳过入场:mist 立即清掉,chars 已在默认 visible 状态
    if (mist && mist.parentNode) mist.parentNode.removeChild(mist);
    return;
  }

  // 首访:加 .entry-play → CSS keyframe 自动接管所有 reveal
  body.classList.add('entry-play');
  if (!mist) return;

  // 1.5s 后清雾 + 写 flag
  setTimeout(function () {
    if (mist.parentNode) mist.parentNode.removeChild(mist);
    try { localStorage.setItem('gf-entry-mist', '1'); } catch (e) {}
  }, 1500);
})();
</script>
