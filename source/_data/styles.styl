/* ============================================================
   G-fusion 主题：冷雾森系 + 真实照片背景 + 雾/雨/落叶动画
   注入位置：custom_file_path.style (源文件 .styl)
   完整复刻 design-preview/G-fusion.html 的视觉
   ============================================================ */

/* ===== Tokens · 冷雾森系 ===== */
:root{
  --paper:     transparent;
  --paper-2:   rgba(223,231,224,.85);
  --ink:       #f0f4ee;       /* 文字主色：近白偏冷 */
  --ink-soft:  #d8e0d8;
  --ink-mute:  #a8b3a8;
  --moss:      #b8d0b8;
  --moss-deep: #d8e8d4;
  --moss-bg:   rgba(140,165,140,.18);
  --frost:     #c8d4cc;
  --warm:      #d4c5a0;

  --zh-crazy: "Ma Shan Zheng", "Zhi Mang Xing", "Songti SC", serif;         /* 刷笔楷 · H1 */
  --zh-sub:   "Zhi Mang Xing", "Ma Shan Zheng", "Songti SC", serif;         /* 行书 · 小标题 */
  --zh-loose: "Noto Serif SC", "Songti SC", "ZCOOL XiaoWei", serif;         /* 衬线 · 正文 */
  --en:       "Caveat", "Ma Shan Zheng", cursive;

  /* 灰 · 雨止之后的配色基调（hero = 雨止灰茫） */
  --ash-100:   #d4d4cf;          /* 浅灰 · 浅墨 */
  --ash-300:   #a8a8a3;          /* 中灰 */
  --ash-500:   #7c7c78;          /* 深灰 · 远山 */
  --ash-bg:    rgba(160,160,155,.10);
  --ash-line:  rgba(180,180,175,.45);
  --ash-line-2: rgba(180,180,175,.6);

  /* 数据可视化专属 · 单色阶梯,严格沿 ash 系,避免引入新色相 */
  --viz-track:  rgba(216,232,212,.08);   /* 图表空轨道 / 无帖格 */
  --viz-l1:     #d4d4cf;                 /* 1 帖 · 浅墨 */
  --viz-l2:     #a8a8a3;                 /* 2 帖 · 中墨 */
  --viz-l3:     #7c7c78;                 /* 3+ 帖 · 浓墨 */

  /* 鼠标坐标 · 由 body-end.njk 的 IIFE 实时写入 */
  --mx: 50%;
  --my: 50%;
}

/* ===== 0.5 文字选中色：与冷雾森系配色统一 ===== */
.g-fusion ::selection{
  background: rgba(184,208,184,.35);
  color: var(--ink);
  text-shadow: none;
}

/* ===== 0. 关闭 NexT 默认背景/布局干扰 ===== */
/* 关键修复：NexT 基线 `html, body { height: 100% }` + `body { min-height: 100% }`
   会把 body 锁死在 viewport 高度，导致长文章溢出 body 但 html 看不到溢出，
   整页没法滚动 —— TOC 点击锚点 / anime.js 滚动 都失效。
   这里改成 min-height：body 跟随内容长高，html 出现溢出后正常出滚动条。 */
html, body{
  background: transparent !important;
  color: var(--ink);
  font-family: var(--zh-loose);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  height: auto !important;
  min-height: 100% !important;
}
.g-fusion .headband{ display: none; }
.g-fusion .main,
.g-fusion .footer{ display: none; }   /* 首页走 .g-main，不显示 NexT 原骨架 */
/* 边栏：仅首页隐藏（文章页/归档/标签页都显示，方便导航 toc） */
.g-fusion.is-home .sidebar-toggle,
.g-fusion.is-home aside.sidebar{ display: none !important; }

/* 非首页（文章/归档/分类/标签）继续用 NexT 原布局，但走冷雾配色 */
.g-fusion:not(.is-home) .main{
  display: block;
  background: transparent;
  position: relative;
  z-index: 3;
}
.g-fusion:not(.is-home) .footer{
  display: block;
  background: transparent;
}

/* ===== sidebar 适配（非首页才显示，回归 NexT fixed 模式）===== */
/* NexT 原设计：sidebar 是 position:fixed + left:-320px（藏屏外），
   sidebar-active 时 left:0 浮在屏幕左侧。正文靠 margin-left 让出空间。 */
.g-fusion:not(.is-home) aside.sidebar{
  display: block;
  background: rgba(20,30,25,.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--ink-soft);
  box-shadow: inset 0 2px 6px rgba(0,0,0,.4);
}
/* sidebar 内文字配色 */
.g-fusion:not(.is-home) .sidebar-inner,
.g-fusion:not(.is-home) .site-state,
.g-fusion:not(.is-home) .site-state-item-name,
.g-fusion:not(.is-home) .links-of-author-name,
.g-fusion:not(.is-home) .links-of-blogroll-title{
  color: var(--ink-soft);
}
.g-fusion:not(.is-home) .site-state-item-count,
.g-fusion:not(.is-home) .sidebar-nav-toc,
.g-fusion:not(.is-home) .sidebar-nav-overview{
  color: var(--ink-mute);
}
.g-fusion:not(.is-home) .sidebar-nav-toc.active,
.g-fusion:not(.is-home) .sidebar-nav-overview.active{
  color: var(--moss-deep);
  border-bottom-color: var(--moss-deep);
}
.g-fusion:not(.is-home) .sidebar-nav{
  display: flex;
  border-bottom-color: rgba(240,244,238,.18);
}
.g-fusion:not(.is-home) .sidebar-nav .sidebar-nav-toc,
.g-fusion:not(.is-home) .sidebar-nav .sidebar-nav-overview{
  border-bottom-color: transparent;
}
.g-fusion:not(.is-home) .post-toc .nav{
  list-style: none; padding: 0; margin: 0;
}
/* sidebar-toggle 浮按钮在文章页可见（首页才藏） */
.g-fusion:not(.is-home) .sidebar-toggle{
  display: block;
  background: rgba(20,30,25,.6);
  color: var(--ink-soft);
}
/* 文章页：彻底重写 layout，让 sidebar 浮在左侧 fixed，正文全宽显示。
   不依赖 body padding-left (那是 NexT Muse 默认机制，叠加会出 bug)。
   方案：
   - body padding-left 强制 0
   - main-inner 全宽 max-width: 900px, margin auto
   - sidebar position:fixed 浮在屏幕左侧
   - 桌面/窄屏共用一套 fixed 浮动，sidebar 宽度自适应 */
.g-fusion:not(.is-home).sidebar-active{
  padding-left: 0 !important;
}
.g-fusion:not(.is-home) aside.sidebar{
  position: fixed !important;
  top: 0;
  left: 0;
  /* --gf-sidebar-w 由 body-end.njk 的拖拽脚本设置并写入 localStorage */
  width: var(--gf-sidebar-w, 360px);
  max-width: 80vw;
  min-width: 220px;
  height: 100vh;
  overflow-y: auto;
  background: rgba(20,30,25,.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--ink-soft);
  padding: 80px 24px 24px;
  box-sizing: border-box;
  z-index: 10;
  display: block;
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.2,0.7,0.2,1);
}

/* 拖拽手柄：放在 sidebar 右边沿一条 6px 的可点击条；hover 时亮 moss 色 */
.g-fusion:not(.is-home) .gf-sidebar-resizer{
  position: absolute;
  top: 0;
  right: 0;
  width: 6px;
  height: 100%;
  cursor: col-resize;
  background: transparent;
  touch-action: none;
  z-index: 11;
}
.g-fusion:not(.is-home) .gf-sidebar-resizer::after{
  content: "";
  position: absolute;
  top: 50%;
  right: 2px;
  width: 2px;
  height: 28px;
  margin-top: -14px;
  border-radius: 2px;
  background: rgba(216,232,212,.25);
  transition: background .2s, height .2s;
}
.g-fusion:not(.is-home) .gf-sidebar-resizer:hover::after,
.g-fusion:not(.is-home) .gf-sidebar-resizer.dragging::after{
  background: var(--moss-deep);
  height: 56px;
}
/* 拖拽中：全局禁用文本选中 + 改 cursor */
.g-fusion:not(.is-home).gf-resizing,
.g-fusion:not(.is-home).gf-resizing *{
  cursor: col-resize !important;
  user-select: none !important;
}
/* 触屏/窄屏：不显示手柄（侧栏仍是滑入/滑出浮层） */
@media (hover: none), (max-width: 768px){
  .g-fusion:not(.is-home) .gf-sidebar-resizer{ display: none; }
}
.g-fusion:not(.is-home).sidebar-active aside.sidebar{
  transform: translateX(0) !important;
}
.g-fusion:not(.is-home).sidebar-active .main-inner{
  /* 全宽显示，不再让位 sidebar */
  max-width: 920px !important;
  width: calc(100% - 80px) !important;
  margin: 40px auto !important;
  padding: 0 20px 60px !important;
  box-sizing: border-box;
  position: relative !important;
  z-index: 5 !important;
  background: rgba(20,30,25,.4) !important;
}
/* 关键修复：article 必须显示在 main-inner 内，不能被 sidebar 遮挡 */
.g-fusion:not(.is-home).sidebar-active .main-inner .post,
.g-fusion:not(.is-home).sidebar-active .main-inner article{
  display: block !important;
  width: 100% !important;
  visibility: visible !important;
  position: relative !important;
  z-index: 10 !important;
}
/* 窄屏：sidebar 默认收起，点 toggle 浮出 */
.g-fusion:not(.is-home) .sidebar-toggle{
  display: block;
  position: fixed;
  top: 16px;
  left: 16px;
  z-index: 20;
}

.g-fusion:not(.is-home) .post-toc .nav a,
.g-fusion:not(.is-home) .post-toc .nav .toc-text{
  color: var(--ink-soft);
  text-decoration: none;
  display: block;
  padding: 4px 0 4px 12px;
  border-left: 2px solid transparent;
  transition: color .25s, border-color .25s, padding .25s;
}
.g-fusion:not(.is-home) .post-toc .nav a:hover{
  color: var(--moss-deep);
  border-left-color: var(--moss-deep);
  padding-left: 16px;
}
.g-fusion:not(.is-home) .post-toc .nav .active,
.g-fusion:not(.is-home) .post-toc .nav .active a{
  color: var(--ink) !important;
  background: rgba(216,232,212,.10);
  border-left-color: var(--moss-deep);
  font-weight: 600;
  border-radius: 0 4px 4px 0;
}
.g-fusion:not(.is-home) .post-toc .nav .active a{
  position: relative;
}
.g-fusion:not(.is-home) .post-toc .nav .active a::before{
  content: "▸";
  position: absolute;
  left: -2px;
  color: var(--moss-deep);
  animation: tocPulse 1.6s ease-in-out infinite;
}
@keyframes tocPulse{
  0%,100%{ opacity: .55; transform: translateX(0); }
  50%{ opacity: 1; transform: translateX(2px); }
}

/* ===== 1. 真实背景照片层 ===== */
.bg-photo{
  position: fixed;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-image: url('/images/home.jpg');
  /* 鼠标视差 · 与 background-attachment:fixed 共存,不抢 transform 通道 */
  background-position-x: calc(50% + (var(--mx) - 50%) * 1%);
  background-position-y: calc(50% + (var(--my) - 50%) * 1%);
  filter: saturate(.55) brightness(.45) hue-rotate(-8deg) contrast(1.05);
  mask-image: radial-gradient(ellipse at center, #000 60%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 60%, transparent 100%);
}
[data-page="post"].bg-photo{
  background-image: url('/images/post.jpg');
  filter: saturate(.4) brightness(.35) hue-rotate(-25deg) contrast(1.1);
}

/* ===== 2. 色调叠加层 ===== */
.bg-tint{
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(31,42,36,.55) 0%, rgba(91,122,102,.25) 50%, rgba(31,42,36,.65) 100%),
    radial-gradient(ellipse 60% 40% at 50% 30%, rgba(140,165,140,.15) 0%, transparent 70%);
}

/* ===== 3. 雾气（径向渐变 + 缓慢漂浮） ===== */
.fog{
  position: fixed; inset: -25%; pointer-events: none; z-index: 2;
  background:
    radial-gradient(ellipse 55% 45% at 25% 30%, rgba(140,165,140,.42) 0%, transparent 70%),
    radial-gradient(ellipse 45% 55% at 75% 65%, rgba(91,122,102,.32) 0%, transparent 70%),
    radial-gradient(ellipse 35% 35% at 50% 90%, rgba(160,180,160,.25) 0%, transparent 70%);
  animation: drift1 28s ease-in-out infinite alternate;
}
.fog.b{
  inset: -30%; opacity: .55;
  background:
    radial-gradient(ellipse 40% 50% at 60% 25%, rgba(91,122,102,.30) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 15% 75%, rgba(140,165,140,.35) 0%, transparent 70%);
  animation: drift2 36s ease-in-out infinite alternate;
}
@keyframes drift1{
  from{transform:translate(0,0) scale(1)}
  to{transform:translate(50px,-40px) scale(1.08)}
}
@keyframes drift2{
  from{transform:translate(0,0) scale(1.05)}
  to{transform:translate(-60px,45px) scale(1)}
}

/* ===== 4. 雨丝（全屏多层 linear-gradient + 动画下落） ===== */
.rain{
  position: fixed; inset: 0; pointer-events: none; z-index: 2;
  background-image:
    repeating-linear-gradient(100deg,
      transparent 0,
      transparent 8px,
      rgba(91,122,102,.14) 8px,
      rgba(91,122,102,.14) 9px),
    repeating-linear-gradient(95deg,
      transparent 0,
      transparent 14px,
      rgba(91,122,102,.10) 14px,
      rgba(91,122,102,.10) 15px);
  background-size: 100% 100%, 100% 100%;
  animation: rain-fall 1.4s linear infinite;
  opacity: .9;
}
@keyframes rain-fall{
  from{background-position: 0 -50px, 0 -50px}
  to  {background-position: 0 50px,  0 80px}
}.rain.b{
  background-image:
    repeating-linear-gradient(105deg,
      transparent 0,
      transparent 5px,
      rgba(140,165,140,.18) 5px,
      rgba(140,165,140,.18) 5.5px);
  animation-duration: 2.2s;
  opacity: .7;
}

/* ===== 5. 噪点纹理（纸张感） ===== */
body::after{
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 3;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .11 0 0 0 0 .15 0 0 0 0 .19 0 0 0 .6 0'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.4'/></svg>");
  mix-blend-mode: multiply; opacity: .5;
}

/* ===== 6. 落叶粒子（4 种叶形 × 14 片） ===== */
.leaf{
  position: fixed; width: 14px; height: 14px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g fill='none' stroke='%23e6ede3' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'><path d='M50,8 Q38,40 50,90 Q62,40 50,8 Z' fill='%23aebdc4' fill-opacity='.85'/><path d='M50,8 L50,90'/><path d='M50,30 Q42,35 38,42 M50,30 Q58,35 62,42 M50,50 Q40,55 35,62 M50,50 Q60,55 65,62 M50,70 Q44,72 40,76 M50,70 Q56,72 60,76'/></g></svg>");
  background-repeat: no-repeat; background-size: contain;
  opacity: .55; z-index: 2; pointer-events: none;
  will-change: transform;
}
.leaf.b{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M50,5 Q42,30 50,95 Q58,30 50,5 Z' fill='%23c9d4cc' fill-opacity='.7' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M50,5 L50,95' stroke='%23e6ede3' stroke-width='.8' fill='none'/></g></svg>")}
.leaf.c{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M50,90 L20,55 Q15,35 30,25 Q45,15 50,30 Q55,15 70,25 Q85,35 80,55 Z' fill='%23d4c5a0' fill-opacity='.55' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M50,90 L50,30 M50,50 L30,40 M50,50 L70,40'/></g></svg>")}
.leaf.d{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M30,20 Q15,30 20,50 Q10,70 30,85 Q50,92 70,82 Q88,72 85,50 Q90,28 70,15 Q50,8 30,20 Z' fill='%23d8e0dc' fill-opacity='.7' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M25,30 Q50,45 75,30 M22,55 Q50,65 78,55 M30,75 Q50,82 75,72' stroke='%23e6ede3' stroke-width='.7' fill='none' opacity='.6'/></g></svg>")}
.leaf:nth-child(1){top:-5%;left:8%;width:12px;height:12px;animation:fall 22s ease-in-out infinite;animation-delay:0s}
.leaf:nth-child(2){top:-3%;left:18%;width:16px;height:14px;animation:fall 28s ease-in-out infinite;animation-delay:-3s}
.leaf:nth-child(3){top:-7%;left:28%;width:10px;height:14px;animation:fall 25s ease-in-out infinite;animation-delay:-7s}
.leaf:nth-child(4){top:-4%;left:38%;width:18px;height:12px;animation:fall 32s ease-in-out infinite;animation-delay:-11s}
.leaf:nth-child(5){top:-6%;left:46%;width:14px;height:16px;animation:fall 24s ease-in-out infinite;animation-delay:-5s}
.leaf:nth-child(6){top:-2%;left:55%;width:12px;height:14px;animation:fall 30s ease-in-out infinite;animation-delay:-14s}
.leaf:nth-child(7){top:-8%;left:64%;width:16px;height:16px;animation:fall 26s ease-in-out infinite;animation-delay:-2s}
.leaf:nth-child(8){top:-5%;left:72%;width:10px;height:12px;animation:fall 29s ease-in-out infinite;animation-delay:-9s}
.leaf:nth-child(9){top:-3%;left:82%;width:14px;height:14px;animation:fall 23s ease-in-out infinite;animation-delay:-16s}
.leaf:nth-child(10){top:-9%;left:88%;width:18px;height:14px;animation:fall 34s ease-in-out infinite;animation-delay:-6s}
.leaf:nth-child(11){top:-4%;left:14%;width:12px;height:16px;animation:fall 27s ease-in-out infinite;animation-delay:-19s}
.leaf:nth-child(12){top:-6%;left:35%;width:14px;height:12px;animation:fall 31s ease-in-out infinite;animation-delay:-12s}
.leaf:nth-child(13){top:-3%;left:60%;width:16px;height:14px;animation:fall 25s ease-in-out infinite;animation-delay:-22s}
.leaf:nth-child(14){top:-7%;left:78%;width:10px;height:14px;animation:fall 28s ease-in-out infinite;animation-delay:-15s}
@keyframes fall{
  0%{transform:translate(0,0) rotate(0deg) scaleX(1);opacity:0}
  6%{opacity:.7}
  25%{transform:translate(40px,28vh) rotate(140deg) scaleX(.6)}
  50%{transform:translate(-30px,55vh) rotate(320deg) scaleX(1.1)}
  75%{transform:translate(50px,80vh) rotate(500deg) scaleX(.8)}
  94%{opacity:.5}
  100%{transform:translate(-20px,115vh) rotate(720deg) scaleX(1);opacity:0}
}

/* ============================================================
   首页容器 · 主+侧栏 grid 布局(经典博主风)
   ============================================================ */
.g-main{
  position: relative; z-index: 3;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 64px;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 28px;
}
/* 顶部导航 + footer 跨两列 */
.g-main > nav.top,
.g-main > footer{ grid-column: 1 / -1; }

/* ===== 侧栏 sticky 容器 ===== */
.g-side{
  position: sticky;
  top: 96px;
  align-self: start;
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--ash-line-2) transparent;
  padding-right: 4px;
}
.g-side::-webkit-scrollbar{ width: 4px; }
.g-side::-webkit-scrollbar-thumb{ background: var(--ash-line-2); border-radius: 2px; }
.g-side > * + *{ margin-top: 36px; }
.g-side .label{
  font-family: var(--en); font-size: 11px;
  letter-spacing: 0.4em;
  color: var(--ink-mute);
  text-transform: uppercase;
  margin-bottom: 14px;
}

/* ===== Widget 1: 搜索 ===== */
.g-search{ position: relative; }
.g-search input{
  width: 100%;
  padding: 10px 14px 10px 36px;
  font-family: var(--zh-loose); font-size: 14px;
  color: var(--ink);
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 6px;
  outline: none;
  transition: border-color .25s, background .25s, box-shadow .25s;
  box-sizing: border-box;
}
.g-search input::placeholder{ color: var(--ink-mute); }
.g-search input:focus{
  border-color: var(--ash-line-2);
  background: rgba(160,160,155,.12);
  box-shadow: 0 0 0 3px rgba(216,232,212,.08);
}
.g-search::before{
  content: ""; position: absolute;
  left: 12px; top: 50%; transform: translateY(-50%);
  width: 14px; height: 14px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none' stroke='%23a8b3a8' stroke-width='1.4'><circle cx='7' cy='7' r='5'/><path d='M11 11l3 3'/></svg>");
  background-repeat: no-repeat; background-size: contain;
  pointer-events: none;
}
.g-search-results{
  position: absolute; top: calc(100% + 6px); left: 0; right: 0;
  margin: 0; padding: 6px 0;
  list-style: none;
  background: rgba(20,30,25,.95);
  border: 1px solid var(--ash-line);
  border-radius: 6px;
  max-height: 320px; overflow-y: auto;
  z-index: 60;
  box-shadow: 0 8px 24px rgba(0,0,0,.4);
}
.g-search-results li{ padding: 0; }
.g-search-results li a{
  display: block;
  padding: 8px 14px;
  font-family: var(--zh-loose); font-size: 14px;
  color: var(--ink-soft);
  text-decoration: none;
  border-left: 2px solid transparent;
  transition: color .2s, background .2s, border-color .2s;
}
.g-search-results li a:hover{
  color: var(--ink);
  background: rgba(216,232,212,.08);
  border-left-color: var(--moss-deep);
}
.g-search-results li.empty{
  padding: 10px 14px;
  font-family: var(--zh-loose); font-size: 13px;
  color: var(--ink-mute); font-style: italic;
}

/* ===== Widget 2: 最近更新 ===== */
.g-recent{ display: flex; flex-direction: column; gap: 10px; }
.g-recent-item{
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
  align-items: baseline;
  padding: 6px 0;
  text-decoration: none; color: inherit;
  border-bottom: 1px dashed var(--ash-line);
  transition: padding-left .25s, border-color .25s;
}
.g-recent-item:hover{
  padding-left: 6px;
  border-bottom-color: var(--moss-deep);
}
.g-recent-item .t{
  font-family: var(--zh-sub); font-size: 15px;
  color: var(--ash-100);
  letter-spacing: 0.02em;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.g-recent-item .d{
  font-family: var(--en); font-size: 11px;
  color: var(--ink-mute);
  letter-spacing: 0.1em;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* ===== Widget 3: 标签云 ===== */
.g-tagcloud .chips{
  display: flex; flex-wrap: wrap;
  gap: 8px 10px;
  align-items: baseline;
}
.g-tagcloud .chip{
  display: inline-flex; align-items: baseline; gap: 4px;
  font-family: var(--zh-sub);
  color: var(--ash-100);
  letter-spacing: 0.02em;
  text-decoration: none;
  padding: 2px 6px;
  border-radius: 3px;
  transition: color .25s, background .25s;
  line-height: 1.2;
}
.g-tagcloud .chip:hover{
  color: var(--moss-deep);
  background: rgba(140,165,140,.10);
}
.g-tagcloud .chip .cnt{
  font-family: var(--en); font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.08em;
  vertical-align: super;
  font-variant-numeric: tabular-nums;
}

/* ===== Widget 4: 友链 ===== */
.g-friends{ display: flex; flex-direction: column; gap: 8px; }
.g-friend{
  display: flex; flex-direction: column;
  padding: 8px 12px;
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 6px;
  text-decoration: none; color: inherit;
  transition: transform .2s, border-color .2s, background .2s;
}
.g-friend:hover{
  transform: translateX(2px);
  border-color: var(--moss-deep);
  background: rgba(160,160,155,.14);
}
.g-friend .n{
  font-family: var(--zh-sub); font-size: 14px;
  color: var(--ash-100);
  letter-spacing: 0.04em;
}
.g-friend .d{
  font-family: var(--zh-loose); font-size: 12px;
  color: var(--ink-mute);
  margin-top: 2px;
  font-style: italic;
}

/* ===== 1024 以下:单列堆叠 ===== */
@media (max-width: 1023px){
  .g-main{
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
  }
  .g-side{
    position: static;
    max-height: none;
    border-top: 1px solid var(--ash-line);
    padding-top: 32px;
  }
}
@media (max-width: 600px){
  .g-main{ padding: 0 20px; gap: 32px; }
}

/* ===== 组件 1: 顶部导航 ===== */
.g-main > nav.top{
  display: flex; align-items: center; justify-content: space-between;
  padding: 22px 28px;
  /* sticky + backdrop blur + 半透 — 滚动时浮在内容之上,不挡视野 */
  position: sticky; top: 0; z-index: 50;
  margin: 0 -28px 18vh;
  background: rgba(20,30,25,.55);
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(240,244,238,.12);
  font-family: var(--en); font-size: 14px;
  color: var(--ink-mute); letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0; animation: g-fade-in 1s ease 0.1s forwards;
}
.g-main > nav.top .logo{
  font-family: var(--zh-crazy); font-size: 26px;
  color: var(--ink); letter-spacing: 0.06em;
  text-transform: none;
  text-decoration: none;
}
.g-main > nav.top ul{ display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; }
.g-main > nav.top a{
  color: var(--ink-mute); text-decoration: none;
  border-bottom: 1px solid transparent; padding-bottom: 2px;
  transition: color 0.3s, border-color 0.3s;
}
.g-main > nav.top a:hover{ color: var(--moss-deep); border-bottom-color: var(--moss-deep); }
/* scroll-spy: body[data-active="xxx"] 由 body-end.njk 写入 */
body[data-active="dashboard"] .top a[href="#dashboard"],
body[data-active="posts"]     .top a[href="#posts"],
body[data-active="tags"]      .top a[href="#tags"],
body[data-active="about"]     .top a[href="#about"]{
  color: var(--moss-deep);
  border-bottom-color: var(--moss-deep);
}
@keyframes g-fade-in{
  to{opacity:1}
}

/* ===== 组件 2: Hero =====  雨止灰茫 / 雪梅 */
.g-main > .hero{
  position: relative;
  margin-bottom: 12vh;
  text-align: left;
}
/* 水墨笔触角落 · 不喧宾夺主,只在 hero 顶部和底部 */
.g-main > .hero::before,
.g-main > .hero::after{
  content: ""; position: absolute;
  width: 64px; height: 64px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g fill='none' stroke='%23d4d4cf' stroke-opacity='.22' stroke-width='1.2' stroke-linecap='round'><path d='M10 50 Q 30 20 60 28 T 90 18'/><path d='M14 70 Q 28 56 40 62' stroke-opacity='.15'/></g></svg>");
  background-repeat: no-repeat; background-size: contain;
  pointer-events: none;
}
.g-main > .hero::before{
  top: -8px; right: -4px;
  transform: scaleX(-1);
}
.g-main > .hero::after{
  bottom: -32px; left: -4px;
  width: 48px; height: 48px; opacity: .8;
}
.g-main > .hero .eyebrow{
  font-family: var(--en); font-size: 13px; color: var(--moss);
  letter-spacing: 0.36em; margin-bottom: 28px; display: inline-block;
}
.g-main > .hero h1{
  font-family: var(--zh-crazy); font-weight: 400;
  font-size: clamp(56px,11vw,128px);
  line-height: 1; letter-spacing: 0.06em;
  color: var(--ink);
  text-shadow: 1px 1px 0 rgba(28,38,48,.4);
  margin-bottom: 24px;
  /* 鼠标视差:水平位移 → 极轻旋 */
  transform: rotate(calc((var(--mx) - 50%) * -.0024));
  transform-origin: 30% 60%;
  will-change: transform;
}
.g-main > .hero h1 .seal{
  display: inline-block;
  width: 42px; height: 42px;
  margin-left: 14px; vertical-align: middle;
  opacity: .9;
  transform-origin: 50% 60%;
  animation: sealSway 5s ease-in-out infinite;
}
.g-main > .hero h1 .seal-svg{
  display: block; width: 100%; height: 100%;
  overflow: visible;
}
@keyframes sealSway{
  0%,100%{ transform: rotate(-4deg); }
  50%{ transform: rotate(-1deg); }
}
.g-main > .hero .stamp{
  font-family: var(--en); font-size: 13px; color: var(--ink-mute);
  letter-spacing: 0.24em; margin-top: 14px;
}
/* 签名行 · 一句诗化短句,行书 + 灰墨 */
.g-main > .hero .signature{
  margin-top: 22px;
  font-family: var(--zh-sub); font-size: 20px;
  color: var(--ash-100); letter-spacing: 0.18em;
  line-height: 1.7;
  font-style: italic;
  opacity: .88;
}
/* 竖排小字 · 书脊感 */
.g-main > .hero .vertical-tag{
  position: absolute;
  top: 6vh; right: -16px;
  writing-mode: vertical-rl;
  text-orientation: upright;
  font-family: var(--zh-sub); font-size: 13px;
  color: var(--ash-300); letter-spacing: 0.4em;
  opacity: .55;
  user-select: none;
  pointer-events: none;
  white-space: nowrap;
}
@media (max-width: 1023px){
  .g-main > .hero .vertical-tag{ display: none; }
}

/* ===== 组件 3: 最近文章（卡片列表） + featured 大卡 ===== */
.g-main > .sec{ margin-bottom: 9vh; opacity: 0; animation: g-fade-in 1s ease 0.4s forwards; }
.g-main > .sec > .label{
  font-family: var(--en); font-size: 12px; letter-spacing: 0.4em;
  color: var(--ink-mute); text-transform: uppercase;
  margin-bottom: 36px; display: flex; align-items: center; gap: 28px;
}
.g-main > .sec > .label::before,
.g-main > .sec > .label::after{
  content: ""; flex: 1; height: 8px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 8' preserveAspectRatio='none'><path d='M2 5 Q 50 2 100 5 T 198 5' fill='none' stroke='%23a8b3a8' stroke-opacity='.35' stroke-width='1' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat; background-size: 100% 100%;
}

/* 卡片样式只在首页 .g-main 内生效 —— 否则会和 NexT 文章页 .main-inner.post 的 class 名冲突，
   把文章正文挤成 60px 宽（一行只装得下 3 个汉字）。 */
.g-main .post{
  display: grid; grid-template-columns: 60px 1fr auto; gap: 24px;
  align-items: baseline;
  padding: 24px 0;
  border-bottom: 1px solid rgba(28,38,48,.08);
  cursor: pointer;
  transition: padding 0.5s cubic-bezier(0.2,0.7,0.2,1), background 0.4s;
  text-decoration: none; color: inherit;
}
.g-main .post:hover{
  padding-left: 14px; padding-right: 14px; background: rgba(140,165,140,.10);
}
.g-main .post .num{
  font-family: var(--en); font-size: 14px; color: var(--moss);
  letter-spacing: 0.1em;
}
/* 文章标题：用 Zhi Mang Xing（行书） */
.g-main .post .body .t{
  font-family: var(--zh-sub); font-size: 36px;
  color: var(--ink); letter-spacing: 0.04em;
  transition: color 0.4s;
  display: block; margin-bottom: 4px;
}
.g-main .post:hover .body .t{ color: var(--moss-deep); }
.g-main .post .body .ex{
  font-family: var(--zh-loose); font-size: 15px;
  color: var(--ink-mute); font-style: italic;
}
.g-main .post .d{
  font-family: var(--en); font-size: 14px; color: var(--ink-mute);
  letter-spacing: 0.06em; white-space: nowrap;
}

/* 组件 4: 标签墙 (.tag-board) —— 取代旧 .tags-wrap;样式见下方"组件 C"。 */

/* ===== 组件 5: 关于（带 GitHub 头像 + 关注按钮） =====
   配色:冷灰基调,呼应 hero "雨止灰茫";
   按钮保留 moss 绿作单点强调色。 */
.g-main > .about{
  margin-bottom: 9vh;
  padding: 36px 32px;
  /* 浅墨灰底,叠一条极淡的纵向灰渐变模拟"雨止后湿纸"的层次 */
  background:
    linear-gradient(180deg, rgba(190,190,185,.10) 0%, rgba(160,160,155,.05) 100%),
    rgba(124,124,120,.08);
  border-left: 3px solid var(--ash-300);
  border-radius: 0 8px 8px 0;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    inset 0 0 24px rgba(124,124,120,.06);
  opacity: 0; animation: g-fade-in 1s ease 0.8s forwards;
  position: relative;
  transform: rotate(0.4deg);

  .about-card{
    display: flex; gap: 28px; align-items: flex-start;
  }
  .avatar{
    flex-shrink: 0; display: block;
    width: 88px; height: 88px;
    border-radius: 50%; overflow: hidden;
    border: 2px solid var(--ash-100);
    box-shadow:
      0 4px 14px rgba(28,38,48,.12),
      inset 0 0 0 1px rgba(255,255,255,.06);
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1), box-shadow 0.35s;
    background: var(--paper-2);
    filter: saturate(.7);
    &:hover{
      transform: translateY(-3px) rotate(-2deg);
      box-shadow: 0 8px 20px rgba(28,38,48,.18);
      filter: saturate(1);
    }
    img{
      width: 100%; height: 100%; display: block; object-fit: cover;
    }
  }
  .about-text{ flex: 1; min-width: 0; }
  h3{
    font-family: var(--zh-sub); font-size: 38px;
    color: var(--ash-100);
    margin-bottom: 14px;
    letter-spacing: 0.04em;
    text-shadow: 1px 1px 0 rgba(28,38,48,.5);
  }
  p{
    font-family: var(--zh-loose); font-size: 17px;
    color: var(--ink-soft); line-height: 1.85; margin-bottom: 10px;
  }
  .links{
    margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;
  }
  .link-btn{
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    font-family: var(--en); font-size: 14px;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--moss-deep);
    background: rgba(190,190,185,.18);
    border: 1px solid var(--ash-line);
    border-radius: 99px;
    text-decoration: none;
    transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.2s;
    &:hover{
      background: var(--moss-deep);
      color: var(--paper);
      border-color: var(--moss-deep);
      transform: translateY(-2px);
    }
    svg{ flex-shrink: 0; }
  }
  /* follow 按钮：实色主按钮 — 浅 moss 底配深字，避免和 ink 同色撞色 */
    .link-btn.follow{
      background: var(--moss-deep);
      color: #1c2630;
      border-color: var(--moss-deep);
      font-weight: 600;
      &:hover{
        background: #1c2630;
        border-color: #1c2630;
        color: var(--moss-deep);
      }
    }
  /* GitHub 按钮：深灰，与 ash 主色对齐 */
  .link-btn.gh{
    background: #2a2e30; color: var(--ash-100); border-color: #3a3e40;
    &:hover{ background: #1c2022; border-color: var(--ash-300); }
  }
}

/* ============================================================
   组件 A: Dashboard — 综合数据看板(stats + year-progress + heatmap)
   ============================================================ */
.g-main > .dashboard{
  margin-bottom: 9vh;
  opacity: 0; animation: g-fade-in 1s ease 0.3s forwards;
  /* 鼠标视差 · 极轻位移 */
  transform: translate3d(
    calc((var(--mx) - 50%) * .005),
    calc((var(--my) - 50%) * .003),
    0);
  will-change: transform;
}
.g-main > .dashboard > .label{
  font-family: var(--en); font-size: 12px; letter-spacing: 0.4em;
  color: var(--ink-mute); text-transform: uppercase;
  margin-bottom: 28px; display: flex; align-items: center; gap: 28px;
}
.g-main > .dashboard > .label::before,
.g-main > .dashboard > .label::after{
  content: ""; flex: 1; height: 8px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 8' preserveAspectRatio='none'><path d='M2 5 Q 50 2 100 5 T 198 5' fill='none' stroke='%23a8b3a8' stroke-opacity='.35' stroke-width='1' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat; background-size: 100% 100%;
}

/* A1. stats-strip · 4 块 KPI 磁贴 */
.g-main > .dashboard .stats-strip{
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
  margin-bottom: 28px;
}
.g-main > .dashboard .stat-tile{
  position: relative;
  padding: 22px 18px 18px;
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 8px;
  overflow: hidden;
  transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .35s, background .35s;
}
.g-main > .dashboard .stat-tile:hover{
  transform: translateY(-3px);
  border-color: var(--ash-line-2);
  background: rgba(160,160,155,.16);
}
.g-main > .dashboard .stat-tile .ico{
  position: absolute; top: 14px; right: 14px;
  color: var(--ash-300);
  opacity: .55;
}
.g-main > .dashboard .stat-tile .num{
  display: block;
  font-family: var(--zh-loose);
  font-size: 44px; font-weight: 400;
  color: var(--ink);
  line-height: 1;
  letter-spacing: 0.02em;
  margin-bottom: 6px;
  font-variant-numeric: tabular-nums;
}
.g-main > .dashboard .stat-tile .num .unit{
  font-size: 18px; color: var(--ink-mute); margin-left: 2px;
}
.g-main > .dashboard .stat-tile .lbl{
  font-family: var(--en); font-size: 11px; letter-spacing: 0.28em;
  color: var(--ink-mute); text-transform: uppercase;
}

/* A2. year-progress · 单档水平条 */
.g-main > .dashboard .year-progress{
  display: flex; align-items: center; gap: 18px;
  padding: 18px 20px;
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 8px;
  margin-bottom: 20px;
}
.g-main > .dashboard .year-progress .y-head{
  font-family: var(--zh-sub);
  font-size: 22px; color: var(--ink);
  letter-spacing: 0.08em;
  white-space: nowrap;
}
.g-main > .dashboard .year-progress .y-bar{
  flex: 1; position: relative;
  height: 6px;
  background: var(--viz-track);
  border-radius: 3px;
  overflow: hidden;
}
.g-main > .dashboard .year-progress .y-fill{
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 0%;
  background: linear-gradient(90deg, var(--ash-300), var(--moss-deep));
  border-radius: 3px;
  transition: width 1.2s cubic-bezier(.2,.7,.2,1) .2s;
}
.g-main > .dashboard .year-progress.in .y-fill{ /* class 由 JS 添加 */
  width: var(--y-target, 56%);
}
.g-main > .dashboard .year-progress .y-meta{
  font-family: var(--en); font-size: 12px;
  color: var(--ink-mute);
  letter-spacing: 0.18em;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}
.g-main > .dashboard .year-progress .y-meta b{
  color: var(--moss-deep); font-weight: 600; font-family: var(--zh-sub);
  font-size: 16px; margin-right: 4px;
}

/* A3. heatmap · GitHub 风格年度热力图 */
.g-main > .dashboard .heatmap{
  padding: 18px 20px;
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 8px;
}
.g-main > .dashboard .heatmap .h-head{
  display: flex; justify-content: space-between; align-items: baseline;
  font-family: var(--en); font-size: 11px; letter-spacing: 0.24em;
  color: var(--ink-mute); text-transform: uppercase;
  margin-bottom: 10px;
}
.g-main > .dashboard .heatmap .h-head b{
  color: var(--ash-100); font-weight: 600;
}
.g-main > .dashboard .heatmap .h-body{
  display: flex; gap: 6px;
}
.g-main > .dashboard .heatmap .h-grid{
  display: grid;
  grid-template-rows: repeat(7, 12px);
  grid-auto-flow: column;
  grid-auto-columns: 12px;
  gap: 2px;
  flex: 1;
}
.g-main > .dashboard .heatmap .h-cell{
  width: 12px; height: 12px;
  background: var(--viz-track);
  border-radius: 2px;
  /* IO 入场:未触发时缩小到 60%,0 透明;触发后由 JS 加 .in 恢复 */
  opacity: 0; transform: scale(.6);
  transition: opacity .35s ease, transform .35s cubic-bezier(.2,.7,.2,1),
              box-shadow .15s;
}
.g-main > .dashboard .heatmap .h-cell.in{
  opacity: 1; transform: scale(1);
}
.g-main > .dashboard .heatmap .h-cell.l1{ background: var(--viz-l1); }
.g-main > .dashboard .heatmap .h-cell.l2{ background: var(--viz-l2); }
.g-main > .dashboard .heatmap .h-cell.l3{ background: var(--viz-l3); }
.g-main > .dashboard .heatmap .h-cell:hover{
  transform: scale(1.4);
  box-shadow: 0 0 6px rgba(212,212,207,.5);
}
.g-main > .dashboard .heatmap .h-legend{
  display: flex; align-items: center; gap: 4px;
  font-family: var(--en); font-size: 10px;
  color: var(--ink-mute); letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-top: 10px;
  justify-content: flex-end;
}
.g-main > .dashboard .heatmap .h-legend .swatch{
  width: 11px; height: 11px;
  border-radius: 2px;
  background: var(--viz-track);
}
.g-main > .dashboard .heatmap .h-legend .swatch.l1{ background: var(--viz-l1); }
.g-main > .dashboard .heatmap .h-legend .swatch.l2{ background: var(--viz-l2); }
.g-main > .dashboard .heatmap .h-legend .swatch.l3{ background: var(--viz-l3); }

/* heatmap tooltip — 跟随鼠标,JS 写入 */
.gf-heatmap-tip{
  position: fixed; z-index: 100;
  padding: 5px 10px;
  background: rgba(20,30,25,.92);
  color: var(--ash-100);
  font-family: var(--en); font-size: 12px;
  letter-spacing: 0.06em;
  border: 1px solid var(--ash-line);
  border-radius: 4px;
  pointer-events: none;
  opacity: 0;
  transition: opacity .15s;
  white-space: nowrap;
  transform: translate(-50%, -130%);
}
.gf-heatmap-tip.show{ opacity: 1; }
.gf-heatmap-tip .t-date{ color: var(--moss-deep); margin-right: 6px; }

/* ============================================================
   组件 B: Featured Post 大卡(在 posts 区顶部)
   ============================================================ */
.g-main > .sec .featured{
  display: grid; grid-template-columns: 60px 1fr auto; gap: 24px;
  align-items: baseline;
  padding: 28px 24px;
  margin-bottom: 18px;
  background: var(--ash-bg);
  border: 1px solid var(--ash-line);
  border-radius: 8px;
  text-decoration: none; color: inherit;
  /* IO 触发的入场初态:缩 96% + 阴影为 0 */
  opacity: 0; transform: translateY(12px) scale(.96);
  transition: opacity .55s cubic-bezier(.2,.7,.2,1),
              transform .55s cubic-bezier(.2,.7,.2,1),
              border-color .35s, box-shadow .35s, background .35s;
}
.g-main > .sec .featured.in{
  opacity: 1; transform: translateY(0) scale(1);
}
.g-main > .sec .featured.in:hover{
  transform: translateY(-3px);
  border-color: var(--ash-line-2);
  background: rgba(160,160,155,.14);
  box-shadow: 0 8px 22px rgba(20,30,25,.35);
}
.g-main > .sec .featured:not(.in):hover{
  /* reduce-motion 或 IO 未触发时:hover 仍然有效 */
  transform: translateY(-3px) scale(.96);
}
.g-main > .sec .featured .num{
  font-family: var(--en); font-size: 14px; color: var(--moss-deep);
  letter-spacing: 0.1em;
}
.g-main > .sec .featured .t{
  font-family: var(--zh-sub);
  font-size: 32px; color: var(--ash-100);
  letter-spacing: 0.04em; display: block;
  margin-bottom: 6px;
  text-shadow: 1px 1px 0 rgba(28,38,48,.4);
}
.g-main > .sec .featured .ex{
  font-family: var(--zh-loose);
  font-size: 15px; color: var(--ink-mute);
  font-style: italic;
  display: block;
  margin-bottom: 12px;
}
.g-main > .sec .featured .meta-row{
  display: flex; gap: 8px; flex-wrap: wrap;
}
.g-main > .sec .featured .meta-row .mp{
  font-family: var(--en); font-size: 11px;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--moss-deep);
  padding: 3px 10px;
  background: rgba(140,165,140,.10);
  border: 1px solid rgba(184,208,184,.25);
  border-radius: 99px;
}
.g-main > .sec .featured .meta-row .mp.muted{ color: var(--ink-mute); }
.g-main > .sec .featured .badge-feat{
  font-family: var(--en); font-size: 10px;
  letter-spacing: 0.28em; text-transform: uppercase;
  color: var(--warm);
  padding: 4px 10px;
  border: 1px solid var(--warm);
  border-radius: 99px;
  align-self: start;
}

/* ============================================================
   组件 C: Tag Board — 标签墙(替换原 .tags-wrap)
   ============================================================ */
.g-main > .tag-board{
  margin-bottom: 9vh;
  opacity: 0; animation: g-fade-in 1s ease 0.6s forwards;
}
.g-main > .tag-board > .label{
  font-family: var(--en); font-size: 12px; letter-spacing: 0.4em;
  color: var(--ink-mute); text-transform: uppercase;
  margin-bottom: 28px; display: flex; align-items: center; gap: 28px;
}
.g-main > .tag-board > .label::before,
.g-main > .tag-board > .label::after{
  content: ""; flex: 1; height: 8px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 8' preserveAspectRatio='none'><path d='M2 5 Q 50 2 100 5 T 198 5' fill='none' stroke='%23a8b3a8' stroke-opacity='.35' stroke-width='1' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat; background-size: 100% 100%;
}
.g-main > .tag-board .tag-list{
  display: flex; flex-direction: column; gap: 10px;
}
.g-main > .tag-board .tag-pill{
  display: grid;
  grid-template-columns: 120px 1fr 40px;
  align-items: center; gap: 14px;
  padding: 10px 16px;
  background: rgba(160,160,155,.06);
  border: 1px solid var(--ash-line);
  border-radius: 6px;
  text-decoration: none; color: inherit;
  transition: transform .25s, border-color .25s, background .25s;
}
.g-main > .tag-board .tag-pill:hover{
  transform: translateY(-2px);
  border-color: var(--ash-line-2);
  background: rgba(160,160,155,.12);
}
.g-main > .tag-board .tag-pill .name{
  font-family: var(--zh-sub); font-size: 17px;
  color: var(--ash-100); letter-spacing: 0.04em;
}
.g-main > .tag-board .tag-pill .bar{
  height: 4px;
  background: var(--viz-track);
  border-radius: 2px;
  overflow: hidden;
  position: relative;
}
.g-main > .tag-board .tag-pill .bar .fill{
  height: 100%;
  background: var(--ash-300);
  border-radius: 2px;
  transition: background .25s, height .25s, width 1s cubic-bezier(.2,.7,.2,1);
}
.g-main > .tag-board .tag-pill:hover .bar .fill{
  background: var(--moss-deep);
  height: 6px;
}
.g-main > .tag-board .tag-pill .cnt{
  font-family: var(--en); font-size: 13px;
  color: var(--ink-mute); font-variant-numeric: tabular-nums;
  text-align: right;
}

/* ============================================================
   进入动画 · 纸翻(单层左翻幕,0.7s)· 首次访问
   关键:默认就可见 · JS 失败 / 二次访问 / 阻塞都不影响可见性
   ============================================================ */
.page-flip{
  position: fixed; inset: 0; z-index: 9999;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(31,42,36,.97) 0%, rgba(50,65,68,.95) 50%, rgba(31,42,36,.97) 100%),
    repeating-linear-gradient(0deg, transparent 0 2px, rgba(240,244,238,.02) 2px 3px);
  transform-origin: left center;
  transform: scaleX(1);
}

/* 仅首次访问(body.entry-play)才播翻幕 */
body.g-fusion.is-home.entry-play .page-flip{
  animation: page-flip-out .7s cubic-bezier(.6,0,.2,1) .15s forwards;
}
@keyframes page-flip-out{
  to{ transform: scaleX(0); }
}

/* 纸翻同时,hero 行做轻量 fade-up */
.hero-line-1, .hero-line-2,
.g-main > .hero .eyebrow,
.g-main > .hero .stamp{
  display: block;
  opacity: 1;
  transform: none;
}
body.g-fusion.is-home.entry-play .hero-line-1,
body.g-fusion.is-home.entry-play .hero-line-2,
body.g-fusion.is-home.entry-play .g-main > .hero .eyebrow,
body.g-fusion.is-home.entry-play .g-main > .hero .stamp{
  animation: hero-line-in .55s cubic-bezier(.2,.7,.2,1) both;
}
body.g-fusion.is-home.entry-play .hero-line-1{ animation-delay: .55s; }
body.g-fusion.is-home.entry-play .hero-line-2{ animation-delay: .65s; }
body.g-fusion.is-home.entry-play .g-main > .hero .eyebrow{ animation-delay: .75s; }
body.g-fusion.is-home.entry-play .g-main > .hero .stamp{ animation-delay: .85s; }

@keyframes hero-line-in{
  from{ opacity: 0; transform: translateY(18px); }
  to  { opacity: 1; transform: translateY(0); }
}

/* 雪梅:克制的 fade + 微缩放(去掉 spring 弹性) */
body.g-fusion.is-home.entry-play .hero h1 .seal.seal-bloom{
  animation: seal-pop .5s cubic-bezier(.2,.7,.2,1) .4s both;
}
@keyframes seal-pop{
  from{ transform: scale(.6); opacity: 0; }
  to  { transform: scale(1);  opacity: 1; }
}

/* reduced-motion:无翻幕,无 hero 入场 */
@media (prefers-reduced-motion: reduce){
  .page-flip{ display: none; }
  body.g-fusion.is-home.entry-play .page-flip,
  body.g-fusion.is-home.entry-play .hero-line-1,
  body.g-fusion.is-home.entry-play .hero-line-2,
  body.g-fusion.is-home.entry-play .g-main > .hero .eyebrow,
  body.g-fusion.is-home.entry-play .g-main > .hero .stamp,
  body.g-fusion.is-home.entry-play .hero h1 .seal.seal-bloom{ animation: none; }
}

/* ============================================================
   响应式 + reduced-motion 兼容
   ============================================================ */
@media (max-width: 768px){
  .g-main > .dashboard .stats-strip{ grid-template-columns: repeat(2, 1fr); }
  .g-main > .dashboard .year-progress{ flex-wrap: wrap; }
  .g-main > .dashboard .year-progress .y-bar{ order: 3; flex: 0 0 100%; }
  .g-main > .sec .featured{ grid-template-columns: 40px 1fr; }
  .g-main > .sec .featured .badge-feat{ grid-column: 1/3; justify-self: start; }
  .g-main > .tag-board .tag-pill{ grid-template-columns: 80px 1fr 32px; gap: 10px; padding: 8px 12px; }
  .g-main > .tag-board .tag-pill .name{ font-size: 15px; }
}
@media (max-width: 600px){
  .g-main > nav.top{
    margin: 0 -20px 14vh;
    padding: 16px 20px;
    font-size: 12px;
  }
  .g-main > nav.top ul{ gap: 14px; }
}
@media (prefers-reduced-motion: reduce){
  .g-main > .dashboard .stat-tile,
  .g-main > .sec .featured,
  .g-main > .tag-board .tag-pill,
  .g-main > .dashboard .heatmap .h-cell{ transition: none !important; }
  .g-main > .dashboard .year-progress .y-fill{ transition: none !important; }
  .g-main > .dashboard .year-progress .y-fill{ width: var(--y-target, 56%) !important; }
}

/* ===== 组件 6: Footer ===== */
.g-main > footer{
  margin-top: 8vh; padding: 24px 0 60px;
  border-top: 1px solid rgba(240,244,238,.18);
  display: flex; justify-content: space-between;
  font-family: var(--en); font-size: 13px; color: var(--ink-mute);
  letter-spacing: 0.18em; text-transform: uppercase;
  opacity: 0; transform: translateY(16px);
  animation: g-fade-in 1s ease 1s forwards;
  transition: transform .6s ease;
}
/* body-end.njk IO 触发 .in · 把 footer 升起到 0 */
.g-main > footer.in{ transform: translateY(0); }
.g-main > footer .l a{
  color: var(--ink-soft); text-decoration: none;
  margin-right: 14px;
  border-bottom: 0; padding-bottom: 2px;
  /* underline-grow,左→右滑入 */
  background-image: linear-gradient(currentColor, currentColor);
  background-size: 0% 1px;
  background-repeat: no-repeat;
  background-position: 0 100%;
  transition: background-size .35s cubic-bezier(.2,.7,.2,1), color .25s;
}
.g-main > footer .l a:hover{ background-size: 100% 1px; color: var(--moss-deep); }

/* ============================================================
   非首页（文章/归档/分类/标签）的 NexT 适配
   ============================================================ */

/* 文章标题翻浅 */
.posts-expand .post-title,
.posts-expand .post-title a,
.post-block .post-title,
.post-block .post-title a{
  font-family: var(--zh-sub);  /* Zhi Mang Xing（行书） */
  font-size: 34px;
  font-weight: 400;
  color: #f0f4ee;
  text-shadow: 1px 1px 2px rgba(0,0,0,.4);
  display: block;             /* 强制 block 排版，不被压缩 */
  width: 100%;
  max-width: 100%;
  text-align: left;
  letter-spacing: 0.04em;
  line-height: 1.3;
}
.posts-expand .post-title-link{
  display: block;
  color: inherit;
}
.posts-expand .post-meta,
.posts-expand .post-meta a,
.post-block .post-meta,
.post-block .post-meta a,
.posts-expand .post-meta time,
.post-block .post-meta time{
  color: #a8b3a8;
  border-bottom-color: rgba(240,244,238,.3);
}
.posts-expand .post-content,
.post-block .post-content,
.posts-expand .post-summary,
.post-block .post-summary,
.post-body{
  color: #d8e0d8;
}
.posts-expand .post-content p,
.posts-expand .post-body p,
.post-block .post-content p{
  color: #d8e0d8;
}
.post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6{
  color: #f0f4ee;
  border-bottom-color: rgba(240,244,238,.2);
}
.post-body strong{ color: #f0f4ee; }
.post-body a{
  color: #b8d0b8;
  border-bottom: 0;
  background-image: linear-gradient(currentColor, currentColor);
  background-size: 0% 1px;
  background-repeat: no-repeat;
  background-position: 0 100%;
  transition: background-size .35s cubic-bezier(.2,.7,.2,1), color .25s;
}
.post-body a:hover{
  color: #f0f4ee;
  background-size: 100% 1px;
}

/* blockquote / code / hr / table 适配 */
.post-body blockquote{
  color: #c8d4cc;
  border-left: 4px solid #6b8a96;
  background-color: rgba(20,30,25,.4);
}
.post-body code{
  color: #d8e8d4;
  background: rgba(20,30,25,.5);
  border: 1px solid rgba(140,165,140,.2);
}
.post-body pre{
  background-color: rgba(15,20,18,.7) !important;
}
.post-body table{
  color: #d8e0d8;
  background: rgba(20,30,25,.3);
  box-shadow: 0 0 1px rgba(240,244,238,.2);
}
.post-body table th{
  background: rgba(74,107,79,.3);
  color: #f0f4ee;
  border-color: rgba(240,244,238,.2);
}
.post-body table td{
  border-color: rgba(240,244,238,.15);
}
.post-body hr{
  border-top-color: rgba(240,244,238,.2);
}

/* 按钮 / tag */
.btn{
  color: #d8e8d4;
  border-color: rgba(184,208,184,.4);
  background: rgba(20,30,25,.3);
}
.btn:hover{
  color: #1c2630;
  background: #d8e8d4;
  border-color: #d8e8d4;
}

/* header/site-meta 适配 */
.subtitle, .site-description{ color: #d8e0d8; }
.site-title, .site-title:hover{
  color: #f0f4ee;
  text-shadow: 1px 1px 2px rgba(0,0,0,.4);
}
.site-author-name, .site-state-item-name{ color: #a8b3a8; }
.site-state-item-count{ color: #f0f4ee; }

/* footer/meta 适配 */
.footer, .footer a{ color: #a8b3a8; }
.links-of-blogroll-title, .links-of-author{ color: #d8e0d8; }

/* 减弱 NexT motion 入场动画的"卡片弹出"感 */
.g-fusion:not(.is-home) .use-motion .post-block{
  opacity: 1 !important;
  transform: none !important;
}
.g-fusion:not(.is-home) .use-motion .pagination{ opacity: 1; }

/* 文章页：sidebar toc 点击锚点跳转（smooth scroll + sticky 偏移补偿） */
.g-fusion:not(.is-home){
  scroll-behavior: smooth;
}
.g-fusion:not(.is-home) .post-body :target,
.g-fusion:not(.is-home) :target{
  scroll-margin-top: 24px;
}
/* h2/h3 锚点显示得清楚：补一点 padding 让点击跳转后能看到标题 */
.g-fusion:not(.is-home) h2[id], .g-fusion:not(.is-home) h3[id]{
  scroll-margin-top: 24px;
}

/* 减动效 + 移动端 */
@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .fog, .fog.b, .rain, .rain.b, .leaf{ animation: none; }
  .g-main > nav.top,
  .g-main > .hero,
  .g-main > .dashboard,
  .g-main > .sec,
  .g-main > .tag-board,
  .g-main > .about,
  .g-main > footer{ opacity: 1; transform: none; }
}

@media (max-width: 600px){
  .g-main > nav.top ul{ gap: 14px; font-size: 12px; }
  .g-main > nav.top .logo{ font-size: 22px; }
  .g-main .post{ grid-template-columns: 40px 1fr; gap: 14px; }
  .g-main .post .d{ grid-column: 1/3; font-size: 12px; }
  .g-main > .about{ padding: 24px 20px; }
}
@media (max-width: 768px){
  .bg-photo{ background-attachment: scroll; }
}

/* ===== 阅读进度条：moss → warm 渐变，与冷雾森系一致 ===== */
.g-fusion:not(.is-home) .reading-progress-bar{
  background: linear-gradient(90deg, var(--moss-deep), var(--warm)) !important;
  box-shadow: 0 0 6px rgba(216,232,212,.5);
}
@media (max-width: 600px){
  .reading-progress-bar{ height: 2px !important; }
}
