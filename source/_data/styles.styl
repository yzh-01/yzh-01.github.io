/* ============================================================
   G-fusion 主题：冷雾森系 + 真实照片背景 + 雾/雨/落叶动画
   注入位置：custom_file_path.style (源文件 .styl)
   完整复刻 design-preview/G-fusion.html 的视觉
   ============================================================ */

/* ===== Tokens · 冷雾森系 ===== */
:root{
  --paper:     transparent;
  --paper-2:   rgba(223,231,224,.85);
  --ink:       #f0f4ee;       /* 文字主色：近白偏冷 */
  --ink-soft:  #d8e0d8;
  --ink-mute:  #a8b3a8;
  --moss:      #b8d0b8;
  --moss-deep: #d8e8d4;
  --moss-bg:   rgba(140,165,140,.18);
  --frost:     #c8d4cc;
  --warm:      #d4c5a0;

  --zh-crazy: "Liu Jian Mao Cao", "Zhi Mang Xing", "Songti SC", serif;       /* 草书 · H1 */
  --zh-sub:   "Zhi Mang Xing", "Liu Jian Mao Cao", "Songti SC", serif;       /* 行书 · 小标题 */
  --zh-loose: "ZCOOL XiaoWei", "Zhi Mang Xing", "Songti SC", serif;          /* 细黑 · 正文 */
  --en:       "Caveat", "Liu Jian Mao Cao", cursive;
}

/* ===== 0. 关闭 NexT 默认背景/布局干扰 ===== */
html, body{
  background: transparent !important;
  color: var(--ink);
  font-family: var(--zh-loose);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
.g-fusion .headband{ display: none; }
.g-fusion .main,
.g-fusion .footer{ display: none; }   /* 首页走 .g-main，不显示 NexT 原骨架 */
/* 边栏：仅首页隐藏（文章页/归档/标签页都显示，方便导航 toc） */
.g-fusion.is-home .sidebar-toggle,
.g-fusion.is-home aside.sidebar{ display: none !important; }

/* 非首页（文章/归档/分类/标签）继续用 NexT 布局，但走冷雾配色 */
.g-fusion:not(.is-home) .main{
  display: block;
  background: transparent;
  position: relative;
  z-index: 3;
}
.g-fusion:not(.is-home) .footer{
  display: block;
  background: transparent;
}

/* ===== sidebar 适配（非首页才显示）===== */
.g-fusion:not(.is-home) aside.sidebar{
  display: block;
  background: rgba(214,222,225,.45);
  border-radius: 8px;
  padding: 18px 14px;
  margin: 28px 18px 28px 0;
  color: var(--ink);
}
.g-fusion:not(.is-home) .sidebar-nav{ display: flex; }
.g-fusion:not(.is-home) .sidebar-nav .sidebar-nav-toc,
.g-fusion:not(.is-home) .sidebar-nav .sidebar-nav-overview{
  color: var(--ink-soft);
  border-bottom-color: transparent;
}
.g-fusion:not(.is-home) .sidebar-nav-toc.active,
.g-fusion:not(.is-home) .sidebar-nav-overview.active{
  color: var(--moss-deep);
  border-bottom-color: var(--moss-deep);
}
.g-fusion:not(.is-home) .post-toc .nav{
  list-style: none; padding: 0; margin: 0;
}
.g-fusion:not(.is-home) .post-toc .nav a,
.g-fusion:not(.is-home) .post-toc .nav .toc-text{
  color: var(--ink-soft);
  text-decoration: none;
  display: block;
  padding: 4px 0 4px 12px;
  border-left: 2px solid transparent;
  transition: color .25s, border-color .25s, padding .25s;
}
.g-fusion:not(.is-home) .post-toc .nav a:hover{
  color: var(--moss-deep);
  border-left-color: var(--moss-deep);
  padding-left: 16px;
}
.g-fusion:not(.is-home) .post-toc .nav .active,
.g-fusion:not(.is-home) .post-toc .nav .active a{
  color: var(--moss-deep);
  border-left-color: var(--moss-deep);
  font-weight: 600;
}

/* ===== 1. 真实背景照片层 ===== */
.bg-photo{
  position: fixed;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  background-image: url('/images/home.jpg');
  filter: saturate(.55) brightness(.45) hue-rotate(-8deg) contrast(1.05);
  mask-image: radial-gradient(ellipse at center, #000 60%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 60%, transparent 100%);
}
[data-page="post"] .bg-photo{
  background-image: url('/images/post.jpg');
  filter: saturate(.4) brightness(.35) hue-rotate(-25deg) contrast(1.1);
}

/* ===== 2. 色调叠加层 ===== */
.bg-tint{
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(31,42,36,.55) 0%, rgba(91,122,102,.25) 50%, rgba(31,42,36,.65) 100%),
    radial-gradient(ellipse 60% 40% at 50% 30%, rgba(140,165,140,.15) 0%, transparent 70%);
}

/* ===== 3. 雾气（径向渐变 + 缓慢漂浮） ===== */
.fog{
  position: fixed; inset: -25%; pointer-events: none; z-index: 2;
  background:
    radial-gradient(ellipse 55% 45% at 25% 30%, rgba(140,165,140,.42) 0%, transparent 70%),
    radial-gradient(ellipse 45% 55% at 75% 65%, rgba(91,122,102,.32) 0%, transparent 70%),
    radial-gradient(ellipse 35% 35% at 50% 90%, rgba(160,180,160,.25) 0%, transparent 70%);
  animation: drift1 28s ease-in-out infinite alternate;
}
.fog.b{
  inset: -30%; opacity: .55;
  background:
    radial-gradient(ellipse 40% 50% at 60% 25%, rgba(91,122,102,.30) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 15% 75%, rgba(140,165,140,.35) 0%, transparent 70%);
  animation: drift2 36s ease-in-out infinite alternate;
}
@keyframes drift1{
  from{transform:translate(0,0) scale(1)}
  to{transform:translate(50px,-40px) scale(1.08)}
}
@keyframes drift2{
  from{transform:translate(0,0) scale(1.05)}
  to{transform:translate(-60px,45px) scale(1)}
}

/* ===== 4. 雨丝（全屏多层 linear-gradient + 动画下落） ===== */
.rain{
  position: fixed; inset: 0; pointer-events: none; z-index: 2;
  background-image:
    repeating-linear-gradient(100deg,
      transparent 0,
      transparent 8px,
      rgba(91,122,102,.14) 8px,
      rgba(91,122,102,.14) 9px),
    repeating-linear-gradient(95deg,
      transparent 0,
      transparent 14px,
      rgba(91,122,102,.10) 14px,
      rgba(91,122,102,.10) 15px);
  background-size: 100% 100%, 100% 100%;
  animation: rain-fall 1.4s linear infinite;
  opacity: .9;
}
@keyframes rain-fall{
  from{background-position: 0 -50px, 0 -50px}
  to  {background-position: 0 50px,  0 80px}
}.rain.b{
  background-image:
    repeating-linear-gradient(105deg,
      transparent 0,
      transparent 5px,
      rgba(140,165,140,.18) 5px,
      rgba(140,165,140,.18) 5.5px);
  animation-duration: 2.2s;
  opacity: .7;
}

/* ===== 5. 噪点纹理（纸张感） ===== */
body::after{
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 3;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .11 0 0 0 0 .15 0 0 0 0 .19 0 0 0 .6 0'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.4'/></svg>");
  mix-blend-mode: multiply; opacity: .5;
}

/* ===== 6. 落叶粒子（4 种叶形 × 14 片） ===== */
.leaf{
  position: fixed; width: 14px; height: 14px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g fill='none' stroke='%23e6ede3' stroke-width='1.2' stroke-linecap='round' stroke-linejoin='round'><path d='M50,8 Q38,40 50,90 Q62,40 50,8 Z' fill='%23aebdc4' fill-opacity='.85'/><path d='M50,8 L50,90'/><path d='M50,30 Q42,35 38,42 M50,30 Q58,35 62,42 M50,50 Q40,55 35,62 M50,50 Q60,55 65,62 M50,70 Q44,72 40,76 M50,70 Q56,72 60,76'/></g></svg>");
  background-repeat: no-repeat; background-size: contain;
  opacity: .55; z-index: 2; pointer-events: none;
  will-change: transform;
}
.leaf.b{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M50,5 Q42,30 50,95 Q58,30 50,5 Z' fill='%23c9d4cc' fill-opacity='.7' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M50,5 L50,95' stroke='%23e6ede3' stroke-width='.8' fill='none'/></g></svg>")}
.leaf.c{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M50,90 L20,55 Q15,35 30,25 Q45,15 50,30 Q55,15 70,25 Q85,35 80,55 Z' fill='%23d4c5a0' fill-opacity='.55' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M50,90 L50,30 M50,50 L30,40 M50,50 L70,40'/></g></svg>")}
.leaf.d{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><g><path d='M30,20 Q15,30 20,50 Q10,70 30,85 Q50,92 70,82 Q88,72 85,50 Q90,28 70,15 Q50,8 30,20 Z' fill='%23d8e0dc' fill-opacity='.7' stroke='%23e6ede3' stroke-width='1' stroke-linejoin='round'/><path d='M25,30 Q50,45 75,30 M22,55 Q50,65 78,55 M30,75 Q50,82 75,72' stroke='%23e6ede3' stroke-width='.7' fill='none' opacity='.6'/></g></svg>")}
.leaf:nth-child(1){top:-5%;left:8%;width:12px;height:12px;animation:fall 22s ease-in-out infinite;animation-delay:0s}
.leaf:nth-child(2){top:-3%;left:18%;width:16px;height:14px;animation:fall 28s ease-in-out infinite;animation-delay:-3s}
.leaf:nth-child(3){top:-7%;left:28%;width:10px;height:14px;animation:fall 25s ease-in-out infinite;animation-delay:-7s}
.leaf:nth-child(4){top:-4%;left:38%;width:18px;height:12px;animation:fall 32s ease-in-out infinite;animation-delay:-11s}
.leaf:nth-child(5){top:-6%;left:46%;width:14px;height:16px;animation:fall 24s ease-in-out infinite;animation-delay:-5s}
.leaf:nth-child(6){top:-2%;left:55%;width:12px;height:14px;animation:fall 30s ease-in-out infinite;animation-delay:-14s}
.leaf:nth-child(7){top:-8%;left:64%;width:16px;height:16px;animation:fall 26s ease-in-out infinite;animation-delay:-2s}
.leaf:nth-child(8){top:-5%;left:72%;width:10px;height:12px;animation:fall 29s ease-in-out infinite;animation-delay:-9s}
.leaf:nth-child(9){top:-3%;left:82%;width:14px;height:14px;animation:fall 23s ease-in-out infinite;animation-delay:-16s}
.leaf:nth-child(10){top:-9%;left:88%;width:18px;height:14px;animation:fall 34s ease-in-out infinite;animation-delay:-6s}
.leaf:nth-child(11){top:-4%;left:14%;width:12px;height:16px;animation:fall 27s ease-in-out infinite;animation-delay:-19s}
.leaf:nth-child(12){top:-6%;left:35%;width:14px;height:12px;animation:fall 31s ease-in-out infinite;animation-delay:-12s}
.leaf:nth-child(13){top:-3%;left:60%;width:16px;height:14px;animation:fall 25s ease-in-out infinite;animation-delay:-22s}
.leaf:nth-child(14){top:-7%;left:78%;width:10px;height:14px;animation:fall 28s ease-in-out infinite;animation-delay:-15s}
@keyframes fall{
  0%{transform:translate(0,0) rotate(0deg) scaleX(1);opacity:0}
  6%{opacity:.7}
  25%{transform:translate(40px,28vh) rotate(140deg) scaleX(.6)}
  50%{transform:translate(-30px,55vh) rotate(320deg) scaleX(1.1)}
  75%{transform:translate(50px,80vh) rotate(500deg) scaleX(.8)}
  94%{opacity:.5}
  100%{transform:translate(-20px,115vh) rotate(720deg) scaleX(1);opacity:0}
}

/* ============================================================
   首页容器（完全复刻 G-fusion 的 main）
   ============================================================ */
.g-main{
  position: relative; z-index: 3;
  max-width: 880px; margin: 0 auto; padding: 0 28px;
}

/* ===== 组件 1: 顶部导航 ===== */
.g-main > nav.top{
  display: flex; align-items: center; justify-content: space-between;
  padding: 28px 0 22px;
  border-bottom: 1px solid rgba(240,244,238,.18);
  margin-bottom: 18vh;
  font-family: var(--en); font-size: 14px;
  color: var(--ink-mute); letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0; animation: g-fade-in 1s ease 0.1s forwards;
}
.g-main > nav.top .logo{
  font-family: var(--zh-crazy); font-size: 26px;
  color: var(--ink); letter-spacing: 0.06em;
  text-transform: none;
  text-decoration: none;
}
.g-main > nav.top ul{ display: flex; gap: 24px; list-style: none; }
.g-main > nav.top a{
  color: var(--ink-mute); text-decoration: none;
  border-bottom: 1px solid transparent; padding-bottom: 1px;
  transition: color 0.3s, border-color 0.3s;
}
.g-main > nav.top a:hover{ color: #d8e8d4; border-bottom-color: #d8e8d4; }
@keyframes g-fade-in{
  to{opacity:1}
}

/* ===== 组件 2: Hero ===== */
.g-main > .hero{
  margin-bottom: 18vh;
  transform: rotate(-1.2deg); transform-origin: left center;
  margin-left: -10px;
}
.g-main > .hero .eyebrow{
  font-family: var(--en); font-size: 13px; color: var(--moss);
  letter-spacing: 0.36em; margin-bottom: 28px; display: inline-block;
}
.g-main > .hero h1{
  font-family: var(--zh-crazy); font-weight: 400;
  font-size: clamp(56px,13vw,144px);
  line-height: 1; letter-spacing: 0.04em;
  color: var(--ink);
  text-shadow: 1px 1px 0 rgba(28,38,48,.4);
  margin-bottom: 24px;
}
.g-main > .hero h1 .seal{
  display: inline-block; width: 42px; height: 42px; line-height: 42px; text-align: center;
  font-family: var(--zh-sub); font-size: 18px; color: var(--warm);
  border: 1.5px solid var(--warm); border-radius: 4px;
  transform: rotate(-3deg); opacity: .85;
  margin-left: 10px; vertical-align: middle;
}
.g-main > .hero .stamp{
  font-family: var(--en); font-size: 13px; color: var(--ink-mute);
  letter-spacing: 0.24em; margin-top: 14px;
}

/* ===== 组件 3: 最近文章（卡片列表） ===== */
.g-main > .sec{ margin-bottom: 14vh; opacity: 0; animation: g-fade-in 1s ease 0.4s forwards; }
.g-main > .sec > .label{
  font-family: var(--en); font-size: 12px; letter-spacing: 0.4em;
  color: var(--ink-mute); text-transform: uppercase;
  margin-bottom: 36px; display: flex; align-items: center; gap: 16px;
}
.g-main > .sec > .label::before,
.g-main > .sec > .label::after{ content: ""; flex: 1; border-top: 1px solid rgba(240,244,238,.2); }

.post{
  display: grid; grid-template-columns: 60px 1fr auto; gap: 24px;
  align-items: baseline;
  padding: 24px 0;
  border-bottom: 1px solid rgba(28,38,48,.08);
  cursor: pointer;
  transition: padding 0.5s cubic-bezier(0.2,0.7,0.2,1), background 0.4s;
  text-decoration: none; color: inherit;
}
.post:hover{
  padding-left: 14px; padding-right: 14px; background: rgba(140,165,140,.10);
}
.post .num{
  font-family: var(--en); font-size: 14px; color: var(--moss);
  letter-spacing: 0.1em;
}
/* 文章标题：用 Zhi Mang Xing（行书） */
.post .body .t{
  font-family: var(--zh-sub); font-size: 36px;
  color: var(--ink); letter-spacing: 0.04em;
  transition: color 0.4s;
  display: block; margin-bottom: 4px;
}
.post:hover .body .t{ color: var(--moss-deep); }
.post .body .ex{
  font-family: var(--zh-loose); font-size: 15px;
  color: var(--ink-mute); font-style: italic;
}
.post .d{
  font-family: var(--en); font-size: 14px; color: var(--ink-mute);
  letter-spacing: 0.06em; white-space: nowrap;
}

/* 组件 4: 标签云 */
.g-main > .tags-wrap{ margin-bottom: 14vh; opacity: 0; animation: g-fade-in 1s ease 0.6s forwards; }
.g-main > .tags-wrap .tags{
  display: flex; flex-wrap: wrap; gap: 14px 18px;
  padding: 20px 0;
}
.g-main > .tags-wrap .tag{
  font-family: var(--zh-loose); font-size: 17px;
  color: var(--ink-soft);
  border: 1px solid rgba(240,244,238,.22);
  padding: 8px 16px; border-radius: 99px;
  cursor: pointer;
  transition: all 0.3s ease;
  background: var(--moss-bg);
  text-decoration: none;
}
.g-main > .tags-wrap .tag .cnt{
  font-family: var(--en); font-size: 13px;
  color: var(--ink-mute); margin-left: 6px;
}
.g-main > .tags-wrap .tag:hover{
  color: #f0f4ee; border-color: #f0f4ee;
  transform: translateY(-2px);
  background: rgba(140,165,140,.25);
}
.g-main > .tags-wrap .tag.lg{
  border: 1.5px solid #d8e8d4;
  color: #f0f4ee;
  background: rgba(140,165,140,.28);
}
.g-main > .tags-wrap .tag.lg:hover{
  background: #d8e8d4; color: #1c2630;
}
.g-main > .tags-wrap .tag.sm{
  color: var(--ink-mute);
  background: transparent;
  border-style: dashed;
}

/* ===== 组件 5: 关于（带 GitHub 头像 + 关注按钮） ===== */
.g-main > .about{
  margin-bottom: 14vh;
  padding: 36px 32px;
  background: rgba(214,222,225,.35);
  border-left: 3px solid var(--moss);
  border-radius: 0 8px 8px 0;
  opacity: 0; animation: g-fade-in 1s ease 0.8s forwards;
  position: relative;
  transform: rotate(0.4deg);

  .about-card{
    display: flex; gap: 28px; align-items: flex-start;
  }
  .avatar{
    flex-shrink: 0; display: block;
    width: 88px; height: 88px;
    border-radius: 50%; overflow: hidden;
    border: 2px solid var(--moss-deep);
    box-shadow: 0 4px 14px rgba(28,38,48,.12);
    transition: transform 0.35s cubic-bezier(.2,.7,.2,1), box-shadow 0.35s;
    background: var(--paper-2);
    &:hover{
      transform: translateY(-3px) rotate(-2deg);
      box-shadow: 0 8px 20px rgba(28,38,48,.18);
    }
    img{
      width: 100%; height: 100%; display: block; object-fit: cover;
    }
  }
  .about-text{ flex: 1; min-width: 0; }
  h3{
    font-family: var(--zh-sub); font-size: 38px;
    color: var(--ink); margin-bottom: 14px; letter-spacing: 0.04em;
  }
  p{
    font-family: var(--zh-loose); font-size: 17px;
    color: var(--ink-soft); line-height: 1.85; margin-bottom: 10px;
  }
  .links{
    margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap;
  }
  .link-btn{
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    font-family: var(--en); font-size: 14px;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--moss-deep);
    background: rgba(255,255,255,.55);
    border: 1px solid var(--moss-deep);
    border-radius: 99px;
    text-decoration: none;
    transition: background 0.3s, color 0.3s, transform 0.2s;
    &:hover{
      background: var(--moss-deep); color: var(--paper);
      transform: translateY(-2px);
    }
    svg{ flex-shrink: 0; }
  }
  /* follow 按钮：实色主按钮 */
    .link-btn.follow{
      background: var(--moss-deep); color: var(--ink);
      &:hover{
        background: var(--ink); border-color: var(--ink);
        color: var(--paper);
      }
    }
  /* GitHub 按钮：深色 */
  .link-btn.gh{
    background: #1c2630; color: #e6ede3; border-color: #1c2630;
    &:hover{ background: #36434c; border-color: #36434c; }
  }
}

/* ===== 组件 6: Footer ===== */
.g-main > footer{
  margin-top: 8vh; padding: 24px 0 60px;
  border-top: 1px solid rgba(240,244,238,.18);
  display: flex; justify-content: space-between;
  font-family: var(--en); font-size: 13px; color: var(--ink-mute);
  letter-spacing: 0.18em; text-transform: uppercase;
  opacity: 0; animation: g-fade-in 1s ease 1s forwards;
}
.g-main > footer .l a{
  color: var(--ink-soft); text-decoration: none;
  margin-right: 14px;
  border-bottom: 1px solid rgba(240,244,238,.22); padding-bottom: 1px;
}

/* ============================================================
   非首页（文章/归档/分类/标签）的 NexT 适配
   ============================================================ */

/* 文章标题翻浅 */
.posts-expand .post-title,
.posts-expand .post-title a,
.post-block .post-title,
.post-block .post-title a{
  font-family: var(--zh-sub);  /* Zhi Mang Xing（行书） */
  font-size: 34px;
  font-weight: 400;
  color: #f0f4ee;
  text-shadow: 1px 1px 2px rgba(0,0,0,.4);
  display: block;             /* 强制 block 排版，不被压缩 */
  width: 100%;
  max-width: 100%;
  text-align: left;
  letter-spacing: 0.04em;
  line-height: 1.3;
}
.posts-expand .post-title-link{
  display: block;
  color: inherit;
}
.posts-expand .post-meta,
.posts-expand .post-meta a,
.post-block .post-meta,
.post-block .post-meta a,
.posts-expand .post-meta time,
.post-block .post-meta time{
  color: #a8b3a8;
  border-bottom-color: rgba(240,244,238,.3);
}
.posts-expand .post-content,
.post-block .post-content,
.posts-expand .post-summary,
.post-block .post-summary,
.post-body{
  color: #d8e0d8;
}
.posts-expand .post-content p,
.posts-expand .post-body p,
.post-block .post-content p{
  color: #d8e0d8;
}
.post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6{
  color: #f0f4ee;
  border-bottom-color: rgba(240,244,238,.2);
}
.post-body strong{ color: #f0f4ee; }
.post-body a{
  color: #b8d0b8;
  border-bottom-color: rgba(184,208,184,.4);
}
.post-body a:hover{
  color: #f0f4ee;
  border-bottom-color: #f0f4ee;
}

/* blockquote / code / hr / table 适配 */
.post-body blockquote{
  color: #c8d4cc;
  border-left: 4px solid #6b8a96;
  background-color: rgba(20,30,25,.4);
}
.post-body code{
  color: #d8e8d4;
  background: rgba(20,30,25,.5);
  border: 1px solid rgba(140,165,140,.2);
}
.post-body pre{
  background-color: rgba(15,20,18,.7) !important;
}
.post-body table{
  color: #d8e0d8;
  background: rgba(20,30,25,.3);
  box-shadow: 0 0 1px rgba(240,244,238,.2);
}
.post-body table th{
  background: rgba(74,107,79,.3);
  color: #f0f4ee;
  border-color: rgba(240,244,238,.2);
}
.post-body table td{
  border-color: rgba(240,244,238,.15);
}
.post-body hr{
  border-top-color: rgba(240,244,238,.2);
}

/* 按钮 / tag */
.btn{
  color: #d8e8d4;
  border-color: rgba(184,208,184,.4);
  background: rgba(20,30,25,.3);
}
.btn:hover{
  color: #1c2630;
  background: #d8e8d4;
  border-color: #d8e8d4;
}

/* header/site-meta 适配 */
.subtitle, .site-description{ color: #d8e0d8; }
.site-title, .site-title:hover{
  color: #f0f4ee;
  text-shadow: 1px 1px 2px rgba(0,0,0,.4);
}
.site-author-name, .site-state-item-name{ color: #a8b3a8; }
.site-state-item-count{ color: #f0f4ee; }

/* footer/meta 适配 */
.footer, .footer a{ color: #a8b3a8; }
.links-of-blogroll-title, .links-of-author{ color: #d8e0d8; }

/* 减弱 NexT motion 入场动画的"卡片弹出"感 */
.use-motion .post-block{
  opacity: 1 !important;
  transform: none !important;
}
.use-motion .pagination{ opacity: 1; }

/* ============================================================
   减动效 + 移动端
   ============================================================ */
@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .fog, .fog.b, .rain, .rain.b, .leaf{ animation: none; }
  .g-main > nav.top,
  .g-main > .hero,
  .g-main > .sec,
  .g-main > .tags-wrap,
  .g-main > .about,
  .g-main > footer{ opacity: 1; transform: none; }
}

@media (max-width: 600px){
  .g-main > nav.top ul{ gap: 14px; font-size: 12px; }
  .g-main > nav.top .logo{ font-size: 22px; }
  .post{ grid-template-columns: 40px 1fr; gap: 14px; }
  .post .d{ grid-column: 1/3; font-size: 12px; }
  .g-main > .about{ padding: 24px 20px; }
}
@media (max-width: 768px){
  .bg-photo{ background-attachment: scroll; }
}
