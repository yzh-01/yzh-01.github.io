{% extends '_layout.njk' %}

{% block title %}{{ title }}{% if theme.index_with_subtitle and subtitle %} - {{ subtitle }}{% endif %}{% endblock %}

{% block class %}g-fusion-home{% endblock %}

{# 动态年份，构建时取当前时间 #}
{%- set cy = moment().format('YYYY') -%}
{%- set base = moment(cy + '-01-01') -%}

{# 计算全站数据(用 site.* 全集,不走 page.posts 分页) #}
{%- set wc = 0 -%}
{%- for p in site.posts.toArray() -%}
  {%- set wc = wc + (p.content | striptags).length -%}
{%- endfor -%}

{# 文章级数据(为 featured 大卡挑最长一篇) #}
{%- set featured = null -%}
{%- set _featured_len = 0 -%}
{%- for p in site.posts.toArray() -%}
  {%- set l = (p.content | striptags).length -%}
  {%- if l > _featured_len -%}
    {%- set featured = p -%}
    {%- set _featured_len = l -%}
  {%- endif -%}
{%- endfor -%}

{% block fusion_main %}
{# 进入动画 · 纸翻(单层左翻幕,0.7s) · 仅首次访问;reduce-motion / 后续 reload 由 body-end.njk 立即 remove #}
<div class="page-flip" aria-hidden="true"></div>
<main class="g-main">

  <!-- 1. 顶部导航 · sticky + scroll-spy active -->
  <nav class="top">
    <a class="logo" href="{{ url_for('/') }}">yzh</a>
    <ul>
      <li><a href="#dashboard">数据</a></li>
      <li><a href="#posts">笔记</a></li>
      <li><a href="#tags">标签</a></li>
      <li><a href="#about">关于</a></li>
      <li><a href="/atom.xml">rss</a></li>
    </ul>
  </nav>

  <!-- 2. Hero · 雨止 / 灰茫 / 雪梅 · 三幕入场用 .hero-line-1/2 + .seal-bloom -->
  <section class="hero">
    <span class="eyebrow">a personal journal — since {{ cy }}</span>
    <h1>
      <span class="hero-line-1">雨止</span><br>
      <span class="hero-line-2">灰茫</span><span class="seal seal-bloom" aria-hidden="true">
        <svg viewBox="0 0 42 42" width="42" height="42" class="seal-svg">
          <path d="M 5 37 Q 14 31 22 25 T 38 11" fill="none" stroke="#d4d4cf" stroke-width="1.4" stroke-linecap="round"/>
          <path d="M 16 30 L 12 34" fill="none" stroke="#d4d4cf" stroke-width="1" stroke-linecap="round"/>
          <path d="M 28 20 L 33 16" fill="none" stroke="#d4d4cf" stroke-width="1" stroke-linecap="round"/>
          <g transform="translate(36 11)">
            <g stroke="#d4d4cf" stroke-width="1" fill="rgba(216,232,212,.18)">
              <ellipse cx="0" cy="-4" rx="2.4" ry="3.6"/>
              <ellipse cx="0" cy="-4" rx="2.4" ry="3.6" transform="rotate(72)"/>
              <ellipse cx="0" cy="-4" rx="2.4" ry="3.6" transform="rotate(144)"/>
              <ellipse cx="0" cy="-4" rx="2.4" ry="3.6" transform="rotate(216)"/>
              <ellipse cx="0" cy="-4" rx="2.4" ry="3.6" transform="rotate(288)"/>
            </g>
            <circle r="1" fill="#d4d4cf"/>
          </g>
          <g transform="translate(20 24)">
            <g stroke="#d4d4cf" stroke-width="1" fill="rgba(216,232,212,.15)">
              <ellipse cx="0" cy="-3" rx="1.8" ry="2.7"/>
              <ellipse cx="0" cy="-3" rx="1.8" ry="2.7" transform="rotate(72)"/>
              <ellipse cx="0" cy="-3" rx="1.8" ry="2.7" transform="rotate(144)"/>
              <ellipse cx="0" cy="-3" rx="1.8" ry="2.7" transform="rotate(216)"/>
              <ellipse cx="0" cy="-3" rx="1.8" ry="2.7" transform="rotate(288)"/>
            </g>
            <circle r="0.7" fill="#d4d4cf"/>
          </g>
        </svg>
      </span>
    </h1>
    <div class="stamp">// 眼存灰 · eyes hold grey</div>
    <div class="signature">雨声已远 · 留一纸空山。</div>
    <span class="vertical-tag" aria-hidden="true">雨止灰茫</span>
  </section>

  <!-- 3. 数据看板 · stats + year-progress + heatmap -->
  <section class="dashboard" id="dashboard">
    <div class="label">数据 · dashboard</div>

    <div class="stats-strip">
      <div class="stat-tile" data-target="{{ site.posts.length }}">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 3h12M2 8h12M2 13h8"/></svg>
        </span>
        <span class="num" data-target="{{ site.posts.length }}">0</span>
        <span class="lbl">文章 · posts</span>
      </div>
      <div class="stat-tile" data-target="{{ wc }}">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 3h10M3 8h10M3 13h6"/></svg>
        </span>
        <span class="num" data-target="{{ wc }}">0</span>
        <span class="lbl">字数 · chars</span>
      </div>
      <div class="stat-tile" data-target="{{ site.tags.length }}">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 3l6 5 6-5M2 13l6-5 6 5"/></svg>
        </span>
        <span class="num" data-target="{{ site.tags.length }}">0</span>
        <span class="lbl">标签 · tags</span>
      </div>
      <div class="stat-tile" data-target="{{ site.categories.length }}">
        <span class="ico" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="8" cy="8" r="5.5"/><path d="M2.5 8h11"/></svg>
        </span>
        <span class="num" data-target="{{ site.categories.length }}">0</span>
        <span class="lbl">分类 · cats</span>
      </div>
    </div>

    <div class="year-progress" data-year="{{ cy }}">
      <span class="y-head">2026</span>
      <div class="y-bar"><div class="y-fill"></div></div>
      <span class="y-meta">
        <b class="y-pct">0%</b><span class="y-day">· 第 0 / 365 天</span>
      </span>
    </div>

    {# 热力图 · 53 列 × 7 行 · 365/366 格 · 闰年自适应 #}
    {%- set start_dow = base.format('d') | int -%}
    {%- set days_in_year = base.clone().endOf('year').diff(base, 'days') + 1 -%}
    {%- set all_posts = site.posts.toArray() -%}
    <div class="heatmap" aria-label="2026 年发文热力图">
      <div class="h-head">
        <span class="h-title">{{ cy }} · <b>在每一格里</b></span>
        <span class="h-sub">浅 · 墨 · 深</span>
      </div>
      <div class="h-body">
        <div class="h-grid">
          {%- for pad in range(0, start_dow) -%}
            <span class="h-cell" style="visibility:hidden"></span>
          {%- endfor -%}
          {%- for d in range(0, days_in_year) -%}
            {%- set date_str = base.clone().add(d, 'days').format('YYYY-MM-DD') -%}
            {%- set cnt = 0 -%}
            {%- for p in all_posts -%}
              {%- if p.date.format('YYYY-MM-DD') == date_str -%}
                {%- set cnt = cnt + 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if cnt == 0 -%}
              {%- set lvl = '' -%}
            {%- elif cnt == 1 -%}
              {%- set lvl = 'l1' -%}
            {%- elif cnt == 2 -%}
              {%- set lvl = 'l2' -%}
            {%- else -%}
              {%- set lvl = 'l3' -%}
            {%- endif -%}
            <span class="h-cell {{ lvl }}" data-date="{{ date_str }}" data-count="{{ cnt }}" title="{{ date_str }} · {{ cnt }} 篇"></span>
          {%- endfor -%}
        </div>
      </div>
      <div class="h-legend">
        <span>少</span>
        <span class="swatch"></span>
        <span class="swatch l1"></span>
        <span class="swatch l2"></span>
        <span class="swatch l3"></span>
        <span>多</span>
      </div>
    </div>
  </section>

  <!-- 4. 最近文章 · featured 大卡 + 列表 -->
  <section class="sec" id="posts">
    <div class="label">最近 · recent</div>

    {%- if featured -%}
    {%- set feat_len = (featured.content | striptags).length -%}
    <a class="featured" href="{{ url_for(featured.path) }}">
      <span class="num">no.01</span>
      <span class="body">
        <span class="t">{{ featured.title }}</span>
        <span class="ex">{{ featured.description or '' }}</span>
        <span class="meta-row">
          <span class="mp">{{ feat_len }} 字</span>
          {%- for cat in featured.categories.toArray() -%}
          <span class="mp muted">{{ cat.name }}</span>
          {%- endfor -%}
          <span class="mp muted">{{ featured.date.format('YYYY · MM · DD') }}</span>
        </span>
      </span>
      <span class="badge-feat">featured</span>
    </a>
    {%- endif -%}

    {%- for post in page.posts.toArray() -%}
    {%- if not featured or post.path != featured.path -%}
    <a class="post" href="{{ url_for(post.path) }}">
      <span class="num">no.{% if loop.index < 10 %}0{{ loop.index }}{% else %}{{ loop.index }}{% endif %}</span>
      <span class="body">
        <span class="t">{{ post.title }}</span>
        <span class="ex">{{ post.description or '' }}</span>
      </span>
      <span class="d">{{ post.date.format('MM · DD') }}</span>
    </a>
    {%- endif -%}
    {%- endfor %}
  </section>

  <!-- 5. 标签墙 · 胶囊 + 内嵌比例条 -->
  <section class="tag-board" id="tags">
    <div class="label">标签 · tags</div>
    {%- set tag_max = 0 -%}
    {%- for t in site.tags.toArray() -%}
      {%- if t.posts.length > tag_max -%}
        {%- set tag_max = t.posts.length -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set tag_arr = [] -%}
    {%- for t in site.tags.toArray() -%}
      {%- set _ = tag_arr.push({name: t.name, path: t.path, cnt: t.posts.length}) -%}
    {%- endfor -%}
    <div class="tag-list">
      {%- for t in tag_arr -%}
      <a class="tag-pill" href="{{ url_for(t.path) }}">
        <span class="name">{{ t.name }}</span>
        <span class="bar"><span class="fill" style="width:{% if tag_max > 0 %}{{ (t.cnt / tag_max * 100) | round(0, 'floor') }}{% else %}0{% endif %}%"></span></span>
        <span class="cnt">{{ t.cnt }}</span>
      </a>
      {%- endfor -%}
    </div>
  </section>

  <!-- 6. 关于（带 GitHub 头像 + 关注按钮） -->
  <section class="about" id="about">
    <div class="about-card">
      <a class="avatar" href="https://github.com/yzh-01" target="_blank" rel="noopener">
        <img src="https://github.com/yzh-01.png?size=160" alt="yzh-01" loading="lazy" />
      </a>
      <div class="about-text">
        <h3>关于此处</h3>
        <p>一个普通的博客。写代码，也写点别的。慢一点，没有关系。</p>
        <p>这里记录：技术学习、生活随笔、读完的书、做过的梦。</p>
        <div class="links">
          <a class="link-btn gh" href="https://github.com/yzh-01" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.74.11 3.03.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/></svg>
            <span>github</span>
          </a>
          <a class="link-btn follow" href="https://github.com/yzh-01" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/></svg>
            <span>follow</span>
          </a>
          <a class="link-btn" href="mailto:107386162@qq.com">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 7l2-2h14l2 2"/></svg>
            <span>email</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Footer -->
  <footer id="rss">
    <div class="l">
      <a href="/atom.xml">rss</a>
      <a href="https://github.com/yzh-01">github</a>
      <a href="/sitemap.xml">sitemap</a>
    </div>
    <div class="r">© {{ cy }} · made in rain</div>
  </footer>

  <!-- 8. 侧栏 · 4 个 widget:搜索 / 最近更新 / 标签云 / 友链 -->
  <aside class="g-side">
    <div class="g-search">
      <input id="g-search-input" type="search" placeholder="搜索笔记…" autocomplete="off" />
      <ul class="g-search-results" id="g-search-results" hidden></ul>
    </div>

    <div class="g-recent">
      <div class="label">最近更新</div>
      {%- for p in site.posts.toArray().slice(0, 5) -%}
      <a class="g-recent-item" href="{{ url_for(p.path) }}">
        <span class="t">{{ p.title }}</span>
        <span class="d">{{ p.date.format('MM · DD') }}</span>
      </a>
      {%- endfor -%}
    </div>

    <div class="g-tagcloud">
      <div class="label">标签</div>
      {%- set _tag_max_cnt = 1 -%}
      {%- for tt in site.tags.toArray() -%}
        {%- if tt.posts.length > _tag_max_cnt -%}{%- set _tag_max_cnt = tt.posts.length -%}{%- endif -%}
      {%- endfor -%}
      <div class="chips">
        {%- for t in site.tags.toArray() -%}
          {%- if _tag_max_cnt > 1 -%}
            {%- set _size = (12 + (26 - 12) * (t.posts.length - 1) / (_tag_max_cnt - 1)) | round(0) -%}
          {%- else -%}
            {%- set _size = 12 -%}
          {%- endif -%}
          <a class="chip" href="{{ url_for(t.path) }}" style="font-size:{{ _size }}px">{{ t.name }}<span class="cnt">{{ t.posts.length }}</span></a>
        {%- endfor -%}
      </div>
    </div>

    {%- if site.data.friends -%}
    <div class="g-friends">
      <div class="label">友链</div>
      {%- for f in site.data.friends -%}
      <a class="g-friend" href="{{ f.url }}" target="_blank" rel="noopener">
        <span class="n">{{ f.name }}</span>
        {%- if f.desc %}<span class="d">{{ f.desc }}</span>{%- endif -%}
      </a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </aside>

  {# 搜索索引 · build 时由 site.posts 渲染,客户端 JS 过滤 #}
  <ul id="g-search-index" hidden>
    {%- for p in site.posts.toArray() -%}
    <li data-href="{{ url_for(p.path) }}"
        data-title="{{ p.title | lower }}"
        data-tags="{% for t in p.tags %}{{ t.name | lower }} {% endfor %}"
        data-desc="{{ (p.description or '') | lower }}">{{ p.title }}</li>
    {%- endfor -%}
  </ul>

</main>
{% endblock %}