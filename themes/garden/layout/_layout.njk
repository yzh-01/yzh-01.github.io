<!DOCTYPE html>
<html lang="zh-CN">
<head>
  {{ partial('_partial/head.njk') }}
  {% block head_extra %}{% endblock %}
</head>
<body class="{% if is_home() %}is-home{% else %}is-inner{% endif %}{% if is_post() %} is-post{% endif %}{% if is_archive() or is_tag() or is_category() %} is-archive{% endif %}{% if page.layout %} layout-{{ page.layout }}{% endif %}">
  <a class="skip-link" href="#main-content">跳到正文</a>
  <div class="site-backdrop" aria-hidden="true"></div>
  {%- if not is_home() %}
  <div class="inner-atmosphere" aria-hidden="true">
    <i></i>
  </div>
  <aside class="inner-page-readout" aria-hidden="true"><span>SYS.PAGE_FIELD</span><b>{{ page.layout or 'INDEX' }}</b><i>SCROLL // ACTIVE</i></aside>
  {%- endif %}
  {{ partial('_partial/nav.njk') }}

  <main id="main-content">
    {% block content %}{% endblock %}
  </main>

  {{ partial('_partial/footer.njk') }}

  <div class="garden-controls" data-garden-controls>
    <section class="garden-settings" id="garden-settings" aria-labelledby="garden-settings-title" hidden>
      <p class="garden-settings-kicker">GARDEN SETTINGS</p>
      <h2 id="garden-settings-title">阅读外观</h2>
      <p class="garden-settings-copy">选择此刻更舒服的光线。</p>
      <div class="garden-theme-options" role="group" aria-label="颜色模式">
        <button type="button" data-theme-choice="system" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          <span>跟随系统</span>
        </button>
        <button type="button" data-theme-choice="light" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
          <span>浅色</span>
        </button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z"/></svg>
          <span>深色</span>
        </button>
      </div>
      <p class="garden-theme-status" data-theme-status aria-live="polite"></p>
      <div class="garden-performance-settings">
        <p class="garden-settings-copy" id="garden-performance-label">动效性能</p>
        <div class="garden-theme-options garden-performance-options" role="group" aria-labelledby="garden-performance-label">
          <button type="button" data-performance-choice="auto" aria-pressed="true"><span>自动</span></button>
          <button type="button" data-performance-choice="full" aria-pressed="false"><span>完整</span></button>
          <button type="button" data-performance-choice="economy" aria-pressed="false"><span>节能</span></button>
        </div>
        <p class="garden-theme-status" data-performance-status aria-live="polite">自动平衡背景动效与交互性能。</p>
      </div>
    </section>
    <div class="garden-control-actions">
      {%- if is_post() and theme.post.back_to_top %}
      <button class="article-back-top garden-control-button" type="button" aria-label="回到文章顶部">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6"/></svg>
      </button>
      {%- endif %}
      <a class="garden-home-button garden-control-button" href="{% if is_home() %}#hello{% else %}{{ url_for('/') }}#hello{% endif %}" aria-label="返回首页介绍区">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10M9 20v-6h6v6"/></svg>
      </a>
      <button class="garden-settings-toggle garden-control-button" type="button" aria-label="打开花园设置" aria-expanded="false" aria-controls="garden-settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.12.38.33.72.6 1 .3.28.68.42 1.1.4H21v4h-.09A1.7 1.7 0 0 0 19.4 15Z"/></svg>
      </button>
    </div>
  </div>

  <script src="{{ url_for('js/motion.js') }}?v={{ theme.asset_version }}" defer></script>
  <script src="{{ url_for('js/site.js') }}?v={{ theme.asset_version }}" defer></script>
  {% block scripts %}{% endblock %}
</body>
</html>
