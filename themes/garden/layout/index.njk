{% extends '_layout.njk' %}

{# ===== 构建时数据预计算（一次遍历全站）===== #}
{%- set all_posts = site.posts.toArray() -%}
{%- set wc = 0 -%}
{%- for p in all_posts -%}
  {%- set wc = wc + (p.content | striptags).length -%}
{%- endfor -%}

{%- set cy = moment().format('YYYY') -%}

{# Unique years sorted desc #}
{%- set year_list = [] -%}
{%- set prev = '' -%}
{%- for p in all_posts | reverse -%}
  {%- set y = p.date.format('YYYY') -%}
  {%- if y != prev -%}
    {%- set prev = y -%}
    {%- set _ = year_list.push(y) -%}
  {%- endif -%}
{%- endfor -%}
{%- set year_list = year_list | reverse -%}

{# Featured posts: front matter 里 featured: true 的 #}
{%- set featured_posts = [] -%}
{%- for p in all_posts -%}
  {%- if p.featured -%}
    {%- set _ = featured_posts.push(p) -%}
  {%- endif -%}
{%- endfor -%}
{# Life posts: tagged 生活 / 随笔 / 读书 #}
{%- set life_tags = ['生活','随笔','读书','life','essay','reading'] -%}
{%- set life_posts = [] -%}
{%- for p in all_posts -%}
  {%- for t in p.tags.toArray() -%}
    {%- if life_tags.includes(t.name) -%}
      {%- set already = false -%}
      {%- for lp in life_posts -%}
        {%- if lp.path == p.path -%}{%- set already = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if not already -%}{%- set _ = life_posts.push(p) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set life_posts = life_posts.slice(0, 4) -%}

{% block content %}
<div class="g-wide">

  <nav class="garden-route" aria-label="首页花园路径">
    <span class="garden-route-track" aria-hidden="true"><i></i></span>
    <a href="#garden-intro" data-route-link><span>序章</span></a>
    {%- if theme.modules.hero %}<a href="#garden-home" data-route-link><span>生长</span></a>{%- endif %}
    <a href="#garden-map" data-route-link><span>地形</span></a>
    {%- if theme.modules.life and life_posts.length %}<a href="#life" data-route-link><span>侧枝</span></a>{%- endif %}
    {%- if theme.modules.about %}<a href="#garden-about" data-route-link><span>关于</span></a>{%- endif %}
  </nav>

  {# ===== 1. Personal Hero ===== #}
  {%- if theme.modules.hero %}
  <section class="hero" id="garden-home">
    <div class="hero-fireflies" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    <div class="hero-copy">
      <p class="hero-eyebrow"><span aria-hidden="true"></span>个人数字花园 · 持续生长中</p>
      <h1>HELLO，我是 <span class="hero-name">{{ config.author }}。</span></h1>
      <p class="hero-thesis">在代码、学习与生活之间，<em>持续记录。</em></p>
      <p class="tagline">这里整理技术实践、学习中的疑问，也留下普通日子的碎片。</p>
      <div class="hero-actions">
        <a class="hero-action primary" href="#latest-posts">阅读最近文章 <span aria-hidden="true">↓</span></a>
        <a class="hero-action" href="{{ url_for('about/') }}">关于我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="hero-identity" aria-label="关于这个数字花园">
      <div class="hero-companion">
        <img class="hero-companion-light" src="{{ url_for('images/garden-light-avatar.jpg') }}" width="736" height="736" alt="一只探出头的白猫" decoding="async">
        <img class="hero-companion-dark" src="{{ url_for('images/garden-companion.jpg') }}" width="720" height="720" alt="一只坐在林间苔藓上的黑猫" decoding="async">
      </div>
      <p class="hero-hand">雨止灰茫</p>
      <p class="hero-motto">在不确定里，积累一点确定。</p>
      <dl class="hero-stats">
        <div>
          <dt>记录</dt>
          <dd>{{ all_posts.length }}<small>篇</small></dd>
        </div>
        <div>
          <dt>文字</dt>
          <dd>{{ wc }}<small>字</small></dd>
        </div>
        <div>
          <dt>生长</dt>
          <dd>{{ year_list.length }}<small>年</small></dd>
        </div>
      </dl>
      <p class="hero-since">// since {{ theme.since or cy }}</p>
    </aside>
    <div class="hero-trace" aria-hidden="true"></div>
  </section>
  {%- endif %}

  {# ===== 2. Latest Posts ===== #}
  {%- if theme.modules.latest_posts %}
  <section class="posts-sec" id="latest-posts" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">recent posts</h2>
      <a href="{{ url_for('archives/') }}">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    {%- for post in page.posts.toArray().slice(0, 6) -%}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <h3 class="post-card-title">{{ post.title }}</h3>
      <div class="post-card-meta">
        <time>{{ post.date.format('YYYY-MM-DD') }}</time>
        {%- for tag in post.tags.toArray().slice(0, 2) -%}
        <span>{{ tag.name }}</span>
        {%- endfor -%}
        <span>{{ (post.content | striptags).length }} 字</span>
      </div>
      {%- if post.description -%}
      <div class="post-card-desc">{{ post.description }}</div>
      {%- endif -%}
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 3. Now ===== #}
  {%- if theme.modules.now and site.data.now and site.data.now.items and site.data.now.items.length %}
  <section class="now-sec" id="now" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">now</h2>
      {%- if site.data.now.updated %}<span class="section-freshness">更新于 {{ site.data.now.updated }}</span>{%- endif %}
    </div>
    <div class="now-grid">
      {%- for item in site.data.now.items -%}
      <div class="now-card" data-spotlight>
        <span class="now-signal" aria-hidden="true"></span>
        <h3>{{ item.label }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 4. Garden Map ===== #}
  <section class="garden-map" id="garden-map" data-reveal aria-labelledby="garden-map-title">
    <div class="g-sec-heading">
      <h2 class="g-sec-label" id="garden-map-title">knowledge terrain</h2>
      <span class="garden-map-note">按兴趣走进这座花园</span>
    </div>
    <div class="garden-map-grid">
      <a class="garden-map-card" href="{{ url_for('categories/study-notes/') }}" data-spotlight>
        <span class="garden-map-index">CODE</span>
        <h3>技术探索</h3>
        <p>代码实践、课程知识与工具使用，记录从理解到动手的过程。</p>
        <span class="garden-map-link">进入技术区 <b aria-hidden="true">→</b></span>
      </a>
      <a class="garden-map-card" href="{{ url_for('tags/notes/') }}" data-spotlight>
        <span class="garden-map-index">NOTES</span>
        <h3>学习记录</h3>
        <p>尚未成熟的想法、复习笔记和问题清单，允许内容持续修订。</p>
        <span class="garden-map-link">浏览学习笔记 <b aria-hidden="true">→</b></span>
      </a>
      <a class="garden-map-card" href="{{ url_for('categories/diary/') }}" data-spotlight>
        <span class="garden-map-index">LIFE</span>
        <h3>日常生活</h3>
        <p>书、音乐、情绪和普通日子，让技术之外的生活也被看见。</p>
        <span class="garden-map-link">看看生活碎片 <b aria-hidden="true">→</b></span>
      </a>
    </div>
  </section>

  {# ===== 5. Long-lived notes ===== #}
  {%- if theme.modules.featured_notes and featured_posts.length %}
  <section class="featured-sec" id="featured" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">long-lived notes</h2>
      <span class="section-freshness">持续修订的内容</span>
    </div>
    {%- for fp in featured_posts.slice(0, 2) -%}
    <a class="featured-card" href="{{ url_for(fp.path) }}" data-spotlight{% if loop.index > 1 %} style="margin-top:14px"{% endif %}>
      <div>
        <h3>{{ fp.title }}</h3>
        {%- if fp.description -%}
        <div class="desc">{{ fp.description }}</div>
        {%- endif -%}
        <div class="meta">
          <span>{{ (fp.content | striptags).length }} 字</span>
          <span>整理于 {{ (fp.updated if fp.updated else fp.date).format('YYYY-MM-DD') }}</span>
        </div>
      </div>
      <span class="badge">evergreen</span>
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 6. Current workbench ===== #}
  {%- if theme.modules.workbench and site.data.stack and site.data.stack.length %}
  <section class="stack-sec" id="stack" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">current workbench</h2>
      <span class="section-freshness">不是技能清单，是此刻真正使用的工具</span>
    </div>
    <div class="stack-groups">
      {%- for g in site.data.stack -%}
      <div class="stack-group">
        <h3>{{ g.group }}</h3>
        <div class="tags">
          {%- for item in g.items -%}
          <span class="stack-tag">
            <strong>{{ item.name or item }}</strong>
            {%- if item.note %}<small>{{ item.note }}</small>{%- endif %}
          </span>
          {%- endfor -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 7. Garden Log ===== #}
  {%- if theme.modules.garden_log and site.data['garden-log'] and site.data['garden-log'].length %}
  {%- set latest_log = site.data['garden-log'][0] %}
  <section class="garden-update-sec" id="garden-log" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">garden log</h2>
      <a href="{{ url_for('garden-log/') }}">查看生长日志 <span aria-hidden="true">→</span></a>
    </div>
    <a class="garden-update-card" href="{{ url_for('garden-log/#' + latest_log.month) }}">
      <time datetime="{{ latest_log.month }}">{{ latest_log.label }}</time>
      <div>
        <h3>{{ latest_log.title }}</h3>
        <p>{{ latest_log.summary }}</p>
      </div>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
  {%- endif %}

  {# ===== 8. Life ===== #}
  {%- if theme.modules.life and life_posts.length %}
  <section class="life-sec" id="life" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">life</h2>
      <a href="{{ url_for('categories/diary/') }}">更多生活记录 <span aria-hidden="true">→</span></a>
    </div>
    <div class="life-notes-grid">
      {%- for post in life_posts -%}
      <a class="life-note{% if loop.first %} life-note-featured{% endif %}" href="{{ url_for(post.path) }}">
        {%- if loop.first %}
        <span class="life-note-media" aria-hidden="true">
          <img class="life-note-media-light" src="{{ url_for('images/garden-light-cat.jpg') }}" width="735" height="525" alt="" loading="lazy" decoding="async">
          <img class="life-note-media-dark" src="{{ url_for('images/garden-companion.jpg') }}" width="720" height="720" alt="" loading="lazy" decoding="async">
        </span>
        {%- endif %}
        <span class="life-note-copy">
          <span class="life-note-kicker"><time>{{ post.date.format('YYYY-MM-DD') }}</time> · life note</span>
          <strong>{{ post.title }}</strong>
          {%- if post.description %}<span class="life-note-desc">{{ post.description }}</span>{%- endif %}
          <span class="life-note-link">走进这一天 <b aria-hidden="true">→</b></span>
        </span>
      </a>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {# ===== 9. About ===== #}
  {%- if theme.modules.about %}
  <section class="about-sec" id="garden-about" data-reveal>
    <figure class="about-photo">
      <img src="{{ url_for('images/garden-night-window.jpg') }}" width="735" height="551" alt="夜色中透过玻璃窗看见的植物与灯光" loading="lazy" decoding="async">
      <figcaption>窗内写字，窗外生长。</figcaption>
    </figure>
    <div class="about-summary">
      <h2>关于这个花园</h2>
      <p>这里是一块长期维护的个人数字空间。</p>
      <p>代码、学习与生活并排生长。</p>
      <p class="about-signature"><span>{{ config.author }}</span> · 学习者、实践者、长期记录者</p>
      <div class="links">
        <a class="link-btn primary" href="{{ url_for('about/') }}">继续了解 <span aria-hidden="true">→</span></a>
        <a class="link-btn" href="https://github.com/yzh-01" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  {%- endif %}

</div>
{% endblock %}
