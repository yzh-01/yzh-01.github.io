{% extends '_layout.njk' %}

{% block head_extra %}
<link rel="stylesheet" href="{{ url_for('css/home.css') }}?v={{ theme.asset_version }}">
{% endblock %}

{%- set all_posts = site.posts.toArray() -%}
{%- set latest_posts = page.posts.toArray().slice(0, 3) -%}

{% block content %}
<div class="folio">
  <div class="folio-world" aria-hidden="true">
    <svg class="folio-world-etchings" viewBox="0 0 1600 1000" preserveAspectRatio="none">
      <g class="folio-etching-fibres" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M148-90C172 66 112 162 153 277s-12 202 25 315-19 215 7 312 8 141-11 198"/>
        <path d="M397-72C350 85 426 177 382 311s46 207 9 318 28 178-4 284 11 141 31 190"/>
        <path d="M744-108C702 57 788 160 736 272s31 185-8 289 44 203-2 318 9 167 48 230"/>
        <path d="M1031-64C1084 72 986 190 1049 307s-35 214 21 326-39 206 16 317 24 124 4 178"/>
        <path d="M1386-86C1320 86 1417 179 1362 324s47 205-12 326 35 189-17 305 1 134 22 176"/>
      </g>
      <g class="folio-etching-branches" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M153 277l96-55 77 18m56 71-87 70-54-4m495-105-110-56-76 21m499 70 104-67 78 15m131 69-92 74-58-8M391 629l118 65 66-20m511-41-124 73-79-19m-698 217 88-53 64 11m1050 93-91-62-73 17"/>
        <path d="M95 112l39 24m284 17-43 28m387-46-36 31m330 8-50 32m386-61-35 34M130 506l41 15m238 260-38 24m383-36 43 18m253 117-37 27m402-258 46 23"/>
      </g>
      <g class="folio-etching-spores" fill="currentColor" stroke="none">
        <circle cx="249" cy="222" r="2"/><circle cx="550" cy="237" r="1.5"/><circle cx="1153" cy="240" r="2"/>
        <circle cx="509" cy="694" r="2"/><circle cx="962" cy="706" r="1.5"/><circle cx="1296" cy="893" r="2"/>
      </g>
    </svg>
    <canvas class="folio-kinetic-veil" data-kinetic-veil aria-hidden="true"></canvas>
    <div class="folio-rainfield">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
  </div>
  <section class="garden-boot" data-garden-boot aria-label="WINTEROMEN 冬兆显影" hidden>
    <div class="garden-boot-field" aria-hidden="true">
      <img class="garden-boot-photo garden-boot-photo-light" src="{{ url_for('images/garden-bg-light-cat.jpg') }}" width="1600" height="900" alt="">
      <img class="garden-boot-photo garden-boot-photo-dark" src="{{ url_for('images/garden-bg-dark-cat.jpg') }}" width="1600" height="900" alt="">
      <span class="garden-boot-fog garden-boot-fog-a"></span>
      <span class="garden-boot-fog garden-boot-fog-b"></span>
      <span class="garden-boot-snow">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </div>

    <div class="garden-boot-omen">
      <p class="garden-boot-eyebrow" aria-live="polite">
        <span><i></i> WINTER SIGNAL / 00</span>
        <b data-boot-status>雾层校准</b>
      </p>

      <div class="garden-boot-sight" aria-hidden="true">
        <i></i><b></b><span>44.1°N</span>
      </div>

      <h2 class="garden-boot-title" aria-label="WINTEROMEN">
        <span class="garden-boot-title-base" aria-hidden="true">WINTEROMEN</span>
        <span class="garden-boot-title-cut garden-boot-title-cut-a" aria-hidden="true">WINTEROMEN</span>
        <span class="garden-boot-title-cut garden-boot-title-cut-b" aria-hidden="true">WINTEROMEN</span>
        <span class="garden-boot-title-cut garden-boot-title-cut-c" aria-hidden="true">WINTEROMEN</span>
      </h2>

      <div class="garden-boot-readout">
        <span aria-hidden="true">VISIBILITY / <i data-boot-progress>00</i></span>
        <strong aria-hidden="true">LOW CLOUD</strong>
      </div>
      <div class="garden-boot-bar" aria-hidden="true"><i data-boot-bar></i></div>
      <div class="garden-boot-actions">
        <button type="button" data-boot-enter>进入 <span>↗</span></button>
        <button type="button" data-motion-lite>安静模式</button>
      </div>
    </div>

    <div class="garden-boot-shutter garden-boot-shutter-top" aria-hidden="true"></div>
    <div class="garden-boot-shutter garden-boot-shutter-bottom" aria-hidden="true"></div>
  </section>

  <div class="garden-atmosphere" aria-hidden="true">
    <canvas class="garden-particles" data-garden-particles></canvas>
    <div class="garden-scanlines"></div>
    <div class="garden-noise"></div>
  </div>

  <aside class="garden-hud" aria-hidden="true">
    <div class="garden-hud-system"><b>SYS.ON</b><span>GARDEN.NODE / {{ all_posts.length }} NOTES</span></div>
    <div class="garden-hud-vitals"><span>CPU <i data-hud-cpu>07</i>%</span><span>MEM <i data-hud-mem>24</i>%</span></div>
    <div class="garden-hud-scroll"><b data-hud-percent>000</b><span><i data-hud-progress></i></span><small>SCROLL</small></div>
    <i class="garden-corner garden-corner-a"></i><i class="garden-corner garden-corner-b"></i>
    <i class="garden-corner garden-corner-c"></i><i class="garden-corner garden-corner-d"></i>
  </aside>

  <div class="garden-ripple-layer" data-ripple-layer aria-hidden="true"></div>

  <div class="garden-pet" data-garden-pet data-post-count="{{ all_posts.length }}">
    <p data-pet-bubble aria-live="polite">嘘，花园刚刚醒。</p>
    <button type="button" data-pet-button aria-label="和花园里的猫打个招呼">
      <img class="garden-pet-light" src="{{ url_for('images/garden-light-avatar.jpg') }}" width="160" height="160" alt="">
      <img class="garden-pet-dark" src="{{ url_for('images/garden-companion.jpg') }}" width="160" height="160" alt="">
      <span aria-hidden="true">摸一下</span>
    </button>
  </div>

  <div class="garden-overgrowth" data-garden-overgrowth aria-hidden="true" tabindex="-1">
    <canvas class="garden-overgrowth-field" data-overgrowth-field aria-hidden="true"></canvas>
    <div class="garden-overgrowth-veil" aria-hidden="true"></div>
    <div class="garden-game-controls" data-game-controls aria-label="游戏控制">
      <button type="button" data-game-up aria-label="向上移动">↑</button>
      <button type="button" data-game-left aria-label="向左移动">←</button>
      <button type="button" data-game-shot aria-label="发射冷光弹">✦</button>
      <button type="button" data-game-right aria-label="向右移动">→</button>
      <button type="button" data-game-down aria-label="向下移动">↓</button>
    </div>
    <div class="garden-relic-panel" data-relic-panel aria-live="polite" hidden>
      <small data-relic-state>SIGNAL OPTION</small>
      <strong data-relic-name>选择强化</strong>
      <span data-relic-effect>指向一个符号查看效果</span>
      <b data-relic-confirm>左键 / ✦ 确认</b>
      <em data-relic-owned></em>
    </div>
    <div class="garden-overgrowth-copy" role="status" aria-live="polite">
      <small data-overgrowth-status>LOW TIDE // PROCEDURAL RUN</small>
      <span data-overgrowth-hint>地图会在每次重开时重新组合。WASD 移动，鼠标瞄准，左键发射冷光弹。</span>
      <button type="button" data-overgrowth-close>退出关卡 <b aria-hidden="true">×</b></button>
    </div>
  </div>

  <section class="folio-cover" id="hello" data-home-window aria-labelledby="folio-title">
    <div class="folio-cover-photo" aria-hidden="true">
      <img class="folio-photo-light" src="{{ url_for('images/garden-bg-light-cat.jpg') }}" width="1600" height="900" alt="">
      <img class="folio-photo-dark" src="{{ url_for('images/garden-bg-dark-cat.jpg') }}" width="1600" height="900" alt="">
      <span class="folio-cover-lens" data-home-lens>
        <img class="folio-photo-light" src="{{ url_for('images/garden-bg-light-cat.jpg') }}" width="1600" height="900" alt="">
        <img class="folio-photo-dark" src="{{ url_for('images/garden-bg-dark-cat.jpg') }}" width="1600" height="900" alt="">
      </span>
    </div>
    <div class="folio-cover-shade" aria-hidden="true"></div>

    <div class="folio-masthead">
      <a href="{{ url_for('/') }}" data-scramble><i aria-hidden="true"></i>SYS.ONLINE</a>
      <span>USER: {{ config.author }}.DEV</span>
      <time data-home-clock data-clock-prefix="T: ">T: --:--</time>
    </div>

    <h1 class="folio-wordmark" id="folio-title" data-winter-wordmark aria-label="WINTEROMEN — ZIHY 的个人数字花园">
      <span class="folio-wordmark-layer folio-wordmark-ghost" aria-hidden="true">
        <span class="folio-wordmark-run">WINTER</span><span class="folio-wordmark-eclipse"><span>O</span></span><span class="folio-wordmark-run">MEN</span>
      </span>
      <span class="folio-wordmark-layer folio-wordmark-main" aria-hidden="true">
        <span class="folio-wordmark-run">WINTER</span><span class="folio-wordmark-eclipse">
          <span class="folio-wordmark-disc"><b></b></span>
          <i class="folio-wordmark-ray folio-wordmark-ray-left"></i>
          <i class="folio-wordmark-ray folio-wordmark-ray-right"></i>
        </span><span class="folio-wordmark-run">MEN</span>
      </span>
      <span class="folio-wordmark-chip folio-wordmark-chip-a" aria-hidden="true">WINTEROMEN</span>
      <span class="folio-wordmark-chip folio-wordmark-chip-b" aria-hidden="true">WINTEROMEN</span>
    </h1>
    <div class="folio-ninefold" data-ninefold>
      <div class="folio-oath-seal" aria-hidden="true">
        <svg viewBox="0 0 240 240">
          <circle class="folio-oath-ring folio-oath-ring-outer" cx="120" cy="120" r="103"/>
          <circle class="folio-oath-ring folio-oath-ring-mid" cx="120" cy="120" r="85"/>
          <circle class="folio-oath-ring folio-oath-ring-inner" cx="120" cy="120" r="58"/>
          <g class="folio-oath-runes" fill="none" stroke="currentColor" stroke-linecap="square">
            <path d="M120 15v18m0-14h9m-9 7h7"/>
            <path d="M183 34v16l6 5 6-5V34"/>
            <path d="M220 91v18m0-14 9 5-9 5"/>
            <path d="M220 167l7-18 7 18m-11-7h8"/>
            <path d="M183 206v-18m0 0 10 5-10 5m5-1 8 9"/>
            <path d="M120 225v-18m0 9 10-9m-10 9 10 9"/>
            <path d="M50 211l13-13m0 13-13-13"/>
            <path d="M18 167l5-16 5 16 5-16 5 16"/>
            <path d="M20 91v18m0-9 9-9m-9 9 9 9"/>
            <path d="M57 34l13 16m0-16L57 50"/>
          </g>
          <g class="folio-valknut" fill="none" stroke="currentColor">
            <path d="M120 69l42 72H78z"/>
            <path d="M95 84l83 2-43 70z"/>
            <path d="M145 84l-83 2 43 70z"/>
          </g>
          <g class="folio-nine-realms" fill="currentColor">
            <circle style="--realm:0" cx="120" cy="17" r="2.6"/>
            <circle style="--realm:1" cx="186" cy="41" r="2.6"/>
            <circle style="--realm:2" cx="222" cy="101" r="2.6"/>
            <circle style="--realm:3" cx="210" cy="170" r="2.6"/>
            <circle style="--realm:4" cx="155" cy="216" r="2.6"/>
            <circle style="--realm:5" cx="85" cy="216" r="2.6"/>
            <circle style="--realm:6" cx="30" cy="170" r="2.6"/>
            <circle style="--realm:7" cx="18" cy="101" r="2.6"/>
            <circle style="--realm:8" cx="54" cy="41" r="2.6"/>
          </g>
        </svg>
      </div>
      <div class="folio-realm-stones">
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Jotunheim，巨人之境，边界之外的混沌与巨力" style="--stone:0;--x:-450px;--y:-112px;--mx:-238px;--my:-188px;--rot:-19deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M8 3L35 0l10 12-4 42-12 10L5 58 1 18z"/><path class="folio-stone-face" d="M9 8l22-3 8 10-4 34-9 8-16-4-4-32z"/><path class="folio-realm-mark" d="M10 48l12-27 6 13 5-9 7 23M17 37h16"/></svg><span><b>JOTUNHEIM</b><small>巨人之境</small><em>边界之外的混沌与巨力</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Asgard，阿萨神族之域，秩序、誓约与神族议庭" style="--stone:1;--x:-250px;--y:-172px;--mx:-160px;--my:-232px;--rot:12deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M6 7L29 1l15 9 2 37-13 17-26-5L1 22z"/><path class="folio-stone-face" d="M9 11l19-5 11 8 1 31-10 12-18-3-5-30z"/><path class="folio-realm-mark" d="M12 49V28l12-11 12 11v21M17 30h14M24 17v32"/></svg><span><b>ASGARD</b><small>阿萨神族</small><em>秩序、誓约与神族议庭</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Alfheim，光明精灵之域，光与灵性的隐居之所" style="--stone:2;--x:0px;--y:-198px;--mx:-28px;--my:-252px;--rot:-7deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M11 2l25 3 9 16-7 38-20 6L3 52 1 15z"/><path class="folio-stone-face" d="M13 8l19 2 7 13-6 31-13 5L9 49 7 18z"/><path class="folio-realm-mark" d="M24 15v34M9 32h30m-25-13 20 26m0-26L14 45"/></svg><span><b>ALFHEIM</b><small>光明精灵</small><em>光与灵性的隐居之所</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Vanaheim，华纳神族之域，丰饶、海潮与古老魔法" style="--stone:3;--x:245px;--y:-166px;--mx:150px;--my:-231px;--rot:16deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M4 10L22 1l21 7 4 39-15 17-24-7L1 26z"/><path class="folio-stone-face" d="M9 13l15-7 14 6 3 32-11 13-17-5-6-25z"/><path class="folio-realm-mark" d="M24 50V28m0 4c-8-1-12-6-13-13 8 0 12 5 13 13zm0 4c8-1 12-6 13-13-8 0-12 5-13 13z"/></svg><span><b>VANAHEIM</b><small>华纳神族</small><em>丰饶、海潮与古老魔法</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Muspelheim，火焰之境，原初烈焰与毁灭力量" style="--stone:4;--x:455px;--y:-102px;--mx:250px;--my:-185px;--rot:-14deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M10 1l26 5 10 18-8 37-25 3L2 49 4 13z"/><path class="folio-stone-face" d="M13 7l19 4 8 14-7 30-17 2-8-11 2-30z"/><path class="folio-realm-mark" d="M25 51c-10-3-14-11-8-20l7-12c1 8 8 10 8 18 4-3 5-6 5-10 7 12 2 22-12 24z"/></svg><span><b>MUSPELHEIM</b><small>火焰之境</small><em>原初烈焰与毁灭力量</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Niflheim，冰与雾之境，静止、冰雾与无尽深寒" style="--stone:5;--x:-350px;--y:150px;--mx:-235px;--my:205px;--rot:18deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M5 5l28-3 13 15-5 42-23 6L2 50 1 18z"/><path class="folio-stone-face" d="M10 10l20-2 10 12-4 34-16 4L8 47 7 21z"/><path class="folio-realm-mark" d="M24 16v34M10 24l28 18M38 24 10 42M18 20l6 6 6-6M18 46l6-6 6 6"/></svg><span><b>NIFLHEIM</b><small>冰雾之境</small><em>静止、冰雾与无尽深寒</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Nidavellir，矮人之境，锻造、技艺与地底火光" style="--stone:6;--x:-118px;--y:184px;--mx:-75px;--my:236px;--rot:-11deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M12 1l24 7 10 21-11 34-24-2L2 43 5 12z"/><path class="folio-stone-face" d="M14 7l18 6 8 17-9 27-16-2-7-14 3-26z"/><path class="folio-realm-mark" d="M12 20h24v9H12zM24 29v22m-7 0h14"/></svg><span><b>NIDAVELLIR</b><small>矮人之境</small><em>锻造、技艺与地底火光</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Midgard，人类居住的中庭，被守护的日常世界" style="--stone:7;--x:145px;--y:174px;--mx:88px;--my:231px;--rot:9deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M7 4l25-2 14 18-6 38-20 7L3 51 1 17z"/><path class="folio-stone-face" d="M11 9l18-2 11 15-5 31-13 5L9 48 7 20z"/><path class="folio-realm-mark" d="M24 16c10 0 17 7 17 17s-7 17-17 17S7 43 7 33s7-17 17-17zm-9 24 9-10 9 10M24 30v16"/></svg><span><b>MIDGARD</b><small>人类中庭</small><em>被守护的日常世界</em></span></button>
        <button type="button" class="folio-realm-stone" tabindex="-1" aria-pressed="false" aria-label="Hel，亡者之境，衰亡、归返与地下之根" style="--stone:8;--x:370px;--y:136px;--mx:245px;--my:202px;--rot:-17deg"><svg viewBox="0 0 48 66"><path class="folio-stone-body" d="M9 2l29 7 8 22-12 33-25-7L1 37 3 12z"/><path class="folio-stone-face" d="M12 8l21 6 7 17-9 27-17-5-7-17 2-21z"/><path class="folio-realm-mark" d="M24 15v36M24 27 12 20m12 16 13-8M24 43l-10 8m10-8 10 8"/></svg><span><b>HEL</b><small>亡者之境</small><em>衰亡、归返与地下之根</em></span></button>
      </div>
      <p class="folio-ninefold-hint" aria-hidden="true"><span>悬停辨认 · 点击留存</span><span>轻触界石查看</span></p>
      <button class="folio-ninefold-trigger" type="button" data-ninefold-trigger aria-label="展开九界石阵" aria-expanded="false"></button>
    </div>

    <div class="folio-cover-copy">
      <p class="folio-cover-role" aria-label="FIELD STRING CORRUPTED">
        <span data-scramble aria-hidden="true">譁?蟄励′螟ｱ繧上ｌ縺溘</span><br>
        <em data-scramble aria-hidden="true">縺薙％縺九ｉ // 0x7F</em>
      </p>
      <div class="folio-cover-terminal">
        <b>&gt; SOLITUDE: ACCEPTED</b><br>
        MOOD: CLOUDY<br>
        NOISE_FILTER: ON<br>
        <span>[ THE WORLD IS LOUD. I AM NOT. ]</span>
      </div>
    </div>

    <aside class="folio-cover-fragment" data-home-quote-card data-quote-number="61" aria-label="随机思想摘录">
      <div class="folio-quote-film" data-home-quote-film>
        <span class="folio-quote-registration" aria-hidden="true">FRAME <b data-home-quote-frame>61</b> / RECEIVED VOICE</span>
        <header class="folio-quote-head">
          <span><b>THOUGHT_ARCHIVE</b><i data-home-quote-status>RECEIVING</i></span>
          <output data-home-quote-index>61 / 80</output>
        </header>
        <blockquote><span data-home-quote data-quote-copy="“知道自己为何而活的人，几乎能承受任何一种生活。”">“知道自己为何而活的人，几乎能承受任何一种生活。”</span></blockquote>
        <footer class="folio-quote-meta">
          <strong data-home-quote-author>弗里德里希·尼采</strong>
          <cite data-home-quote-work>《偶像的黄昏》· 格言 12</cite>
        </footer>
        <span class="folio-quote-exposure" aria-hidden="true"></span>
      </div>
      <div class="folio-quote-rail">
        <button class="folio-quote-next" type="button" data-home-quote-next aria-label="换一条思想摘录"><span>NEXT</span><b aria-hidden="true">→</b></button>
      </div>
      <div class="folio-quote-progress" aria-hidden="true"><span>AUTO / 10.5S</span><i data-home-quote-progress></i></div>
      <div data-home-quote-pool hidden>
        <span data-quote-source="CAPCUT · LOW TIDE / 01">抑郁让人失去构想明天的力气。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 02">像隔着玻璃看世界经过，却碰不到它。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 03">它不总是眼泪，更多时候是漫长的麻木。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 04">不一定悲伤，只是一片无边的空。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 05">痛苦把人关住，而自己也成了守门者。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 06">像思念一个从未存在过的故乡。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 07">思绪成为战场，最难对付的是自己。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 08">脑海里的伤痕，看不见，也迟迟不退。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 09">不是悲伤，是仿佛什么都没有了。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 10">我怀念那个会笑、会快乐的自己。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 11">世界仍有颜色，只是我暂时看不见。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 12">最沉的难过，往往说不出原因。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 13">某天醒来，熟悉的自己已经走远。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 14">空洞藏进骨头里，安静地疼。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 15">每一天都像拖着身体穿过泥泞。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 16">有时只想沉睡，把醒来留到很远以后。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 17">脑海越安静，噪音反而越响。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 18">我不是难过，只是被掏空了。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 19">低落像一场缓慢发生的雪崩。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 20">在自己的城市里，也会找不到归路。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 21">有些日子不是生活，只是在维持呼吸。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 22">身体与思绪，像站在彼此的对面。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 23">不是软弱，只是已经独自撑了太久。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 24">心里像留着一道无法合拢的裂缝。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 25">有时候，连自己的悲伤都重得抱不动。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 26">假装坚强太久，也会把力气用光。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 27">快乐与暂时忘记悲伤，并不是一回事。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 28">像隔着屏幕，看另一个人替自己生活。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 29">天很亮，我的世界却仍旧灰着。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 30">最难防备的，是自己的思绪突然转身。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 31">眼泪只是心里没能说出口的话。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 32">最深的痛，是为了照顾别人而否认自己。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 33">悲伤是一场没有声响的内在风暴。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 34">如果今天只能好好呼吸，也已经足够。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 35">痛苦不一定流泪，也会藏进礼貌的笑。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 36">有些疼，没有名字，也找不到理由。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 37">最难的告别，是告别曾经的自己。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 38">有时不是愤怒或难过，只是真的累了。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 39">最孤独的时候，连依靠都像不存在。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 40">当一切都不对，很难回答哪里不对。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 41">麻木疼痛时，快乐也会一起失去知觉。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 42">心太重，身体便走得很慢。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 43">有些伤口，只有自己知道它在。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 44">今天留下的疼，也可能成为明天的力气。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 45">悲伤有时只容得下一个人。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 46">灵魂累了，比身体更需要休息。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 47">最难忍住的眼泪，常发生在人群里。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 48">难过并不可耻，它只是人性的一部分。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 49">有些悲伤似乎没有尽头，但时间仍在走。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 50">每一天，都像重新面对一次自己。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 51">我只想暂时关掉感受，让心安静一会儿。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 52">人群并不总能消除孤独。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 53">眼泪来时，不必急着让它停下。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 54">状态不好，也仍然值得被善待。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 55">最疼的告别，往往从未真正说出口。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 56">我有许多难过的理由，也还在寻找快乐的理由。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 57">看不见的痛，并不等于不存在。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 58">像沉在水里，看着所有人正常呼吸。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 59">遗憾总爱使用“本可以”和“早知道”。</span>
        <span data-quote-source="CAPCUT · LOW TIDE / 60">有时笑声很完整，心却在里面碎裂。</span>
        <span data-quote-author="弗里德里希·尼采" data-quote-work="《偶像的黄昏》· 格言 12" data-quote-url="https://www.gutenberg.org/files/52263/52263-h/52263-h.htm">知道自己为何而活的人，几乎能承受任何一种生活。</span>
        <span data-quote-author="弗里德里希·尼采" data-quote-work="《偶像的黄昏》· 格言 8" data-quote-url="https://www.gutenberg.org/files/52263/52263-h/52263-h.htm">杀不死我的，使我更强大。</span>
        <span data-quote-author="弗里德里希·尼采" data-quote-work="《查拉图斯特拉如是说》· 序言 5" data-quote-url="https://www.gutenberg.org/files/1998/1998-h/1998-h.htm">人必须在自身保有混沌，才能诞生一颗舞动的星。</span>
        <span data-quote-author="弗里德里希·尼采" data-quote-work="《查拉图斯特拉如是说》· 创造者之路" data-quote-url="https://www.gutenberg.org/files/1998/1998-h/1998-h.htm">独居者总是太快地把手伸向迎面而来的人。</span>
        <span data-quote-author="格奥尔格·黑格尔" data-quote-work="《法哲学原理》· 序言" data-quote-url="https://www.marxists.org/reference/archive/hegel/works/pr/philosophy-of-right.pdf">密涅瓦的猫头鹰，只在黄昏降临时才起飞。</span>
        <span data-quote-author="格奥尔格·黑格尔" data-quote-work="《历史哲学讲演录》· 导论" data-quote-url="https://www.marxists.org/reference/archive/hegel/works/hi/introduction.htm">世界上没有任何伟大的事物，不经激情便能完成。</span>
        <span data-quote-author="格奥尔格·黑格尔" data-quote-work="《历史哲学讲演录》· 导论" data-quote-url="https://books.google.com/books?id=calVsYdns1EC&amp;pg=PA2">经验与历史告诉我们的，恰是人们和政府从未真正向历史学习。</span>
        <span data-quote-author="阿图尔·叔本华" data-quote-work="《劝诫与格言》· 第九节" data-quote-url="https://www.gutenberg.org/cache/epub/10715/pg10715.html">人只有独处时，才真正成为自己。</span>
        <span data-quote-author="阿图尔·叔本华" data-quote-work="《作为意志和表象的世界》· 第一卷 §1" data-quote-url="https://www.gutenberg.org/files/38427/38427-h/38427-h.html">世界是我的表象。</span>
        <span data-quote-author="阿图尔·叔本华" data-quote-work="《劝诫与格言》· 第九节" data-quote-url="https://www.gutenberg.org/cache/epub/10715/pg10715.html">一个人自身拥有得越多，别人能给予他的就越少。</span>
        <span data-quote-author="阿图尔·叔本华" data-quote-work="《劝诫与格言》· 论年龄" data-quote-url="https://www.gutenberg.org/cache/epub/10715/pg10715.html">人生像一幅刺绣；后半程才看见背面的针脚。</span>
        <span data-quote-author="索伦·克尔凯郭尔" data-quote-work="《日记》JJ:167（1843）" data-quote-url="https://homepage.divms.uiowa.edu/~jorgen/kierkegaardquotesource.html">生命只能向后理解，却必须向前生活。</span>
        <span data-quote-author="索伦·克尔凯郭尔" data-quote-work="《焦虑的概念》· 第一章" data-quote-url="https://www.cambridge.org/core/elements/kierkegaards-concept-of-anxiety/94BFEC9F4147A9B5B992DADDF777D086">焦虑，是自由的眩晕。</span>
        <span data-quote-author="马可·奥勒留" data-quote-work="《沉思录》· 5.16" data-quote-url="https://www.gutenberg.org/files/2680/2680-h/2680-h.htm">心灵会染上它日常思想的颜色。</span>
        <span data-quote-author="马可·奥勒留" data-quote-work="《沉思录》· 6.6" data-quote-url="https://www.gutenberg.org/files/2680/2680-h/2680-h.htm">最好的复仇，是不成为伤害你的那种人。</span>
        <span data-quote-author="马可·奥勒留" data-quote-work="《沉思录》· 2.17" data-quote-url="https://www.gutenberg.org/files/2680/2680-h/2680-h.htm">人生是一场战争，也是一段漂泊。</span>
        <span data-quote-author="布莱兹·帕斯卡" data-quote-work="《思想录》· 206" data-quote-url="https://www.gutenberg.org/cache/epub/18269/pg18269-images.html">这些无限空间永恒的沉默，使我恐惧。</span>
        <span data-quote-author="布莱兹·帕斯卡" data-quote-work="《思想录》· 277" data-quote-url="https://www.gutenberg.org/cache/epub/18269/pg18269-images.html">心有其理由，而理性并不知晓。</span>
        <span data-quote-author="爱比克泰德" data-quote-work="《手册》· 第一章" data-quote-url="https://www.gutenberg.org/cache/epub/45109/pg45109-images.html">有些事在我们掌握之中，有些事则不在。</span>
        <span data-quote-author="爱比克泰德" data-quote-work="《手册》· 第五章" data-quote-url="https://www.gutenberg.org/cache/epub/45109/pg45109-images.html">困扰人的不是事物，而是人对事物的判断。</span>
      </div>
    </aside>

