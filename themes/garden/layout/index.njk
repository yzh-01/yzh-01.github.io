{% extends '_layout.njk' %}

{# ===== 构建时数据预计算（一次遍历全站）===== #}
{%- set all_posts = site.posts.toArray() -%}
{%- set wc = 0 -%}
{%- for p in all_posts -%}
  {%- set wc = wc + (p.content | striptags).length -%}
{%- endfor -%}

{%- set cy = moment().format('YYYY') -%}

{# Unique years sorted desc #}
{%- set year_list = [] -%}
{%- set prev = '' -%}
{%- for p in all_posts | reverse -%}
  {%- set y = p.date.format('YYYY') -%}
  {%- if y != prev -%}
    {%- set prev = y -%}
    {%- set _ = year_list.push(y) -%}
  {%- endif -%}
{%- endfor -%}
{%- set year_list = year_list | reverse -%}

{# Featured posts: front matter 里 featured: true 的 #}
{%- set featured_posts = [] -%}
{%- for p in all_posts -%}
  {%- if p.featured -%}
    {%- set _ = featured_posts.push(p) -%}
  {%- endif -%}
{%- endfor -%}
{%- if not featured_posts.length and all_posts.length -%}
  {%- set featured_posts = [all_posts[0]] -%}
{%- endif -%}

{# Life posts: tagged 生活 / 随笔 / 读书 #}
{%- set life_tags = ['生活','随笔','读书','life','essay','reading'] -%}
{%- set life_posts = [] -%}
{%- for p in all_posts -%}
  {%- for t in p.tags.toArray() -%}
    {%- if life_tags.includes(t.name) -%}
      {%- set already = false -%}
      {%- for lp in life_posts -%}
        {%- if lp.path == p.path -%}{%- set already = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if not already -%}{%- set _ = life_posts.push(p) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set life_posts = life_posts.slice(0, 4) -%}

{% block content %}
<div class="g-wide">

  {# ===== 1. Hero ===== #}
  {%- if theme.modules.hero %}
  <section class="hero">
    <h1>{{ config.title }}</h1>
    <p class="tagline">{{ config.subtitle }}</p>
    <p class="signature">// a digital garden · since {{ theme.since or cy }}</p>
  </section>
  {%- endif %}

  {# ===== 2. Latest Posts ===== #}
  {%- if theme.modules.latest_posts %}
  <section class="posts-sec">
    <div class="g-sec-label">recent posts</div>
    {%- for post in page.posts.toArray().slice(0, 6) -%}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <div class="post-card-title">{{ post.title }}</div>
      <div class="post-card-meta">
        <time>{{ post.date.format('YYYY-MM-DD') }}</time>
        {%- for tag in post.tags.toArray().slice(0, 2) -%}
        <span>{{ tag.name }}</span>
        {%- endfor -%}
        <span>{{ (post.content | striptags).length }} 字</span>
      </div>
      {%- if post.description -%}
      <div class="post-card-desc">{{ post.description }}</div>
      {%- endif -%}
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 3. Now ===== #}
  {%- if theme.modules.now and site.data.now and site.data.now.length %}
  <section class="now-sec">
    <div class="g-sec-label">now</div>
    <div class="now-grid">
      {%- for item in site.data.now -%}
      <div class="now-card">
        <h4>{{ item.label }}</h4>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 4. Featured Projects ===== #}
  {%- if theme.modules.featured_projects and featured_posts.length %}
  <section class="featured-sec">
    <div class="g-sec-label">featured</div>
    {%- for fp in featured_posts.slice(0, 2) -%}
    <a class="featured-card" href="{{ url_for(fp.path) }}"{% if loop.index > 1 %} style="margin-top:14px"{% endif %}>
      <div>
        <h3>{{ fp.title }}</h3>
        {%- if fp.description -%}
        <div class="desc">{{ fp.description }}</div>
        {%- endif -%}
        <div class="meta">
          <span>{{ (fp.content | striptags).length }} 字</span>
          <span>{{ fp.date.format('YYYY-MM-DD') }}</span>
        </div>
      </div>
      <span class="badge">featured</span>
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 5. Tech Stack ===== #}
  {%- if theme.modules.tech_stack and site.data.stack and site.data.stack.length %}
  <section class="stack-sec">
    <div class="g-sec-label">tech stack</div>
    <div class="stack-groups">
      {%- for g in site.data.stack -%}
      <div class="stack-group">
        <h4>{{ g.group }}</h4>
        <div class="tags">
          {%- for item in g.items -%}
          <span class="stack-tag">{{ item }}</span>
          {%- endfor -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 6. Journey ===== #}
  {%- if theme.modules.journey and year_list.length %}
  <section class="journey-sec">
    <div class="g-sec-label">journey</div>
    <div class="journey-years">
      {%- for y in year_list -%}
        {%- set cnt = 0 -%}
        {%- for p in all_posts -%}
          {%- if p.date.format('YYYY') == y -%}{%- set cnt = cnt + 1 -%}{%- endif -%}
        {%- endfor -%}
      <a class="journey-year" href="{{ url_for('archives/' + y + '/') }}">
        <span class="yr">{{ y }}</span>
        <span class="cnt">{{ cnt }} 篇</span>
      </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 7. Life ===== #}
  {%- if theme.modules.life and life_posts.length %}
  <section class="life-sec">
    <div class="g-sec-label">life</div>
    {%- for post in life_posts -%}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <div class="post-card-title">{{ post.title }}</div>
      <div class="post-card-meta">
        <time>{{ post.date.format('YYYY-MM-DD') }}</time>
        {%- for tag in post.tags.toArray() -%}
        <span>{{ tag.name }}</span>
        {%- endfor -%}
      </div>
      {%- if post.description -%}
      <div class="post-card-desc">{{ post.description }}</div>
      {%- endif -%}
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 8. About ===== #}
  {%- if theme.modules.about %}
  <section class="about-sec">
    <div class="about-mark" aria-hidden="true">y</div>
    <div class="about-summary">
      <h2>关于这个花园</h2>
      <p>这里不是一份面向招聘的作品集，而是一块长期维护的个人数字空间。</p>
      <p>代码、学习与生活并排生长，慢一点，没有关系。</p>
      <div class="links">
        <a class="link-btn primary" href="{{ url_for('about/') }}">继续了解 <span aria-hidden="true">→</span></a>
        <a class="link-btn" href="https://github.com/yzh-01" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  {%- endif %}

</div>
{% endblock %}
