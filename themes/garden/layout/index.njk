{% extends '_layout.njk' %}

{% block title %}{{ config.title }} — {{ config.subtitle }}{% endblock %}
{% block description %}{{ config.description }}{% endblock %}

{# ===== 构建时数据预计算（一次遍历全站）===== #}
{%- set all_posts = site.posts.toArray() -%}
{%- set wc = 0 -%}
{%- for p in all_posts -%}
  {%- set wc = wc + (p.content | striptags).length -%}
{%- endfor -%}

{%- set cy = moment().format('YYYY') -%}

{# Unique years sorted desc #}
{%- set year_list = [] -%}
{%- set prev = '' -%}
{%- for p in all_posts | reverse -%}
  {%- set y = p.date.format('YYYY') -%}
  {%- if y != prev -%}
    {%- set prev = y -%}
    {%- set _ = year_list.push(y) -%}
  {%- endif -%}
{%- endfor -%}
{%- set year_list = year_list | reverse -%}

{# Featured posts: front matter 里 featured: true 的 #}
{%- set featured_posts = [] -%}
{%- for p in all_posts -%}
  {%- if p.featured -%}
    {%- set _ = featured_posts.push(p) -%}
  {%- endif -%}
{%- endfor -%}
{%- if not featured_posts.length and all_posts.length -%}
  {%- set featured_posts = [all_posts[0]] -%}
{%- endif -%}

{# Life posts: tagged 生活 / 随笔 / 读书 #}
{%- set life_tags = ['生活','随笔','读书','life','essay','reading'] -%}
{%- set life_posts = [] -%}
{%- for p in all_posts -%}
  {%- for t in p.tags.toArray() -%}
    {%- if life_tags.includes(t.name) -%}
      {%- set already = false -%}
      {%- for lp in life_posts -%}
        {%- if lp.path == p.path -%}{%- set already = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if not already -%}{%- set _ = life_posts.push(p) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set life_posts = life_posts.slice(0, 4) -%}

{% block content %}
<div class="g-wide">

  {# ===== 1. Hero ===== #}
  <section class="hero">
    <h1>{{ config.title }}</h1>
    <p class="tagline">{{ config.subtitle }}</p>
    <p class="signature">// a digital garden · since {{ cy }}</p>
  </section>

  {# ===== 2. Latest Posts ===== #}
  <section class="posts-sec">
    <div class="g-sec-label">recent posts</div>
    {%- for post in page.posts.toArray().slice(0, 6) -%}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <div class="post-card-title">{{ post.title }}</div>
      <div class="post-card-meta">
        <time>{{ post.date.format('YYYY-MM-DD') }}</time>
        {%- for tag in post.tags.toArray().slice(0, 2) -%}
        <span>{{ tag.name }}</span>
        {%- endfor -%}
        <span>{{ (post.content | striptags).length }} 字</span>
      </div>
      {%- if post.description -%}
      <div class="post-card-desc">{{ post.description }}</div>
      {%- endif -%}
    </a>
    {%- endfor -%}
  </section>

  {# ===== 3. Now ===== #}
  {%- if site.data.now and site.data.now.length %}
  <section class="now-sec">
    <div class="g-sec-label">now</div>
    <div class="now-grid">
      {%- for item in site.data.now -%}
      <div class="now-card">
        <h4>{{ item.label }}</h4>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 4. Featured Projects ===== #}
  {%- if featured_posts.length %}
  <section class="featured-sec">
    <div class="g-sec-label">featured</div>
    {%- for fp in featured_posts.slice(0, 2) -%}
    <a class="featured-card" href="{{ url_for(fp.path) }}"{% if loop.index > 1 %} style="margin-top:14px"{% endif %}>
      <div>
        <h3>{{ fp.title }}</h3>
        {%- if fp.description -%}
        <div class="desc">{{ fp.description }}</div>
        {%- endif -%}
        <div class="meta">
          <span>{{ (fp.content | striptags).length }} 字</span>
          <span>{{ fp.date.format('YYYY-MM-DD') }}</span>
        </div>
      </div>
      <span class="badge">featured</span>
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 5. Tech Stack ===== #}
  {%- if site.data.stack and site.data.stack.length %}
  <section class="stack-sec">
    <div class="g-sec-label">tech stack</div>
    <div class="stack-groups">
      {%- for g in site.data.stack -%}
      <div class="stack-group">
        <h4>{{ g.group }}</h4>
        <div class="tags">
          {%- for item in g.items -%}
          <span class="stack-tag">{{ item }}</span>
          {%- endfor -%}
        </div>
      </div>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 6. Journey ===== #}
  {%- if year_list.length %}
  <section class="journey-sec">
    <div class="g-sec-label">journey</div>
    <div class="journey-years">
      {%- for y in year_list -%}
        {%- set cnt = 0 -%}
        {%- for p in all_posts -%}
          {%- if p.date.format('YYYY') == y -%}{%- set cnt = cnt + 1 -%}{%- endif -%}
        {%- endfor -%}
      <a class="journey-year" href="{{ url_for('archives/' + y + '/') }}">
        <span class="yr">{{ y }}</span>
        <span class="cnt">{{ cnt }} 篇</span>
      </a>
      {%- endfor -%}
    </div>
  </section>
  {%- endif %}

  {# ===== 7. Life ===== #}
  {%- if life_posts.length %}
  <section class="life-sec">
    <div class="g-sec-label">life</div>
    {%- for post in life_posts -%}
    <a class="post-card" href="{{ url_for(post.path) }}">
      <div class="post-card-title">{{ post.title }}</div>
      <div class="post-card-meta">
        <time>{{ post.date.format('YYYY-MM-DD') }}</time>
        {%- for tag in post.tags.toArray() -%}
        <span>{{ tag.name }}</span>
        {%- endfor -%}
      </div>
      {%- if post.description -%}
      <div class="post-card-desc">{{ post.description }}</div>
      {%- endif -%}
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 8. About ===== #}
  <section class="about-sec">
    <img class="avatar" src="https://github.com/yzh-01.png?size=120" alt="{{ config.author }}" loading="lazy" />
    <h2>关于此处</h2>
    <p>一个普通的博客。写代码，也写点别的。慢一点，没有关系。</p>
    <p>这里记录：技术学习、生活随笔、读完的书、做过的梦。</p>
    <div class="links">
      <a class="link-btn" href="https://github.com/yzh-01" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.74.11 3.03.74.81 1.18 1.84 1.18 3.1 0 4.42-2.7 5.39-5.27 5.68.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/></svg>
        <span>github</span>
      </a>
      <a class="link-btn" href="mailto:107386162@qq.com">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 7l2-2h14l2 2"/></svg>
        <span>email</span>
      </a>
    </div>
  </section>

</div>
{% endblock %}

{% block scripts %}
{# 导航滚动粘性 #}
<script>
(function(){
  var nav = document.getElementById('g-nav');
  if (!nav) return;
  var ticking = false;
  window.addEventListener('scroll', function(){
    if (!ticking) {
      requestAnimationFrame(function(){
        nav.classList.toggle('scrolled', window.scrollY > 20);
        ticking = false;
      });
      ticking = true;
    }
  }, {passive: true});
})();
</script>

{# 文章页返回顶部按钮 #}
<script>
(function(){
  if (!document.querySelector('.article')) return;
  var btn = document.createElement('a');
  btn.className = 'g-back-top';
  btn.href = '#';
  btn.setAttribute('aria-label', '回到顶部');
  btn.textContent = '↑';
  document.body.appendChild(btn);
  var ticking = false;
  window.addEventListener('scroll', function(){
    if (!ticking) {
      requestAnimationFrame(function(){
        btn.classList.toggle('visible', window.scrollY > 400);
        ticking = false;
      });
      ticking = true;
    }
  }, {passive: true});
  btn.addEventListener('click', function(e){
    e.preventDefault();
    window.scrollTo({top: 0, behavior: 'smooth'});
  });
})();
</script>
{% endblock %}
