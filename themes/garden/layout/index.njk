    <div class="folio-field-motion folio-field-motion-articles" aria-hidden="true"><i class="folio-field-sweep"></i><b></b><b></b><b></b></div>

    <div class="folio-articles-grid">
      <aside class="folio-article-console" aria-label="花园贡献记录与日历" data-reveal>
        <header><span>SYS.GARDEN_ACTIVITY</span><b><i></i>LIVE</b></header>

        <section class="folio-contribution" data-contribution-wall aria-labelledby="folio-contribution-title">
          <div class="folio-contribution-heading">
            <div><small>DAILY_CONTRIBUTION</small><h3 id="folio-contribution-title">留下过痕迹的日子</h3></div>
            <span data-contribution-summary>-- ACTIVE DAYS</span>
          </div>
          <div class="folio-contribution-months" data-contribution-months aria-hidden="true"></div>
          <div class="folio-contribution-matrix">
            <div class="folio-contribution-weekdays" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
            <div class="folio-contribution-grid" data-contribution-grid role="img" aria-label="最近二十八周的文章发布贡献"></div>
          </div>
          <div class="folio-contribution-foot">
            <span>28 WEEK WINDOW / ARTICLE LOG</span>
            <p><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i></p>
          </div>
          <div hidden>
            {%- for post in all_posts %}<i data-contribution-date="{{ post.date.format('YYYY-MM-DD') }}"></i>{%- endfor %}
          </div>
        </section>

        <section class="folio-calendar" data-folio-calendar aria-labelledby="folio-calendar-title">
          <header><small>SYS.DATE</small><time id="folio-calendar-title" data-calendar-title>----.--</time></header>
          <div class="folio-calendar-weekdays" aria-hidden="true"><span>MO</span><span>TU</span><span>WE</span><span>TH</span><span>FR</span><span>SA</span><span>SU</span></div>
          <div class="folio-calendar-days" data-calendar-grid aria-label="本月日历"></div>
          <footer><span>YEAR PROGRESS</span><b data-calendar-progress>--.---%</b></footer>
        </section>
      </aside>

      <div class="folio-article-stream" data-reveal>
        <header>
          <h2 id="folio-articles-title"><i>&gt;</i> RECENT_LOG</h2>
          <a href="{{ url_for('archives/') }}">VIEW ALL LOGS ↗</a>
        </header>
        <ol>
          {%- for post in latest_posts %}
          <li data-motion-row>
            <a href="{{ url_for(post.path) }}" data-post-transition>
              <small>0{{ loop.index }} / {{ post.date.format('YYYY.MM.DD') }}</small>
              <h3>{{ post.title }}</h3>
              <p>{{ post.description if post.description else 'CONTENTS AWAITING INDEX.' }}</p>
              <span>READ_LOG ↗</span>
            </a>
          </li>
          {%- endfor %}
        </ol>
      </div>
    </div>
    <p class="folio-articles-baseline" aria-hidden="true">RECENT_LOG &lt;</p>
  </section>
  {%- endif %}

  <section class="folio-outro" id="the-end" data-folio-outro aria-labelledby="folio-outro-label">
    <span class="folio-outro-orbit" aria-hidden="true"><i></i></span>
    <div class="folio-outro-inner">
      <p class="folio-outro-signal"><i aria-hidden="true"></i><span>LIVE_FIELD / MOVE TO DISTURB</span></p>
      <p class="sr-only" id="folio-outro-label">This ends now</p>
      <h2 aria-hidden="true"><span data-outro-text data-outro-value="This ends now">This ends now</span></h2>
      <div class="folio-outro-track" data-outro-track role="slider" tabindex="0" aria-label="拖动调节结尾信号" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
        <i aria-hidden="true"></i><b aria-hidden="true"></b>
        <span data-outro-meter>SIGNAL 100%</span>
      </div>
      <div class="folio-outro-meta">
        <span data-outro-status>MOVE: REPEL // CLICK: IMPACT // DRAG: DETUNE</span>
        <div class="folio-outro-actions">
          <a href="#hello">回到开头 <b aria-hidden="true">↑</b></a>
        </div>
      </div>
    </div>
  </section>

</div>
{% endblock %}
