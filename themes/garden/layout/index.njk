{% extends '_layout.njk' %}

{% block head_extra %}
<link rel="stylesheet" href="{{ url_for('css/home.css') }}?v={{ theme.asset_version }}">
{% endblock %}

{# ===== 构建时数据预计算（一次遍历全站）===== #}
{%- set all_posts = site.posts.toArray() -%}
{%- set wc = 0 -%}
{%- for p in all_posts -%}
  {%- set wc = wc + (p.content | striptags).length -%}
{%- endfor -%}

{%- set cy = moment().format('YYYY') -%}

{# Unique years sorted desc #}
{%- set year_list = [] -%}
{%- set prev = '' -%}
{%- for p in all_posts | reverse -%}
  {%- set y = p.date.format('YYYY') -%}
  {%- if y != prev -%}
    {%- set prev = y -%}
    {%- set _ = year_list.push(y) -%}
  {%- endif -%}
{%- endfor -%}
{%- set year_list = year_list | reverse -%}

{# Featured posts: front matter 里 featured: true 的 #}
{%- set featured_posts = [] -%}
{%- for p in all_posts -%}
  {%- if p.featured -%}
    {%- set _ = featured_posts.push(p) -%}
  {%- endif -%}
{%- endfor -%}
{# Life posts: tagged 生活 / 随笔 / 读书 #}
{%- set life_tags = ['生活','随笔','读书','life','essay','reading'] -%}
{%- set life_posts = [] -%}
{%- for p in all_posts -%}
  {%- for t in p.tags.toArray() -%}
    {%- if life_tags.includes(t.name) -%}
      {%- set already = false -%}
      {%- for lp in life_posts -%}
        {%- if lp.path == p.path -%}{%- set already = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if not already -%}{%- set _ = life_posts.push(p) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set life_post_count = life_posts.length -%}
{%- set life_posts = life_posts.slice(0, 4) -%}

{# Garden terrain counts: broad paths may overlap by design. #}
{%- set tech_posts = [] -%}
{%- set study_posts = [] -%}
{%- set tech_terms = ['学习笔记','VSCode','软件工程','工具','hacking','code'] -%}
{%- set study_terms = ['笔记','学习','notes','review','reading'] -%}
{%- for p in all_posts -%}
  {%- set is_tech = false -%}
  {%- set is_study = false -%}
  {%- for c in p.categories.toArray() -%}
    {%- if tech_terms.includes(c.name) %}{%- set is_tech = true -%}{%- endif -%}
    {%- if study_terms.includes(c.name) %}{%- set is_study = true -%}{%- endif -%}
  {%- endfor -%}
  {%- for t in p.tags.toArray() -%}
    {%- if tech_terms.includes(t.name) %}{%- set is_tech = true -%}{%- endif -%}
    {%- if study_terms.includes(t.name) %}{%- set is_study = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if is_tech %}{%- set _ = tech_posts.push(p) -%}{%- endif -%}
  {%- if is_study %}{%- set _ = study_posts.push(p) -%}{%- endif -%}
{%- endfor -%}

{% block content %}
<div class="g-wide">

  <nav class="garden-route" aria-label="首页花园路径">
    <span class="garden-route-track" aria-hidden="true"><i></i></span>
    <a href="#garden-intro" data-route-link><span>序章</span></a>
    {%- if theme.modules.hero %}<a href="#garden-home" data-route-link><span>生长</span></a>{%- endif %}
    <a href="#garden-map" data-route-link><span>地形</span></a>
    {%- if theme.modules.life and life_posts.length %}<a href="#life" data-route-link><span>侧枝</span></a>{%- endif %}
    {%- if theme.modules.about %}<a href="#garden-about" data-route-link><span>关于</span></a>{%- endif %}
  </nav>

  {# ===== 1. Personal Hero ===== #}
  {%- if theme.modules.hero %}
  <section class="hero" id="garden-home">
    <span class="hero-index" aria-hidden="true">OBSERVATION / 001</span>
    <div class="hero-orbit" aria-hidden="true">
      <i></i><i></i><i></i>
      <span>GROWING<br>IN PUBLIC</span>
    </div>
    <div class="hero-fireflies" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    <div class="hero-copy">
      <p class="hero-eyebrow"><span aria-hidden="true"></span>个人数字花园 · 持续生长中</p>
      <h1><span class="hero-greeting">HELLO, I'M</span><span class="hero-name">{{ config.author }}</span></h1>
      <p class="hero-thesis">把代码写进日常，<br><em>也把生活种进时间里。</em></p>
      <p class="tagline">一座仍在施工的私人观测站。技术实践、学习中的疑问与普通日子的碎片，在这里彼此照亮。</p>
      <div class="hero-actions">
        <a class="hero-action primary" href="#latest-posts">阅读最近文章 <span aria-hidden="true">↓</span></a>
        <a class="hero-action" href="{{ url_for('about/') }}">关于我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="hero-identity" aria-label="关于这个数字花园">
      <span class="hero-specimen-label">SPECIMEN · SELF PORTRAIT</span>
      <div class="hero-companion">
        <img class="hero-companion-light" src="{{ url_for('images/garden-light-avatar.jpg') }}" width="736" height="736" alt="一只探出头的白猫" decoding="async">
        <img class="hero-companion-dark" src="{{ url_for('images/garden-companion.jpg') }}" width="720" height="720" alt="一只坐在林间苔藓上的黑猫" decoding="async">
      </div>
      <p class="hero-hand">雨止灰茫</p>
      <p class="hero-motto">在不确定里，积累一点确定。</p>
      <dl class="hero-stats">
        <div>
          <dt>记录</dt>
          <dd>{{ all_posts.length }}<small>篇</small></dd>
        </div>
        <div>
          <dt>文字</dt>
          <dd>{{ wc }}<small>字</small></dd>
        </div>
        <div>
          <dt>生长</dt>
          <dd>{{ year_list.length }}<small>年</small></dd>
        </div>
      </dl>
      <p class="hero-since">// since {{ theme.since or cy }}</p>
    </aside>
    <div class="hero-trace" aria-hidden="true"></div>
  </section>
  <div class="garden-signal-strip" aria-label="花园内容方向">
    <div aria-hidden="true">
      <span>CODE AS CRAFT</span><i>✦</i><span>LEARNING IN PUBLIC</span><i>✦</i><span>ORDINARY DAYS</span><i>✦</i><span>KEEP GROWING</span><i>✦</i>
      <span aria-hidden="true">CODE AS CRAFT</span><i aria-hidden="true">✦</i><span aria-hidden="true">LEARNING IN PUBLIC</span><i aria-hidden="true">✦</i><span aria-hidden="true">ORDINARY DAYS</span><i aria-hidden="true">✦</i><span aria-hidden="true">KEEP GROWING</span><i aria-hidden="true">✦</i>
    </div>
  </div>
  {%- endif %}

  {# ===== 2. Latest Posts ===== #}
  {%- set latest_posts = page.posts.toArray().slice(0, 6) -%}
  {%- if theme.modules.latest_posts and latest_posts.length %}
  {%- set lead_post = latest_posts[0] -%}
  {%- set lead_status = lead_post.status or 'growing' -%}
  {%- set lead_status_label = '萌芽' -%}
  {%- if lead_status == 'growing' %}{%- set lead_status_label = '生长中' -%}{%- endif -%}
  {%- if lead_status == 'evergreen' %}{%- set lead_status_label = '常青' -%}{%- endif -%}
  <section class="posts-sec" id="latest-posts" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">recent posts</h2>
      <a href="{{ url_for('archives/') }}">查看全部 <span aria-hidden="true">→</span></a>
    </div>
    <div class="posts-editorial{% if latest_posts.length == 1 %} is-single{% endif %}">
      <a class="post-lead" href="{{ url_for(lead_post.path) }}" data-post-transition>
        <span class="post-lead-kicker">
          <span>latest note</span>
          <i aria-hidden="true"></i>
          <span>{{ lead_status_label }}</span>
        </span>
        <h3 data-post-transition-title>{{ lead_post.title }}</h3>
        {%- if lead_post.description -%}
        <p>{{ lead_post.description }}</p>
        {%- endif -%}
        <span class="post-lead-foot">
          <time datetime="{{ lead_post.date.format('YYYY-MM-DD') }}">{{ lead_post.date.format('YYYY-MM-DD') }}</time>
          {%- for tag in lead_post.tags.toArray().slice(0, 2) -%}<span>{{ tag.name }}</span>{%- endfor -%}
          <span>{{ (lead_post.content | striptags).length }} 字</span>
          <b>打开笔记 <span aria-hidden="true">↗</span></b>
        </span>
      </a>
      {%- if latest_posts.length > 1 %}
      <div class="post-brief-list post-brief-count-{{ latest_posts.length - 1 }}" aria-label="更多近期文章">
        {%- for post in latest_posts.slice(1) -%}
        <a class="post-brief" href="{{ url_for(post.path) }}" data-post-transition>
          <span class="post-brief-index">{{ loop.index + 1 if loop.index >= 9 else '0' + (loop.index + 1) }}</span>
          <span class="post-brief-copy">
            <strong data-post-transition-title>{{ post.title }}</strong>
            {%- if post.description %}<span>{{ post.description }}</span>{%- endif %}
            <small><time datetime="{{ post.date.format('YYYY-MM-DD') }}">{{ post.date.format('MM-DD') }}</time>{% if post.tags.length %} · {{ post.tags.toArray()[0].name }}{% endif %}</small>
          </span>
          <span class="post-brief-arrow" aria-hidden="true">→</span>
        </a>
        {%- endfor -%}
      </div>
      {%- endif %}
    </div>
  </section>
  {%- endif %}

  {# ===== 3. Right Now: status + workbench + garden log ===== #}
  {%- set has_now = theme.modules.now and site.data.now and site.data.now.items and site.data.now.items.length -%}
  {%- set has_workbench = theme.modules.workbench and site.data.stack and site.data.stack.length -%}
  {%- set has_garden_log = theme.modules.garden_log and site.data['garden-log'] and site.data['garden-log'].length -%}
  {%- if has_garden_log %}{%- set latest_log = site.data['garden-log'][0] -%}{%- endif -%}
  {%- if has_now or has_workbench or has_garden_log %}
  <section class="present-sec" id="now" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">right now</h2>
      {%- if site.data.now.updated %}<span class="section-freshness">更新于 {{ site.data.now.updated }}</span>{%- endif %}
    </div>
    <div class="present-board{% if not has_now %} present-board-without-status{% endif %}{% if not has_workbench %} present-board-without-workbench{% endif %}">
      {%- if has_now %}
      <div class="present-status-panel">
        <header class="present-lede">
          <span>FIELD NOTE / 此刻</span>
          <h3>读、学、做，构成这座花园最近的天气。</h3>
          <p>它们会改变，也会留下生长过的痕迹。</p>
        </header>
        <div class="present-status-list">
      {%- for item in site.data.now.items -%}
          <div class="present-status-item">
        <span class="now-signal" aria-hidden="true"></span>
            <div>
              <h4>{{ item.label }}</h4>
              <p>{{ item.text }}</p>
            </div>
          </div>
      {%- endfor -%}
        </div>
      </div>
      {%- endif %}

      {%- if has_workbench %}
      <section class="present-workbench" id="stack" aria-labelledby="present-workbench-title">
        <header class="present-block-heading">
          <span>WORKBENCH</span>
          <div>
            <h3 id="present-workbench-title">正在使用的工具</h3>
            <p>不是技能陈列，而是此刻真正放在桌面上的东西。</p>
          </div>
        </header>
        <div class="present-stack-groups">
          {%- for g in site.data.stack -%}
          <div class="present-stack-group">
            <h4>{{ g.group }}</h4>
            <div>
              {%- for item in g.items -%}
              <span class="present-stack-tag">
                <strong>{{ item.name or item }}</strong>
                {%- if item.note %}<small>{{ item.note }}</small>{%- endif %}
              </span>
              {%- endfor -%}
            </div>
          </div>
          {%- endfor -%}
        </div>
      </section>
      {%- endif %}

      {%- if has_garden_log %}
      <a class="present-log" id="garden-log" href="{{ url_for('garden-log/#' + latest_log.month) }}">
        <span class="present-log-label">GARDEN LOG</span>
        <time datetime="{{ latest_log.month }}">{{ latest_log.label }}</time>
        <span class="present-log-copy">
          <strong>{{ latest_log.title }}</strong>
          <small>{{ latest_log.summary }}</small>
        </span>
        <span class="present-log-arrow" aria-hidden="true">↗</span>
      </a>
      {%- endif %}
    </div>
  </section>
  {%- endif %}

  {# ===== 4. Garden Map ===== #}
  <section class="garden-map" id="garden-map" data-reveal aria-labelledby="garden-map-title">
    <div class="g-sec-heading">
      <h2 class="g-sec-label" id="garden-map-title">knowledge terrain</h2>
      <span class="garden-map-note">按兴趣走进这座花园</span>
    </div>
    <div class="garden-terrain">
      <div class="terrain-radar" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
      <svg class="garden-terrain-lines" viewBox="0 0 920 460" preserveAspectRatio="none" aria-hidden="true">
        <path class="terrain-contour terrain-contour-a" d="M60 236C154 94 302 73 433 170S691 279 860 111" />
        <path class="terrain-contour terrain-contour-b" d="M41 343C189 256 297 332 420 277S677 168 875 319" />
        <path class="terrain-branch" d="M455 230C348 210 271 155 187 130" />
        <path class="terrain-branch" d="M455 230C571 190 644 125 744 112" />
        <path class="terrain-branch" d="M455 230C589 272 670 336 759 348" />
      </svg>
      <span class="terrain-compass" aria-hidden="true"><i></i>N / 00°</span>
      <span class="terrain-origin" aria-hidden="true"><i></i><span>YOU ARE HERE</span></span>

      <a class="terrain-node terrain-node-code" href="{{ url_for('categories/study-notes/') }}">
        <span class="terrain-node-meta">CODE · {{ tech_posts.length }} NOTES</span>
        <strong>技术探索</strong>
        <small>代码、课程与工具实践</small>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="terrain-node terrain-node-notes" href="{{ url_for('tags/notes/') }}">
        <span class="terrain-node-meta">LEARNING · {{ study_posts.length }} NOTES</span>
        <strong>学习记录</strong>
        <small>问题、复习与未成熟的想法</small>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="terrain-node terrain-node-life" href="{{ url_for('categories/diary/') }}">
        <span class="terrain-node-meta">LIFE · {{ life_post_count }} NOTES</span>
        <strong>日常生活</strong>
        <small>书、情绪与普通日子的碎片</small>
        <b aria-hidden="true">↗</b>
      </a>

      <a class="garden-wander" href="{{ url_for(all_posts[0].path) if all_posts.length else url_for('archives/') }}" data-garden-wander>
        <span aria-hidden="true">⌁</span>
        <strong>随便走走</strong>
        <small>进入一篇随机笔记</small>
      </a>
      <div class="garden-wander-pool" data-garden-wander-pool hidden>
        {%- for post in all_posts %}<span data-wander-path="{{ url_for(post.path) }}"></span>{%- endfor %}
      </div>
    </div>
  </section>

  {# ===== 5. Long-lived notes ===== #}
  {%- if theme.modules.featured_notes and featured_posts.length %}
  <section class="featured-sec" id="featured" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">long-lived notes</h2>
      <span class="section-freshness">持续修订的内容</span>
    </div>
    {%- for fp in featured_posts.slice(0, 2) -%}
    <a class="featured-card" href="{{ url_for(fp.path) }}" data-spotlight data-post-transition{% if loop.index > 1 %} style="margin-top:14px"{% endif %}>
      <div>
        <h3 data-post-transition-title>{{ fp.title }}</h3>
        {%- if fp.description -%}
        <div class="desc">{{ fp.description }}</div>
        {%- endif -%}
        <div class="meta">
          <span>{{ (fp.content | striptags).length }} 字</span>
          <span>整理于 {{ (fp.updated if fp.updated else fp.date).format('YYYY-MM-DD') }}</span>
        </div>
      </div>
      <span class="badge">evergreen</span>
    </a>
    {%- endfor -%}
  </section>
  {%- endif %}

  {# ===== 6. Life ===== #}
  {%- if theme.modules.life and life_posts.length %}
  <section class="life-sec" id="life" data-reveal>
    <div class="g-sec-heading">
      <h2 class="g-sec-label">life</h2>
      <a href="{{ url_for('categories/diary/') }}">更多生活记录 <span aria-hidden="true">→</span></a>
    </div>
    <div class="life-notes-grid">
      {%- for post in life_posts -%}
      <a class="life-note{% if loop.first %} life-note-featured{% endif %}" href="{{ url_for(post.path) }}" data-post-transition>
        {%- if loop.first %}
        <span class="life-note-media" aria-hidden="true">
          <img class="life-note-media-light" src="{{ url_for('images/garden-light-cat.jpg') }}" width="735" height="525" alt="" loading="lazy" decoding="async">
          <img class="life-note-media-dark" src="{{ url_for('images/garden-companion.jpg') }}" width="720" height="720" alt="" loading="lazy" decoding="async">
        </span>
        {%- endif %}
        <span class="life-note-copy">
          <span class="life-note-kicker"><time>{{ post.date.format('YYYY-MM-DD') }}</time> · life note</span>
          <strong data-post-transition-title>{{ post.title }}</strong>
          {%- if post.description %}<span class="life-note-desc">{{ post.description }}</span>{%- endif %}
          <span class="life-note-link">走进这一天 <b aria-hidden="true">→</b></span>
        </span>
      </a>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {# ===== 9. About ===== #}
  {%- if theme.modules.about %}
  <section class="about-sec" id="garden-about" data-reveal>
    <figure class="about-photo">
      <img src="{{ url_for('images/garden-night-window.jpg') }}" width="735" height="551" alt="夜色中透过玻璃窗看见的植物与灯光" loading="lazy" decoding="async">
      <figcaption>窗内写字，窗外生长。</figcaption>
    </figure>
    <div class="about-summary">
      <h2>关于这个花园</h2>
      <p>这里是一块长期维护的个人数字空间。</p>
      <p>代码、学习与生活并排生长。</p>
      <p class="about-signature"><span>{{ config.author }}</span> · 学习者、实践者、长期记录者</p>
      <div class="links">
        <a class="link-btn primary" href="{{ url_for('about/') }}">继续了解 <span aria-hidden="true">→</span></a>
        <a class="link-btn" href="https://github.com/yzh-01" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  {%- endif %}

</div>
{% endblock %}
