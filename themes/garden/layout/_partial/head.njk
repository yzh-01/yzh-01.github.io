<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ config.title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ config.description }}{% endblock %}">
<meta name="author" content="{{ config.author }}">
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="{{ url_for('images/logo.svg') }}" type="image/svg+xml">
<link rel="stylesheet" href="{{ url_for('css/style.css') }}">
<link rel="alternate" href="{{ url_for('atom.xml') }}" type="application/atom+xml" title="{{ config.title }}">
<link rel="canonical" href="{{ config.url }}{{ url_for(page.path) }}">
{%- if config.feed %}
<link rel="alternate" href="{{ url_for(config.feed.path) }}" type="application/atom+xml" title="{{ config.title }}">
{%- endif %}
{%- if page.tags %}
<meta name="keywords" content="{% for t in page.tags %}{{ t.name }}{% if not loop.last %},{% endif %}{% endfor %}">
{%- endif %}
{%- if page.og_image or config.og_image %}
<meta property="og:image" content="{{ page.og_image or config.og_image }}">
{%- endif %}
<meta property="og:title" content="{% block og_title %}{{ config.title }}{% endblock %}">
<meta property="og:description" content="{% block og_description %}{{ config.description }}{% endblock %}">
<meta property="og:type" content="{% if is_post() %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ config.url }}{{ url_for(page.path) }}">
