<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- if is_home() -%}
  {%- set resolved_title = config.title + ' — ' + config.subtitle -%}
{%- elif is_post() or is_page() -%}
  {%- set resolved_title = page.title + ' — ' + config.title -%}
{%- elif is_tag() -%}
  {%- set resolved_title = '标签：' + page.tag + ' — ' + config.title -%}
{%- elif is_category() -%}
  {%- set resolved_title = '分类：' + page.category + ' — ' + config.title -%}
{%- elif page.year and page.month -%}
  {%- set resolved_title = page.year + ' 年 ' + page.month + ' 月 — ' + config.title -%}
{%- elif page.year -%}
  {%- set resolved_title = page.year + ' 年归档 — ' + config.title -%}
{%- else -%}
  {%- set resolved_title = '归档 — ' + config.title -%}
{%- endif -%}
{%- if page.description -%}
  {%- set resolved_description = page.description -%}
{%- elif is_tag() -%}
  {%- set resolved_description = '浏览标签“' + page.tag + '”下的文章' -%}
{%- elif is_category() -%}
  {%- set resolved_description = '浏览分类“' + page.category + '”下的文章' -%}
{%- elif is_archive() -%}
  {%- set resolved_description = '按时间浏览' + config.title + '的文章归档' -%}
{%- else -%}
  {%- set resolved_description = config.description -%}
{%- endif -%}
{%- set resolved_type = 'article' if is_post() else 'website' -%}
{%- set canonical_url = config.url + (url_for('/') if is_home() else url_for(page.path)) -%}
<title>{{ resolved_title }}</title>
<meta name="description" content="{{ resolved_description }}">
<meta name="author" content="{{ config.author }}">
<meta name="theme-color" id="g-theme-color" content="#e3e8e0">
<meta name="color-scheme" content="light dark">
<script>
  (function () {
    var mode = 'system';
    try { mode = localStorage.getItem('garden-theme') || 'system'; } catch (error) {}
    if (mode !== 'light' && mode !== 'dark') mode = 'system';
    if (mode !== 'system') document.documentElement.dataset.theme = mode;
    var dark = mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.dataset.resolvedTheme = dark ? 'dark' : 'light';
    document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    document.getElementById('g-theme-color').setAttribute('content', dark ? '#090b0a' : '#e3e8e0');
  })();
</script>
<link rel="icon" href="{{ url_for('images/logo.svg') }}" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=DotGothic16&family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+SC:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Unbounded:wght@400;500;600;700&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.1.0/style.css" rel="stylesheet">
<link rel="stylesheet" href="{{ url_for('css/style.css') }}?v={{ theme.asset_version }}">
<link rel="alternate" href="{{ url_for('atom.xml') }}" type="application/atom+xml" title="{{ config.title }}">
<link rel="canonical" href="{{ canonical_url }}">
{%- if page.tags and page.tags.length %}
{%- set tag_names = [] -%}
{%- for tag in page.tags.toArray() -%}
  {%- set _ = tag_names.push(tag.name) -%}
{%- endfor %}
<meta name="keywords" content="{{ tag_names | join(',') }}">
{%- elif config.keywords %}
<meta name="keywords" content="{{ config.keywords }}">
{%- endif %}
{%- if page.og_image or config.og_image %}
<meta property="og:image" content="{{ page.og_image or config.og_image }}">
{%- endif %}
<meta property="og:title" content="{{ resolved_title }}">
<meta property="og:description" content="{{ resolved_description }}">
<meta property="og:type" content="{{ resolved_type }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ config.title }}">
<meta property="og:locale" content="zh_CN">
<meta name="twitter:card" content="{% if page.og_image or config.og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ resolved_title }}">
<meta name="twitter:description" content="{{ resolved_description }}">
