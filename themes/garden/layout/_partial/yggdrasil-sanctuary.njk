{%- set root_realms = [
  { name: '阿斯加德', label: 'ÁSGARÐR', mark: 'ᛟ', story: '神明的居所。金色根脉穿过寒雾，通向高处的殿堂。' },
  { name: '米德加尔德', label: 'MIÐGARÐR', mark: 'ᛗ', story: '人间的庭院。再漫长的夜，也有人为归途留一盏灯。' },
  { name: '华纳海姆', label: 'VANAHEIMR', mark: 'ᛜ', story: '华纳神族的故乡。丰饶与生长，藏在雨后的苔色里。' },
  { name: '约顿海姆', label: 'JÖTUNHEIMR', mark: 'ᚦ', story: '巨人的旷野。古老山石沉默着，记得世界最初的回声。' },
  { name: '亚尔夫海姆', label: 'ÁLFHEIMR', mark: 'ᛉ', story: '光之精灵的国度。一片叶缘，也能收藏微小而明亮的光。' },
  { name: '斯瓦塔尔夫海姆', label: 'SVARTÁLFAHEIMR', mark: 'ᛞ', story: '深处的匠作之境。炉火与巧手，把故事锻进金属的纹理。' },
  { name: '尼福尔海姆', label: 'NIFLHEIMR', mark: 'ᛁ', story: '雾与寒霜的世界。泉水从寂静中涌出，沿树根缓缓流淌。' },
  { name: '穆斯贝尔海姆', label: 'MÚSPELLSHEIMR', mark: 'ᚲ', story: '火焰的国度。寒夜中的一线暖色，仍记得最初的炽热。' },
  { name: '赫尔海姆', label: 'HELHEIMR', mark: 'ᛇ', story: '长夜深处的归所。世界树记得每一个曾经走过的名字。' }
] -%}
<section class="ash-sanctuary" id="the-end" data-root-sanctuary data-awake="false" data-motion="paused" data-motion-section aria-labelledby="ash-title">
  <header class="ash-heading">
    <p class="ash-eyebrow"><span>THE LAST LIGHT</span><span>IX / WORLDS IN THE MIST</span></p>
    <h2 id="ash-title">长夜，仍有回声<span>。</span></h2>
    <p class="ash-intro">光从远处而来，古老的名字在雾里浮现。</p>
  </header>
  <div class="ash-clearing" data-root-clearing>
    {{ partial('_partial/root-sky-art.njk') }}
    <div class="ash-ground-mist" aria-hidden="true"></div>
    <button class="ash-heart" data-root-awaken type="button" aria-pressed="false" aria-label="唤醒印记" aria-controls="ash-root-reading" aria-describedby="ash-root-hint" disabled></button>
    <p class="ash-clearing-note" id="ash-root-hint" data-root-hint>余光落在雾里，九界的名字静候回声。</p>
  </div>
  <div class="ash-root-reading" id="ash-root-reading" data-root-reading hidden>
    <div class="ash-realm-path" role="group" aria-label="寻访九界铭文">
      {% for realm in root_realms %}<button type="button" data-root-realm="{{ loop.index0 }}" data-realm-name="{{ realm.name }}" data-realm-rune="{{ realm.label }}" data-realm-story="{{ realm.story }}" aria-label="寻访{{ realm.name }}" aria-pressed="false" title="{{ realm.name }}"><span aria-hidden="true">{{ realm.mark }}</span></button>{% endfor %}
    </div>
    <div class="ash-root-story"><span data-root-label></span><h3 data-root-title></h3><p data-root-story></p></div>
  </div>
  <p class="sr-only" data-root-status role="status" aria-live="polite">余光在雾中静候回声。</p>
  <footer class="ash-colophon"><span>THE GARDEN CONTINUES.</span><a href="#hello">回到故事的开头 <span aria-hidden="true">↑</span></a></footer>
</section>
