<div class="norse-horizon" aria-hidden="true">
  <svg class="norse-aurora" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="norse-aurora-mint" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="var(--aurora-ice)" stop-opacity="0"/>
        <stop offset=".26" stop-color="var(--aurora-mint)" stop-opacity=".05"/>
        <stop class="norse-aurora-mint-peak" offset=".53" stop-color="var(--aurora-mint)" stop-opacity=".6"/>
        <stop offset=".74" stop-color="var(--aurora-ice)" stop-opacity=".16"/>
        <stop offset="1" stop-color="var(--aurora-ice)" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="norse-aurora-ice" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="var(--aurora-pearl)" stop-opacity="0"/>
        <stop offset=".34" stop-color="var(--aurora-ice)" stop-opacity=".08"/>
        <stop class="norse-aurora-ice-peak" offset=".57" stop-color="var(--aurora-ice)" stop-opacity=".52"/>
        <stop offset=".79" stop-color="var(--aurora-mint)" stop-opacity=".1"/>
        <stop offset="1" stop-color="var(--aurora-mint)" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="norse-aurora-pearl" x1="0" y1="0" x2="0" y2="1">
        <stop stop-color="var(--aurora-ice)" stop-opacity="0"/>
        <stop offset=".42" stop-color="var(--aurora-pearl)" stop-opacity=".08"/>
        <stop class="norse-aurora-pearl-peak" offset=".61" stop-color="var(--aurora-pearl)" stop-opacity=".42"/>
        <stop offset="1" stop-color="var(--aurora-pearl)" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="norse-aurora-edge">
        <stop stop-color="var(--aurora-mint)" stop-opacity="0"/>
        <stop offset=".28" stop-color="var(--aurora-mint)" stop-opacity=".7"/>
        <stop offset=".63" stop-color="var(--aurora-ice)" stop-opacity=".9"/>
        <stop offset="1" stop-color="var(--aurora-ice)" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="norse-aurora-fade">
        <stop stop-color="white" stop-opacity="0"/><stop offset=".2" stop-color="white"/>
        <stop offset=".8" stop-color="white"/><stop offset="1" stop-color="white" stop-opacity="0"/>
      </linearGradient>
      <mask id="norse-aurora-mist"><rect width="1440" height="700" fill="url(#norse-aurora-fade)"/></mask>
      <filter id="norse-aurora-soft" x="-10%" y="-55%" width="120%" height="210%"><feGaussianBlur stdDeviation="13"/></filter>
      <filter id="norse-aurora-edge-soft" x="-10%" y="-20%" width="120%" height="140%"><feGaussianBlur stdDeviation="1.6"/></filter>
    </defs>
    <g mask="url(#norse-aurora-mist)" filter="url(#norse-aurora-soft)">
      <path data-aurora-layer="0" fill="url(#norse-aurora-mint)" d="M-220 183C180 164 338 312 740 267S1200 145 1660 168L1660 188C1200 205 1142 340 740 335S180 194-220 203Z"/>
      <path data-aurora-layer="1" fill="url(#norse-aurora-ice)" d="M-220 294C180 324 510 298 900 228S1300 255 1660 279L1660 295C1300 293 1290 276 900 274S180 354-220 310Z" opacity=".82"/>
      <path data-aurora-layer="2" fill="url(#norse-aurora-pearl)" d="M-220 168C230 149 520 250 860 272S1320 261 1660 213L1660 225C1320 279 1200 322 860 300S230 169-220 180Z" opacity=".62"/>
    </g>
    <g class="norse-aurora-traces" mask="url(#norse-aurora-mist)" fill="none" stroke="url(#norse-aurora-edge)" stroke-width="1.4" filter="url(#norse-aurora-edge-soft)">
      <path data-aurora-edge="0" d="M-220 196C180 182 338 329 740 302S1200 173 1660 180"/>
      <path data-aurora-edge="1" d="M-220 304C180 341 510 319 900 254S1300 279 1660 289" opacity=".65"/>
    </g>
  </svg>
</div>
