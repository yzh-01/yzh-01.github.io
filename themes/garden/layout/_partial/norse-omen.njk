{# Nine quiet lights around the wordmark's eclipse; the seal remains interactive. #}
<div class="norse-sky" id="norse-sky" aria-hidden="true">
  <div class="norse-sky-drift" data-norse-drift>
    <div class="norse-corona"></div>
    <svg class="norse-orbit" viewBox="0 0 400 400" fill="none">
      <defs>
        <linearGradient id="norse-orbit-light" x1="0" y1="0" x2="1" y2="1">
          <stop stop-color="currentColor" stop-opacity="0"/>
          <stop offset=".4" stop-color="currentColor" stop-opacity=".28"/>
          <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <circle cx="200" cy="200" r="124" stroke="url(#norse-orbit-light)" stroke-width=".65"/>
      <path d="M62 140A151 151 0 0 1 272 67M321 288A150 150 0 0 1 87 300" stroke="currentColor" stroke-width=".5" opacity=".1"/>
      <g class="norse-realms" fill="currentColor">
        <circle cx="200" cy="76" r="1.8" style="--n:0"/><circle cx="280" cy="105" r="1.4" style="--n:1"/>
        <circle cx="322" cy="178" r="1.6" style="--n:2"/><circle cx="307" cy="262" r="1.4" style="--n:3"/>
        <circle cx="242" cy="317" r="1.7" style="--n:4"/><circle cx="158" cy="317" r="1.4" style="--n:5"/>
        <circle cx="93" cy="262" r="1.6" style="--n:6"/><circle cx="78" cy="178" r="1.4" style="--n:7"/>
        <circle cx="120" cy="105" r="1.7" style="--n:8"/>
      </g>
    </svg>
  </div>
</div>
