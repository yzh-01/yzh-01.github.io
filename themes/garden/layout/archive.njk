{% extends '_layout.njk' %}

{% block title %}归档 — {{ config.title }}{% endblock %}

{% block content %}
<div class="archive g-container">
  <h1>归档</h1>
  <p class="sub">{{ site.posts.length }} 篇文章</p>

  {%- set all_posts = site.posts.toArray() -%}
  {%- set current_year = '' -%}
  {%- for p in all_posts -%}
    {%- set y = p.date.format('YYYY') -%}
    {%- if y != current_year -%}
      {%- set current_year = y -%}
      {%- if not loop.first %}</section>{%- endif -%}
      <section class="archive-year">
        <h2>{{ y }}</h2>
    {%- endif -%}
    <a class="archive-post" href="{{ url_for(p.path) }}">
      <time>{{ p.date.format('MM · DD') }}</time>
      <span class="title">{{ p.title }}</span>
    </a>
    {%- if loop.last %}</section>{%- endif -%}
  {%- endfor -%}
</div>
{% endblock %}
