{% extends '_layout.njk' %}

{% set article_text = page.content | striptags %}
{% set article_length = article_text.length %}
{% set reading_minutes = ((article_length + 299) / 300) | int %}
{% set toc_available = theme.post.toc and ('<h2' in page.content or '<h3' in page.content) %}
{% set note_status = page.status or 'growing' %}
{% set note_status_label = '萌芽' %}
{% if note_status == 'growing' %}{% set note_status_label = '生长中' %}{% endif %}
{% if note_status == 'evergreen' %}{% set note_status_label = '常青' %}{% endif %}
{% set related_posts = [] %}
{% set backlink_posts = [] %}
{% for candidate in site.posts.toArray() %}
  {% if candidate.path != page.path %}
    {% set is_related = false %}
    {% for current_tag in page.tags.toArray() %}
      {% for candidate_tag in candidate.tags.toArray() %}
        {% if current_tag.name == candidate_tag.name %}{% set is_related = true %}{% endif %}
      {% endfor %}
    {% endfor %}
    {% if not is_related %}
      {% for current_category in page.categories.toArray() %}
        {% for candidate_category in candidate.categories.toArray() %}
          {% if current_category.name == candidate_category.name %}{% set is_related = true %}{% endif %}
        {% endfor %}
      {% endfor %}
    {% endif %}
    {% if is_related and related_posts.length < 3 %}{% set _ = related_posts.push(candidate) %}{% endif %}
    {% if page.path in candidate.content or url_for(page.path) in candidate.content %}
      {% set _ = backlink_posts.push(candidate) %}
    {% endif %}
  {% endif %}
{% endfor %}
{% if reading_minutes < 1 %}{% set reading_minutes = 1 %}{% endif %}

{% block head_extra %}
{%- set ld_description = page.description or article_text -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ page.title | dump | safe }},
  "datePublished": {{ page.date.toISOString() | dump | safe }},
  "dateModified": {{ (page.updated.toISOString() if page.updated else page.date.toISOString()) | dump | safe }},
  "author": {
    "@type": "Person",
    "name": {{ config.author | dump | safe }},
    "url": {{ config.url | dump | safe }}
  },
  "description": {{ ld_description | dump | safe }},
  "url": {{ (config.url + url_for(page.path)) | dump | safe }},
  "wordCount": {{ article_length }},
  "inLanguage": "zh-CN"
}
</script>
{% endblock %}

{% block content %}
<div class="article-wrap{% if not toc_available %} no-toc{% endif %}" data-toc-enabled="{{ 'true' if toc_available else 'false' }}">
  <article class="article">
    <header class="article-header">
      <p class="inner-content-kicker">&gt; READING_BUFFER / {{ page.date.format('YYYY.MM.DD') }}</p>
      <div class="article-garden-state">
        <span class="note-status note-status-{{ note_status }}"><i aria-hidden="true"></i>{{ note_status_label }}</span>
        <span>最后整理于 <time datetime="{{ (page.updated if page.updated else page.date).format('YYYY-MM-DD') }}">{{ (page.updated if page.updated else page.date).format('YYYY-MM-DD') }}</time></span>
      </div>
      <h1 data-post-transition-title>{{ page.title }}</h1>
      <div class="article-meta">
        <time datetime="{{ page.date.format('YYYY-MM-DD') }}">{{ page.date.format('YYYY-MM-DD') }}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{{ article_length }} 字</span>
        {%- if theme.post.reading_time %}
        <span class="sep" aria-hidden="true">·</span>
        <span>约 {{ reading_minutes }} 分钟</span>
        {%- endif %}
        {%- if page.categories.length -%}
        <span class="sep" aria-hidden="true">·</span>
        {%- for category in page.categories.toArray() -%}
        <a href="{{ url_for(category.path) }}">{{ category.name }}</a>{% if not loop.last %}, {% endif %}
        {%- endfor -%}
        {%- endif -%}
        {%- if page.tags.length -%}
        <span class="sep" aria-hidden="true">·</span>
        {%- for tag in page.tags.toArray().slice(0, 3) -%}
        <a href="{{ url_for(tag.path) }}">#{{ tag.name }}</a>{% if not loop.last %} {% endif %}
        {%- endfor -%}
        {%- if page.tags.length > 3 %}<span class="article-meta-more">+{{ page.tags.length - 3 }}</span>{%- endif %}
        {%- endif -%}
      </div>
      {%- if toc_available %}
      <button
        class="toc-toggle"
        id="toc-toggle"
        type="button"
        aria-controls="article-toc"
        aria-expanded="false"
        aria-label="打开文章目录"
        hidden
      >
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>目录</span>
      </button>
      {%- endif %}
    </header>

    <div class="article-body">
      {{ page.content | safe }}
    </div>

    {%- if related_posts.length or backlink_posts.length %}
    <footer class="article-connections">
      {%- if related_posts.length %}
      <section aria-labelledby="related-notes-title">
        <div class="article-connections-heading">
          <p>continue wandering</p>
          <h2 id="related-notes-title">继续漫游</h2>
        </div>
        <div class="related-notes-grid">
          {%- for related in related_posts %}
          <a href="{{ url_for(related.path) }}">
            <time datetime="{{ related.date.format('YYYY-MM-DD') }}">{{ related.date.format('YYYY-MM-DD') }}</time>
            <h3>{{ related.title }}</h3>
            {%- if related.description %}<p>{{ related.description }}</p>{%- endif %}
            <span>阅读笔记 <b aria-hidden="true">→</b></span>
          </a>
          {%- endfor %}
        </div>
      </section>
      {%- endif %}

      {%- if backlink_posts.length %}
      <section class="backlink-notes" aria-labelledby="backlink-notes-title">
        <div class="article-connections-heading compact">
          <p>backlinks</p>
          <h2 id="backlink-notes-title">哪些笔记提到了这里</h2>
        </div>
        <ul>
          {%- for backlink in backlink_posts %}
          <li><a href="{{ url_for(backlink.path) }}">{{ backlink.title }}</a></li>
          {%- endfor %}
        </ul>
      </section>
      {%- endif %}
    </footer>
    {%- endif %}

    {%- if page.prev or page.next %}
    <nav class="post-nav" aria-label="文章导航">
      {%- if page.prev %}
      <a class="prev" href="{{ url_for(page.prev.path) }}">
        <div class="dir">← prev</div>
        <div class="t">{{ page.prev.title }}</div>
      </a>
      {%- endif %}
      {%- if page.next %}
      <a class="next" href="{{ url_for(page.next.path) }}">
        <div class="dir">next →</div>
        <div class="t">{{ page.next.title }}</div>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}
  </article>

  {%- if toc_available %}
  <div
    class="toc-handle"
    id="toc-handle"
    role="separator"
    aria-label="调整文章目录宽度"
    aria-orientation="vertical"
    aria-valuemin="140"
    aria-valuemax="360"
    aria-valuenow="200"
    tabindex="0"
  ></div>

  <aside class="article-toc" id="article-toc" aria-label="文章目录" tabindex="-1">
    <div class="toc-heading">
      <div class="toc-title">文章目录</div>
      <button class="toc-close" id="toc-close" type="button" aria-label="关闭文章目录">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav id="toc-nav"></nav>
  </aside>

  <div class="toc-overlay" id="toc-overlay" hidden></div>
  {%- endif %}
</div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('js/post.js') }}?v={{ theme.asset_version }}" defer></script>
{% endblock %}
